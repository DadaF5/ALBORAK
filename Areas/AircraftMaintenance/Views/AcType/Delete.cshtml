@using FRAProject.Areas.AircraftMaintenance.Models
@model AcType
@{
    ViewData["Title"] = "Supprimer Type d'Aéronef";
}

<div class="card card-danger">
    <div class="card-header">
        <h3 class="card-title">Confirmer la Suppression</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="icon fas fa-exclamation-triangle"></i>
            Êtes-vous sûr de vouloir supprimer ce type d'aéronef ? Cette action est irréversible.
        </div>

        <dl class="row">
            <dt class="col-sm-4">Nom</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">Groupe Principal</dt>
            <dd class="col-sm-8">@Model.AcMainGroup?.Name</dd>

            <dt class="col-sm-4">Code</dt>
            <dd class="col-sm-8">@Model.Code</dd>

            <dt class="col-sm-4">Statut</dt>
            <dd class="col-sm-8">
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Actif</span>
                }
                else
                {
                    <span class="badge badge-secondary">Inactif</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Confirmer la Suppression
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Annuler
            </a>
        </form>
    </div>
</div>

