@using FRAProject.Areas.AircraftMaintenance.Models
@model IEnumerable<AcType>
@{
    ViewData["Title"] = "AcTypes";
}

<div class="container mt-3">

    <div class="d-flex justify-content-between mb-3">
        <h3>Ac Types</h3>
        <a asp-action="Create" class="btn btn-success">Create New</a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Main Group</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Name</td>
                            <td>@t.Description</td>
                            <td>@t.AcMainGroup?.Name</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-info">Edit</a>
                                <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

