@using FRAProject.Areas.AircraftMaintenance.Models
@model IEnumerable<AcType>
@{
    ViewData["Title"] = "Types d'Aéronefs";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="icon fas fa-check"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="icon fas fa-ban"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Types d'Aéronefs</h3>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Nouveau Type
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="thead-dark">
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Groupe Principal</th>
                    <th>Code</th>
                    <th>Actif</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td>@t.Description</td>
                        <td>@t.AcMainGroup?.Name</td>
                        <td>@t.Code</td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge badge-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactif</span>
                            }
                        </td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-info">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i> Supprimer
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Aucun type d'aéronef enregistré.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

