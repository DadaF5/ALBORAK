@model FRAProject.ViewModels.AircraftViewModel
@{
    ViewData["Title"] = "Edit Aircraft";
}

<h1 class="mb-4 fw-bold display-6 ps-3 border-start border-4 border-primary">
    @ViewData["Title"]
</h1>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">

                <!-- Tail Number -->
                <div class="col-md-4">
                    <label asp-for="TailNo" class="form-label fw-bold"></label>
                    <input asp-for="TailNo" class="form-control" />
                    <span asp-validation-for="TailNo" class="text-danger"></span>
                </div>

                <!-- Registration -->
                <div class="col-md-4">
                    <label asp-for="Registration" class="form-label fw-bold"></label>
                    <input asp-for="Registration" class="form-control" />
                    <span asp-validation-for="Registration" class="text-danger"></span>
                </div>

                <!-- Serial Number -->
                <div class="col-md-4">
                    <label asp-for="SerialNumber" class="form-label fw-bold"></label>
                    <input asp-for="SerialNumber" class="form-control" />
                    <span asp-validation-for="SerialNumber" class="text-danger"></span>
                </div>

                <!-- Manufacturer -->
                <div class="col-md-4">
                    <label asp-for="Manufacturer" class="form-label fw-bold"></label>
                    <input asp-for="Manufacturer" class="form-control" />
                    <span asp-validation-for="Manufacturer" class="text-danger"></span>
                </div>

                <!-- Model -->
                <div class="col-md-4">
                    <label asp-for="Model" class="form-label fw-bold"></label>
                    <input asp-for="Model" class="form-control" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <!-- Manufacture Date -->
                <div class="col-md-4">
                    <label asp-for="ManufactureDate" class="form-label fw-bold"></label>
                    <input asp-for="ManufactureDate" type="date" class="form-control" />
                    <span asp-validation-for="ManufactureDate" class="text-danger"></span>
                </div>

                <!-- Internal Code -->
                <div class="col-md-4">
                    <label asp-for="IntCode" class="form-label fw-bold"></label>
                    <input asp-for="IntCode" class="form-control" />
                    <span asp-validation-for="IntCode" class="text-danger"></span>
                </div>

                <!-- Type (Cascading dropdown start) -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Aircraft Type</label>
                    <select id="AcTypeId" name="AcTypeId" class="form-select">
                        <option value="">-- Select Type --</option>
                        @foreach (var item in Model.AcTypes)
                        {
  @*                           <option value="@item.Value" @(item.Value == Model.AcTypeId.ToString() ? "selected" : "")>
                                @item.Text
                            </option> *@

                            <option value="@item.Value" selected="@(item.Value == Model.AcTypeId.ToString() ? "selected" : null)">
                                @item.Text
                            </option>

                        }
                    </select>
                    <span asp-validation-for="AcTypeId" class="text-danger"></span>
                </div>

                <!-- Status Type -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Status</label>
                    <select id="AcStatusTypeId" name="AcStatusTypeId" class="form-select">
                        @foreach (var item in Model.AcStatusTypes)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.AcStatusTypeId.ToString() ? "selected" : null)">
                                @item.Text
                            </option>
                        }
                    </select>
                    <span asp-validation-for="AcStatusTypeId" class="text-danger"></span>
                </div>

                <!-- Active -->
                <div class="col-md-4 form-check mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-bold"></label>
                </div>

                <!-- Serviceable -->
                <div class="col-md-4 form-check mt-3">
                    <input asp-for="IsServiceable" class="form-check-input" id="isServiceable" />
                    <label asp-for="IsServiceable" class="form-check-label fw-bold"></label>
                </div>

                <!-- Obs -->
                <div class="col-md-12">
                    <label asp-for="Obs" class="form-label fw-bold"></label>
                    <textarea asp-for="Obs" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Obs" class="text-danger"></span>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Save Changes
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

