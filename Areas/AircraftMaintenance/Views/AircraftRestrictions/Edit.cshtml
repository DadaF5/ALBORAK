@model FRAProject.Areas.AircraftMaintenance.ViewModels.AircraftRestrictionFormDto
@{
    ViewData["Title"] = $"Modifier restriction — {Model.Reference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">
            Modifier la restriction
            <code class="text-warning ms-2">@Model.Reference</code>
        </h4>
        <small class="text-muted">
            <a asp-action="Index" class="text-muted text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i>Retour à la liste
            </a>
        </small>
    </div>
    @if (!Model.IsActive)
    {
        <span class="badge bg-success fs-6">Restriction levée</span>
    }
    else
    {
        <span class="badge bg-danger fs-6">Active</span>
    }
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AircraftId" />

    @await Html.PartialAsync("_Form", Model)

    <div class="d-flex justify-content-between align-items-center mt-3">

        @* Left — lift / reactivate *@
        <div>
            @if (Model.IsActive)
            {
                <button type="button"
                        class="btn btn-outline-success btn-sm"
                        onclick="quickToggle(
                            @Model.Id, false,
                            '@Html.Raw(Model.Reference.Replace("'", "\\'"))')">
                    <i class="fas fa-check me-1"></i>
                    Lever cette restriction
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        onclick="quickToggle(
                            @Model.Id, true,
                            '@Html.Raw(Model.Reference.Replace("'", "\\'"))')">
                    <i class="fas fa-ban me-1"></i>
                    Réactiver
                </button>
            }
        </div>

        @* Right — save / cancel *@
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Enregistrer
            </button>
        </div>

    </div>
</form>

@Html.AntiForgeryToken()

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value;

        function quickToggle(id, activate, ref) {
            const action = activate ? 'Activate' : 'Delete';
            const msg    = activate
                ? `Réactiver la restriction « ${ref} » ?`
                : `Lever la restriction « ${ref} » ?\n\nL'aéronef retrouve ses droits de vol.`;

            if (!confirm(msg)) return;

            fetch(`/Settings/AircraftRestrictions/${action}/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Settings/AircraftRestrictions';
                } else {
                    alert(data.message ?? 'Erreur.');
                }
            })
            .catch(() => alert('Erreur réseau.'));
        }
    </script>
}
