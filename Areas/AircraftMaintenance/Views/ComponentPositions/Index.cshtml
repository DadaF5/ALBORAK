@model List<FRAProject.Areas.AircraftMaintenance.Models.ComponentPosition>
@{
    ViewData["Title"] = "Positions composants";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-light">Positions composants (par type d'aéronef)</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Nouvelle position</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="table-responsive">
    <table class="table table-dark table-hover">
        <thead>
            <tr><th>Type d'aéronef</th><th>Code</th><th>Nom</th><th>ATA</th><th>Actif</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model.OrderBy(x => x.AcType?.Name).ThenBy(x => x.SortOrder))
        {
            <tr>
                <td>@p.AcType?.Name</td>
                <td>@p.Code</td>
                <td>@p.Name</td>
                <td>@p.Ata?.Name</td>
                <td>@(p.IsActive ? "Oui" : "Non")</td>
                <td><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">Modifier</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
