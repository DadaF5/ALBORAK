@model List<FRAProject.Areas.AircraftMaintenance.ViewModels.ComponentTypeListDto>
@{
    ViewData["Title"] = "Catalogue composants (P/N)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-light">Catalogue composants (numéros de pièce)</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Nouveau P/N</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="table-responsive">
    <table class="table table-dark table-hover">
        <thead>
            <tr><th>P/N</th><th>Nomenclature</th><th>ATA</th><th>Méthode</th><th>Profils de vie</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.PartNumber</td>
                <td>@t.Nomenclature</td>
                <td>@t.AtaLabel</td>
                <td>@(t.TrackingMethod == FRAProject.Areas.AircraftMaintenance.Models.ComponentTrackingMethod.HardTime ? "Durée de vie limitée" : "À la condition")</td>
                <td>
                    @if (t.TrackingMethod == FRAProject.Areas.AircraftMaintenance.Models.ComponentTrackingMethod.HardTime)
                    {
                        @(t.LifeLimitProfileCount > 0 ? $"{t.LifeLimitProfileCount} profil(s)" : "Aucun — à configurer")
                    }
                    else
                    {
                        <text>—</text>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info">Modifier</a>
                    @if (t.TrackingMethod == FRAProject.Areas.AircraftMaintenance.Models.ComponentTrackingMethod.HardTime)
                    {
                        <a asp-action="ManageLifeLimits" asp-route-id="@t.Id" class="btn btn-sm btn-outline-warning">Profils de vie</a>
                    }
                    <a asp-action="ManageSubAssemblySlots" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Sous-ensembles</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
