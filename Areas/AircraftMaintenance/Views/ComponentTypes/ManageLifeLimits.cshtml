@model List<FRAProject.Areas.AircraftMaintenance.ViewModels.ComponentLifeLimitProfileListDto>
@{
    ViewData["Title"] = "Profils de durée de vie";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int componentTypeId = ViewBag.ComponentTypeId;
    string partNumber = ViewBag.ComponentTypePartNumber;
}

<h3 class="text-light">Profils de durée de vie — @partNumber</h3>
<p class="text-muted">
    Applicabilité résolue par S/N à l'exécution : Spécifique > Plage > Défaut
    (PN_BASED), même priorité que JobCardApplicability.
</p>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<a asp-action="CreateProfile" asp-route-componentTypeId="@componentTypeId" class="btn btn-primary mb-3">
    <i class="fas fa-plus"></i> Nouveau profil
</a>
@* NEW (Derogation implementation pass) — cross-link, same page pair
   discoverability as the ManageSubAssemblySlots/ManageSlotEligibility split. *@
<a asp-action="ManageDerogations" asp-route-id="@componentTypeId" class="btn btn-outline-warning mb-3">
    <i class="fas fa-file-contract"></i> Dérogations
</a>

<div class="table-responsive">
    <table class="table table-dark table-hover">
        <thead>
            <tr><th>Applicabilité</th><th>S/N</th><th>Motif</th><th>Base</th><th>Paliers configurés</th><th>Actif</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                @* FIXED — was printing the raw enum member name (e.g. "PnBased"),
                   now uses the [Display(Name=...)] added to ApplicabilityRuleType
                   so it reads "PN générique" etc., matching the create/edit form. *@
                <td>@Html.DisplayFor(modelItem => p.ApplicabilityRuleType)</td>
                <td>
                    @if (p.ApplicabilityRuleType == FRAProject.Areas.AircraftMaintenance.Models.ApplicabilityRuleType.Specific)
                    {
                        @p.SerialNumber
                    }
                    else if (p.ApplicabilityRuleType == FRAProject.Areas.AircraftMaintenance.Models.ApplicabilityRuleType.RangeFrom)
                    {
                        @($"{p.SerialNumberPrefix} {p.SerialBoundary} et +")
                    }
                    else if (p.ApplicabilityRuleType == FRAProject.Areas.AircraftMaintenance.Models.ApplicabilityRuleType.RangeTo)
                    {
                        @($"{p.SerialNumberPrefix} jusqu'à {p.SerialBoundary}")
                    }
                    else
                    {
                        <text>Tous (défaut)</text>
                    }
                </td>
                <td>@p.Reason</td>
                @* FIXED — same raw-enum problem as above ("SinceNew" instead of
                   "Depuis neuf"); Html.DisplayFor now picks up the enum's new
                   [Display(Name=...)] automatically. *@
                <td>@Html.DisplayFor(modelItem => p.LifeBasis)</td>
                <td>
                    @* FIXED — this used to just show the stage COUNT ("1"), with
                       no way to see the actual configured values (e.g. the 900
                       interval) without clicking into Modifier. Now shows one
                       line per stage built server-side from the real data. *@
                    @if (p.StageSummaries.Any())
                    {
                        foreach (var summary in p.StageSummaries)
                        {
                            <div>@summary</div>
                        }
                    }
                    else
                    {
                        <span class="text-secondary">Aucun palier</span>
                    }
                </td>
                <td>@(p.IsActive ? "Oui" : "Non")</td>
                <td>
                    <a asp-action="EditProfile" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">Modifier</a>
                    <form asp-action="DeleteProfile" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" name="componentTypeId" value="@componentTypeId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ce profil ?')">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<a asp-action="Details" asp-route-id="@componentTypeId" class="btn btn-secondary">Retour au composant</a>
