@model FRAProject.Areas.AircraftMaintenance.ViewModels.ComponentTypePositionsFormDto
@{
    ViewData["Title"] = "Positions éligibles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string partNumber = ViewBag.ComponentTypePartNumber;
    var positionOptions = ViewBag.PositionOptions as List<FRAProject.Areas.AircraftMaintenance.ViewModels.ComponentPositionOptionDto> ?? new();
    var mainGroupChoices = positionOptions
        .Select(p => new { p.AcMainGroupId, p.AcMainGroupLabel })
        .Distinct()
        .OrderBy(g => g.AcMainGroupLabel)
        .ToList();
    var acTypeChoices = positionOptions
        .Select(p => new { p.AcTypeId, p.AcTypeLabel, p.AcMainGroupId })
        .Distinct()
        .OrderBy(g => g.AcTypeLabel)
        .ToList();
}

@* NEW (Details-hub-page pass, follow-up) — Positions éligibles moved off the
   Create/Edit catalog form onto its own dedicated page, same "Manage" page
   pattern (and same filterable-checkbox picker, carried over unchanged)
   already used for Life Limits/Sub-assembly Slots/Derogations. Reached from
   a link/card on the Details hub, not from Edit. *@

<h3 class="text-light">Positions éligibles — @partNumber</h3>
<p class="text-muted">
    Positions sur lesquelles ce P/N peut être installé. Utilisez les filtres
    ci-dessous pour réduire la liste par famille aéronef / type avion.
</p>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form asp-action="ManagePositions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ComponentTypeId" />

    <div class="row mb-2">
        <div class="col-md-6">
            <select id="posFilterMainGroup" class="form-select form-select-sm">
                <option value="">-- Toutes les familles --</option>
                @foreach (var g in mainGroupChoices)
                {
                    <option value="@g.AcMainGroupId">@g.AcMainGroupLabel</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <select id="posFilterAcType" class="form-select form-select-sm">
                <option value="">-- Tous les types --</option>
                @foreach (var t in acTypeChoices)
                {
                    <option value="@t.AcTypeId" data-mg="@t.AcMainGroupId">@t.AcTypeLabel</option>
                }
            </select>
        </div>
    </div>
    <div id="posCheckList" class="border rounded p-2 mb-2" style="max-height: 400px; overflow-y: auto;">
        @if (!positionOptions.Any())
        {
            <p class="text-muted mb-0">Aucune position active n'est configurée pour l'instant — voir ComponentPositions.</p>
        }
        @foreach (var p in positionOptions)
        {
            <div class="form-check" data-mg="@p.AcMainGroupId" data-at="@p.AcTypeId">
                <input class="form-check-input" type="checkbox" name="SelectedPositionIds" value="@p.Id" id="pos_@p.Id"
                       checked="@(Model.SelectedPositionIds.Contains(p.Id) ? "checked" : null)" />
                <label class="form-check-label text-light" for="pos_@p.Id">
                    @p.AcMainGroupLabel — @p.AcTypeLabel — @p.Code — @p.Name
                </label>
            </div>
        }
    </div>
    <div class="form-text text-secondary mb-3">Utilisez les filtres ci-dessus pour réduire la liste — les positions déjà cochées restent sélectionnées même si elles sont temporairement masquées par un filtre.</div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Details" asp-route-id="@Model.ComponentTypeId" class="btn btn-secondary">Retour au composant</a>
</form>

<script>
    (function () {
        var mgSelect = document.getElementById('posFilterMainGroup');
        var atSelect = document.getElementById('posFilterAcType');
        var rows = document.querySelectorAll('#posCheckList .form-check');

        function applyFilter() {
            var mg = mgSelect.value;
            var at = atSelect.value;
            rows.forEach(function (row) {
                var showMg = !mg || row.getAttribute('data-mg') === mg;
                var showAt = !at || row.getAttribute('data-at') === at;
                row.style.display = (showMg && showAt) ? '' : 'none';
            });
        }

        mgSelect.addEventListener('change', function () {
            // Narrowing the family also narrows which AcTypes make sense —
            // reset the AcType filter rather than leaving a stale/impossible
            // combination selected.
            atSelect.value = '';
            Array.from(atSelect.options).forEach(function (opt) {
                if (!opt.value) return;
                opt.hidden = mgSelect.value && opt.getAttribute('data-mg') !== mgSelect.value;
            });
            applyFilter();
        });
        atSelect.addEventListener('change', applyFilter);
    })();
</script>
