@model List<FRAProject.Areas.AircraftMaintenance.Models.ComponentTypeSubAssemblySlot>
@{
    ViewData["Title"] = "Numéros de pièce éligibles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int slotId = ViewBag.SlotId;
    string slotCode = ViewBag.SlotCode;
    string slotName = ViewBag.SlotName;
    byte maxCount = ViewBag.MaxCount;
    int parentComponentTypeId = ViewBag.ParentComponentTypeId;
    string parentPartNumber = ViewBag.ParentComponentTypePartNumber;
    var componentTypeOptions = ViewBag.ComponentTypeOptions as List<FRAProject.Areas.AircraftMaintenance.ViewModels.ComponentTypeListDto>;
}

<h3 class="text-light">Numéros de pièce éligibles — @slotCode (@slotName)</h3>
<p class="text-muted">
    Emplacement sur <strong>@parentPartNumber</strong>, capacité @maxCount.
    Tout numéro de pièce listé ici est interchangeable pour cet emplacement
    (ex: pompes hydrauliques de fabricants différents).
</p>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form asp-action="AddEligiblePart" method="post" class="row g-2 align-items-end mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SlotId" value="@slotId" />
    <div class="col-auto">
        <label class="form-label text-light">Numéro de pièce</label>
        <select name="ChildComponentTypeId" class="form-select">
            <option value="">-- Sélectionner --</option>
            @if (componentTypeOptions != null)
            {
                @foreach (var t in componentTypeOptions)
                {
                    <option value="@t.Id">@t.PartNumber — @t.Nomenclature</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Ajouter</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-dark table-hover">
        <thead>
            <tr><th>P/N</th><th>Nomenclature</th><th>Actif</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.ChildComponentType?.PartNumber</td>
                <td>@e.ChildComponentType?.Nomenclature</td>
                <td>@(e.IsActive ? "Oui" : "Non")</td>
                <td>
                    <form asp-action="RemoveEligiblePart" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@e.Id" />
                        <input type="hidden" name="slotId" value="@slotId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Retirer ce numéro de pièce de l\'emplacement ?')">Retirer</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<a asp-action="ManageSubAssemblySlots" asp-route-id="@parentComponentTypeId" class="btn btn-secondary">Retour aux emplacements</a>
