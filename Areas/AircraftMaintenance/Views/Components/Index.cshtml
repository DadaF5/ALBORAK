@model List<FRAProject.Areas.AircraftMaintenance.ViewModels.ComponentListDto>
@{
    ViewData["Title"] = "Composants";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool includeInactive = (bool)(ViewBag.IncludeInactive ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-light">Composants</h3>
    <div>
        <a asp-action="Receipt" class="btn btn-primary">
            <i class="fas fa-plus"></i> Réception
        </a>
        <a asp-action="DueList" class="btn btn-outline-warning">
            <i class="fas fa-exclamation-triangle"></i> Échéances
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" class="mb-3">
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" name="includeInactive" value="true" @(includeInactive ? "checked" : "") onchange="this.form.submit()">
        <label class="form-check-label text-light">Inclure inactifs</label>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-dark table-hover align-middle">
        <thead>
            <tr>
                <th>P/N</th>
                <th>Nomenclature</th>
                <th>S/N</th>
                <th>Statut</th>
                <th>Emplacement</th>
                <th>Vie restante</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr class="@(c.LifeLimitExceeded || c.MissedOverhaulCount > 0 ? "table-danger" : "")">
                <td>@c.PartNumber</td>
                <td>@c.Nomenclature</td>
                <td>@c.SerialNumber</td>
                <td>
                    @c.Status
                    @if (c.ChildCount > 0)
                    {
                        <span class="badge bg-info text-dark" title="Sous-ensembles attachés">@c.ChildCount sous-ens.</span>
                    }
                </td>
                <td>
                    @c.LocationLabel
                    @if (c.IsSubAssembly)
                    {
                        <small class="text-muted d-block">↳ sous-ensemble de @c.ParentLabel</small>
                    }
                </td>
                <td>
                    @switch (c.LifeStatus)
                    {
                        case FRAProject.Areas.AircraftMaintenance.Models.ComponentLifeStatusValue.Overdue:
                            <span class="badge bg-danger">DÉPASSÉ</span>
                            break;
                        case FRAProject.Areas.AircraftMaintenance.Models.ComponentLifeStatusValue.Alert:
                            <span class="badge bg-warning text-dark">ALERTE</span>
                            break;
                        case FRAProject.Areas.AircraftMaintenance.Models.ComponentLifeStatusValue.Ok:
                            <span class="badge bg-success">OK</span>
                            break;
                        case FRAProject.Areas.AircraftMaintenance.Models.ComponentLifeStatusValue.NotLifeLimited:
                            <span class="badge bg-secondary">N/A</span>
                            break;
                        default:
                            <span class="badge bg-secondary">INCONNU</span>
                            break;
                    }
                    @if (c.LifeLimitExceeded)
                    {
                        <span class="badge bg-danger" title="Limite de vie dépassée — réforme immédiate requise">LIMITE DÉPASSÉE</span>
                    }
                    else if (c.MissedOverhaulCount > 0)
                    {
                        <span class="badge bg-danger" title="Seuil(s) de révision obligatoire franchi(s) sans révision enregistrée">⚠ @c.MissedOverhaulCount révision(s) manquée(s)</span>
                    }
                    @if (c.HasActiveDerogation)
                    {
                        <span class="badge bg-info" title="Une ou plusieurs dérogations actives modifient ce seuil">Dérogation</span>
                    }
                    @if (c.DrivingDimensionRemainingDisplay.HasValue)
                    {
                        <small class="text-muted d-block">@c.DrivingDimensionRemainingDisplay.Value.ToString("N1") @c.DrivingDimensionName restantes</small>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">Détails</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
