@using FRAProject.Areas.AircraftMaintenance.Models
@model InspectionType
@{
    ViewData["Title"] = "Delete Inspection Type";
}

<div class="container mt-3">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h4>Delete Inspection Type</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this inspection type? This action cannot be undone.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9"><code>@Model.Code</code></dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Aircraft Type</dt>
                <dd class="col-sm-9">@Model.AcType?.Name</dd>

                <dt class="col-sm-3">Next Type</dt>
                <dd class="col-sm-9">@(Model.NextInspectionType?.Name ?? "—")</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
