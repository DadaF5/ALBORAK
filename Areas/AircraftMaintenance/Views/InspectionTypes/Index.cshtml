@using FRAProject.Areas.AircraftMaintenance.Models
@model IEnumerable<InspectionType>
@{
    ViewData["Title"] = "Inspection Types";
}

<div class="container mt-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Inspection Types</h3>
        <a asp-action="Create" class="btn btn-success">+ New Inspection Type</a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Aircraft Type</th>
                        <th>Next Type</th>
                        <th>Sort</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in Model)
                    {
                        <tr>
                            <td><code>@it.Code</code></td>
                            <td>@it.Name</td>
                            <td>@it.AcType?.Name</td>
                            <td>@(it.NextInspectionType?.Code ?? "—")</td>
                            <td>@it.SortOrder</td>
                            <td>
                                @if (it.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@it.Id" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@it.Id" class="btn btn-sm btn-info">Edit</a>
                                <a asp-action="Delete" asp-route-id="@it.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
