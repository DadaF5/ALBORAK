@model FRAProject.ViewModels.AircraftMaintenance.JobCardFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nouvelle job card";
}

<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-plus mr-1"></i> Nouvelle job card</h3>
    </div>
    <form asp-action="Create" method="post">
        <div class="card-body">
            @await Html.PartialAsync("_Form", Model)
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
            <a asp-action="Index" class="btn btn-default">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}