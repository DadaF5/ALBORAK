@model FRAProject.ViewModels.AircraftMaintenance.JobCardDetailsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Détails de la job card";
}

<style>
    .jc-details dt {
        color: #8a9099;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .jc-details dd {
        color: #e9ecef;
        font-size: 1rem;
        margin-bottom: 1rem;
    }

    .jc-details .card-doc {
        border-left: 3px solid #0d6efd;
    }

    .jc-details .card-safety {
        border-left: 3px solid #ffc107;
    }
</style>

<div class="jc-details card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-clipboard-list mr-1"></i> @Model.CardCode — @Model.Title</h3>
        <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
            @(Model.IsActive ? "Actif" : "Inactif")
        </span>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Type d'aéronef</dt>
            <dd class="col-sm-9">@Model.AcTypeLabel</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

            <dt class="col-sm-3">Chapitre ATA</dt>
            <dd class="col-sm-9">@(Model.AtaCode ?? "—")</dd>

            <dt class="col-sm-3">Spécialité</dt>
            <dd class="col-sm-9">@(Model.Specialty ?? "—")</dd>

            <dt class="col-sm-3">Zone(s) de travail</dt>
            <dd class="col-sm-9">@(Model.WorkAreas ?? "—")</dd>

            <dt class="col-sm-3">Nombre de mécaniciens</dt>
            <dd class="col-sm-9">@(Model.MechNo?.ToString() ?? "—")</dd>

            <dt class="col-sm-3">Temps alloué</dt>
            <dd class="col-sm-9">
                @{
                    var h = Model.AllocatedTimeMinutes / 60;
                    var m = Model.AllocatedTimeMinutes % 60;
                }
                @($"{h}:{m:D2}") (@Model.AllocatedTimeMinutes min)
            </dd>
        </dl>

        <div class="card card-outline card-warning card-safety mb-3">
            <div class="card-header"><strong>⚠ Conditions de sécurité</strong></div>
            <div class="card-body">
                <strong>Alimentation électrique :</strong> @(Model.ElectricalPowerRequired ?? "Non spécifié")
                @if (!string.IsNullOrEmpty(Model.FigureRef))
                {
                    <span> · <strong>Illustration :</strong> @Model.FigureRef</span>
                }
            </div>
        </div>

        <div class="card card-outline card-secondary card-doc mb-3">
            <div class="card-header"><strong>Référence documentaire</strong></div>
            <div class="card-body">
                @(Model.ToReference ?? "—")
                @(!string.IsNullOrEmpty(Model.DocReference) ? $" · {Model.DocReference}" : "")
                @(!string.IsNullOrEmpty(Model.Edition) ? $" · Édition {Model.Edition}" : "")
                @(Model.ChangeNo.HasValue ? $" · Changement n° {Model.ChangeNo}" : "")
                @(Model.ChangeDate.HasValue ? $" · {Model.ChangeDate.Value:dd/MM/yyyy}" : "")
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-3">Ordre d'affichage</dt>
            <dd class="col-sm-9">@Model.SortOrder</dd>

            <dt class="col-sm-3">Créé le (UTC)</dt>
            <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Modifié le (UTC)</dt>
            <dd class="col-sm-9">@(Model.UpdatedAtUtc?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
        </dl>

        @if (Model.MaintenancePrograms.Any())
        {
            <hr />
            <h5>Programmes d'entretien associés</h5>
            <ul>
                @foreach (var p in Model.MaintenancePrograms)
                {
                    <li>@p.Name</li>
                }
            </ul>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-edit"></i> Modifier</a>
        <a asp-action="Index" class="btn btn-default">Retour à la liste</a>
    </div>
</div>