@model List<FRAProject.ViewModels.AircraftMaintenance.JobCardListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Job Cards";
}

<style>
    .jc-index .group-row td {
        background-color: #23262d;
        color: #c9ccd1;
        border-top: 2px solid #363b44;
    }

    .jc-index table td, .jc-index table th {
        border-color: #363b44;
    }

    .jc-index code {
        color: #ff8fa3;
        background: transparent;
    }

    .jc-index .specialty-badge {
        font-size: 0.75rem;
    }

    .jc-index .doc-ref {
        color: #8a9099;
        font-size: 0.85rem;
    }
</style>

<div class="jc-index card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-clipboard-list mr-1"></i> Job Cards</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Nouvelle job card
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }

        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Titre</th>
                    <th>Type d'aéronef</th>
                    <th>ATA</th>
                    <th>Spécialité</th>
                    <th>Temps alloué</th>
                    <th>Référence document</th>
                    <th>Édition</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.GroupBy(x => x.AcTypeLabel).OrderBy(g => g.Key))
                {
                    <tr class="group-row">
                        <td colspan="10"><strong>@group.Key</strong></td>
                    </tr>
                    @foreach (var item in group.OrderBy(x => x.SortOrder).ThenBy(x => x.CardCode))
                    {
                        <tr>
                            <td><code>@item.CardCode</code></td>
                            <td>@item.Title</td>
                            <td>@item.AcTypeLabel</td>
                            <td>@item.AtaCode</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Specialty))
                                {
                                    <span class="badge badge-info specialty-badge">@item.Specialty</span>
                                }
                            </td>
                            <td>
                                @{
                                    var h = item.AllocatedTimeMinutes / 60;
                                    var m = item.AllocatedTimeMinutes % 60;
                                }
                                @($"{h}:{m:D2}")
                            </td>
                            <td class="doc-ref">@(item.DocReference ?? "—")</td>
                            <td class="doc-ref">@(item.Edition ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary" title="Détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">Aucune job card définie.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>