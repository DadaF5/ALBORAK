@model FRAProject.ViewModels.AircraftMaintenance.MaintenanceProgramFormViewModel

<style>
    .mp-form .form-control {
        background-color: #2b2f36;
        border: 1px solid #454b54;
        color: #e9ecef;
    }

        .mp-form .form-control:focus {
            background-color: #2b2f36;
            border-color: #0d6efd;
            color: #fff;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,.25);
        }

        .mp-form .form-control::placeholder {
            color: #8a9099;
        }

        .mp-form .form-control.input-validation-error {
            border-color: #ff6b6b !important;
            background-color: rgba(255, 107, 107, 0.1);
        }

    .mp-form label {
        color: #c9ccd1;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .mp-form .required-mark {
        color: #ff6b6b;
        margin-left: 2px;
    }

    .mp-form .card-doc {
        border-left: 3px solid #0d6efd;
    }

    .mp-form .advanced-toggle {
        cursor: pointer;
        color: #8ab4ff;
        font-size: 0.85rem;
        user-select: none;
        transition: opacity 0.2s ease;
        padding: 8px 4px;
        margin: 0;
    }

        .mp-form .advanced-toggle:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        .mp-form .advanced-toggle:active {
            opacity: 0.6;
        }

    .mp-form .text-danger {
        font-size: 0.75rem;
        margin-top: 4px;
        display: block;
        color: #ff6b6b;
    }

    .mp-form .advanced-toggle {
        cursor: pointer;
        color: #8ab4ff;
        font-size: 0.95rem;
        user-select: none;
        transition: all 0.2s ease;
        padding: 12px 0;
        margin: 16px 0 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .mp-form .advanced-toggle:hover {
            opacity: 0.8;
        }

        .mp-form .advanced-toggle:active {
            opacity: 0.6;
        }
</style>

<div class="mp-form">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6 form-group">
            <label asp-for="AcTypeId">Type d'aéronef<span class="required-mark">*</span></label>
            <select asp-for="AcTypeId" class="form-control" asp-items="Model.AcTypes.Select(a => new SelectListItem(a.DisplayLabel, a.Id.ToString()))">
                <option value="">-- Sélectionner --</option>
            </select>
            <span asp-validation-for="AcTypeId" class="text-danger"></span>
        </div>

        <div class="col-md-6 form-group">
            <label asp-for="Code">Code<span class="required-mark">*</span></label>
            <input asp-for="Code" class="form-control text-uppercase" id="codeInput" placeholder="ex : PE-1200" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Name">Nom<span class="required-mark">*</span></label>
        <input asp-for="Name" class="form-control" placeholder="ex : Programme d'entretien 1200H" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="card card-outline card-secondary card-doc mb-3">
        <div class="card-header"><strong>Référence documentaire</strong></div>
        <div class="card-body row">
            <div class="col-md-4 form-group">
                <label asp-for="DocReference">Référence document</label>
                <input asp-for="DocReference" class="form-control" placeholder="ex : AMM-34-21" />
                <span asp-validation-for="DocReference" class="text-danger"></span>
            </div>
            <div class="col-md-3 form-group">
                <label asp-for="Edition">Édition</label>
                <input asp-for="Edition" class="form-control" placeholder="ex : Rev. 12" maxlength="20" />
                <span asp-validation-for="Edition" class="text-danger"></span>
            </div>
            <div class="col-md-2 form-group">
                <label asp-for="ChangeNo">N° changement</label>
                <input asp-for="ChangeNo" class="form-control" type="number" placeholder="ex : 1" min="0" />
                <span asp-validation-for="ChangeNo" class="text-danger"></span>
            </div>
            <div class="col-md-3 form-group">
                <label asp-for="ChangeDate">Date changement</label>
                <input asp-for="ChangeDate" class="form-control" type="date" />
                <span asp-validation-for="ChangeDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card card-outline card-secondary card-doc mb-3">
    <div class="card-header"><strong>Options avancées (ordre d'affichage, statut)</strong></div>
        <div class="card-body row">
        <div class="col-md-4 form-group">
            <label asp-for="SortOrder">Ordre d'affichage</label>
            <input asp-for="SortOrder" class="form-control" type="number" placeholder="ex : 1" min="0" />
            <span asp-validation-for="SortOrder" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-group d-flex align-items-end">
            <div class="custom-control custom-switch">
                <input asp-for="IsActive" class="custom-control-input" type="checkbox" id="IsActive" />
                <label class="custom-control-label" for="IsActive">Actif</label>
            </div>
        </div>
    </div>
   </div>
</div>


