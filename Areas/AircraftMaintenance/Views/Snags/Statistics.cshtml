@using FRAProject.Areas.AircraftMaintenance.Services
@* Views/Snags/Statistics.cshtml *@
@model List<AtaMtbfDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Statistiques Snags — MTBF";
    var topOffenders = ViewBag.TopOffenders as List<AtaMtbfDto>;
}

<div class="content-header"><h1>📊 Statistiques Snags — MTBF</h1></div>

<form method="get" class="form-inline mb-3">
    <label class="mr-2">Du</label>
    <input type="date" name="from" value="@ViewBag.From" class="form-control mr-3" />
    <label class="mr-2">Au</label>
    <input type="date" name="to" value="@ViewBag.To" class="form-control mr-3" />
    <button type="submit" class="btn btn-primary">Filtrer</button>
</form>

<div class="card card-outline card-warning mb-4">
    <div class="card-header"><h3 class="card-title">Top Chapitres ATA (Occurrences)</h3></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>ATA</th><th>Type</th><th>Nb Snags</th><th>MTBF (h)</th></tr></thead>
            <tbody>
                @foreach (var t in topOffenders ?? new())
                {
                    <tr>
                        <td>@t.AtaLabel</td>
                        <td>@t.AcTypeLabel</td>
                        <td>@t.SnagCount</td>
                        <td>@(t.MtbfHours.HasValue? t.MtbfHours.Value.ToString("N0") : "N/A")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3 class="card-title">MTBF par Chapitre ATA / Type Avion</h3></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>ATA</th><th>Type Avion</th><th>Nb Snags</th><th>HdV Cumulées</th><th>MTBF (h)</th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.AtaLabel</td>
                        <td>@m.AcTypeLabel</td>
                        <td>@m.SnagCount</td>
                        <td>@(m.AccumulatedFH / 60)</td>
                        <td>@(m.MtbfHours.HasValue? m.MtbfHours.Value.ToString("N0") : "N/A")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>