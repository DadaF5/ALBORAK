@model FRAProject.ViewModels.AircraftMaintenance.WorkOrderSectionPartFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Ajouter un équipement";
}

<div class="card card-outline card-primary">
    <div class="card-header"><h3 class="card-title">Ajouter un équipement changé</h3></div>
    <form asp-action="Create" method="post">
        <div class="card-body">@await Html.PartialAsync("_Form", Model)</div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
            <a asp-action="Index" asp-route-id="@Model.WorkOrderSectionId" class="btn btn-default">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}