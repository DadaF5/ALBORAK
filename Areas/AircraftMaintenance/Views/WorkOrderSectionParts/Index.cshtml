@model List<FRAProject.ViewModels.AircraftMaintenance.WorkOrderSectionPartListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Équipements changés";
}

<style>
    .wosp-index table td, .wosp-index table th {
        border-color: #363b44;
        font-size: 0.9rem;
    }

    .wosp-index code {
        color: #ff8fa3;
        background: transparent;
    }

    .wosp-index .old-part {
        color: #ff8f8f;
    }

    .wosp-index .new-part {
        color: #8fff9f;
    }
</style>

<div class="wosp-index card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">
            <i class="fas fa-exchange-alt mr-1"></i> Équipements changés — @ViewBag.SectionLabel
            @if (ViewBag.FormNumber != null)
            {
                <small class="text-muted">(@ViewBag.FormNumber)</small>
            }
        </h3>
        <a asp-action="Create" asp-route-id="@ViewBag.WorkOrderSectionId" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Ajouter un équipement
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }

        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Désignation / Position</th>
                    <th>Ancien (déposé)</th>
                    <th>Nouveau (installé)</th>
                    <th>Motif dépose</th>
                    <th>Date</th>
                    <th>Exécutant</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.DesignationEtPosition ?? "—")</td>
                        <td class="old-part">
                            @if (item.OldNomenclature != null || item.OldNumero != null)
                            {
                                <code>@item.OldNomenclature</code> 
                                @item.OldNumero
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="new-part">
                            @if (item.NewNomenclature != null || item.NewNumero != null)
                            {
                                <code>@item.NewNomenclature</code> 
                                @item.NewNumero
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@(item.MotifDepose ?? "—")</td>
                        <td>@(item.Date?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            @(item.ExecutantNom ?? "—")
                            @if (item.IsSigned)
                            {
                                <i class="fas fa-check-circle text-success" title="Attesté"></i>
                            }
                        </td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Supprimer cette ligne ?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Aucun équipement enregistré.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a asp-controller="WorkOrderSections" asp-action="Details" asp-route-id="@ViewBag.WorkOrderSectionId" class="btn btn-default mt-3">
    <i class="fas fa-arrow-left"></i> Retour à la section
</a>