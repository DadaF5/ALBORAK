@model FRAProject.ViewModels.AircraftMaintenance.WorkOrderSectionDetailsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Supprimer la section";
}

<div class="card card-outline card-danger">
    <div class="card-header"><h3 class="card-title">Supprimer — @Model.SectionCode</h3></div>
    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <p>
            Vous êtes sur le point de supprimer la section <strong>@Model.SectionCode — @Model.SectionName</strong>
            (@(Model.FormNumber ?? "—")) de l'OT @Model.WONumber.
        </p>
    </div>
    <div class="card-footer">
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Irréversible. Continuer ?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Supprimer</button>
        </form>
        <a asp-action="Index" asp-route-id="@Model.WorkOrderId" class="btn btn-default">Annuler</a>
    </div>
</div>