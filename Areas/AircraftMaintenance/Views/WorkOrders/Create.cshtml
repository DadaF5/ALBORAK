@model FRAProject.ViewModels.AircraftMaintenance.WorkOrderFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nouvel Ordre de Travail";
}

<style>
    .wo-form .form-control {
        background-color: #2b2f36;
        border: 1px solid #454b54;
        color: #e9ecef;
    }

    .wo-form label {
        color: #c9ccd1;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .wo-form .required-mark {
        color: #ff6b6b;
        margin-left: 2px;
    }

    .wo-inspection-list {
        max-height: 220px;
        overflow-y: auto;
        border: 1px solid #454b54;
        border-radius: 4px;
        padding: 10px;
        background-color: #2b2f36;
    }

        .wo-inspection-list .form-check {
            padding-left: 1.6rem;
            margin-bottom: 4px;
        }

        .wo-inspection-list .form-check-label {
            color: #e9ecef;
            font-weight: 400;
            font-size: 0.9rem;
        }

    .wo-inspection-hint {
        color: #ffc107;
        font-size: 0.8rem;
    }

    .wo-status-overdue {
        color: #ff6b6b;
    }

    .wo-status-alert {
        color: #ffc107;
    }

    .wo-status-unknown {
        color: #8a9099;
    }
</style>

<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-plus mr-1"></i> Nouvel Ordre de Travail</h3>
    </div>
    <form asp-action="Create" method="post">
        <div class="wo-form card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="AircraftId">Aéronef<span class="required-mark">*</span></label>
                    <select asp-for="AircraftId" class="form-control" id="aircraftSelect">
                        <option value="">-- Sélectionner --</option>
                        @foreach (var group in Model.Aircrafts.GroupBy(a => a.AcTypeCode))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var a in group)
                                {
                                    <option value="@a.Id">@a.Registration</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="AircraftId" class="text-danger"></span>
                </div>
                <div class="col-md-3 form-group">
                    <label asp-for="WOType">Type</label>
                    <select asp-for="WOType" class="form-control">
                        @foreach (var opt in Model.WOTypeOptions)
                        {
                            <option value="@opt">@opt</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 form-group">
                    <label asp-for="WOKind">Nature</label>
                    <select asp-for="WOKind" class="form-control" id="wokindSelect">
                        @foreach (var opt in Model.WOKindOptions)
                        {
                            <option value="@opt">@opt</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group" id="inspectionTypesGroup">
                <label>Types d'inspection couverts (pour OT planifié)</label>
                <p class="wo-inspection-hint" id="pickAircraftHint">
                    Sélectionnez d'abord un aéronef pour voir ses types d'inspection dus.
                </p>
                <p class="wo-inspection-hint text-muted" id="loadingHint" style="display:none;">
                    Chargement...
                </p>
                <p class="wo-inspection-hint text-muted" id="noneDueHint" style="display:none;">
                    Aucun type d'inspection dû actuellement pour cet aéronef
                    (déjà à jour, ou déjà planifié dans un autre OT actif).
                </p>
                <div class="wo-inspection-list" id="inspectionTypesList"></div>
                <span asp-validation-for="SelectedInspectionTypeIds" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Remarks">Remarques</label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Créer (brouillon)</button>
            <a asp-action="Index" class="btn btn-default">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function toggleInspectionTypes() {
            var kind = document.getElementById('wokindSelect').value;
            document.getElementById('inspectionTypesGroup').style.display = kind === 'PLANNED' ? '' : 'none';
        }
        document.getElementById('wokindSelect')?.addEventListener('change', toggleInspectionTypes);
        toggleInspectionTypes();

        // Fetches the due/selectable InspectionTypes for the chosen
        // aircraft from the server (GetSelectableInspectionTypes), which
        // already excludes: types not matching the aircraft's AcType,
        // types already scheduled on another active WorkOrder for this
        // aircraft, and types that aren't due yet (status "OK"). This
        // replaces the old purely-client-side AcType-only filtering.
        async function loadInspectionTypesForAircraft() {
            var aircraftSelect = document.getElementById('aircraftSelect');
            var aircraftId = aircraftSelect.value;
            var list = document.getElementById('inspectionTypesList');
            var pickHint = document.getElementById('pickAircraftHint');
            var loadingHint = document.getElementById('loadingHint');
            var noneDueHint = document.getElementById('noneDueHint');

            list.innerHTML = '';
            noneDueHint.style.display = 'none';

            if (!aircraftId) {
                pickHint.style.display = 'block';
                return;
            }
            pickHint.style.display = 'none';
            loadingHint.style.display = 'block';

            try {
                var response = await fetch('@Url.Action("GetSelectableInspectionTypes", "WorkOrders")?aircraftId=' + aircraftId);
                var items = await response.json();
                loadingHint.style.display = 'none';

                if (!items.length) {
                    noneDueHint.style.display = 'block';
                    return;
                }

                items.forEach(function (it) {
                    var statusClass = it.status === 'OVERDUE' ? 'wo-status-overdue'
                        : it.status === 'ALERT' ? 'wo-status-alert'
                        : it.status === 'UNKNOWN' ? 'wo-status-unknown' : '';

                    var wrapper = document.createElement('div');
                    wrapper.className = 'form-check';
                    wrapper.innerHTML =
                        '<input class="form-check-input" type="checkbox" name="SelectedInspectionTypeIds" ' +
                        'value="' + it.id + '" id="itype-' + it.id + '" checked />' +
                        '<label class="form-check-label ' + statusClass + '" for="itype-' + it.id + '">' + it.label + '</label>';
                    list.appendChild(wrapper);
                });
            } catch (e) {
                loadingHint.style.display = 'none';
                list.innerHTML = '<p class="text-danger small">Erreur de chargement des types d\'inspection.</p>';
            }
        }

        document.getElementById('aircraftSelect')?.addEventListener('change', loadInspectionTypesForAircraft);
        loadInspectionTypesForAircraft();
    </script>
}