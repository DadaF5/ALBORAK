@model FRAProject.ViewModels.AircraftMaintenance.WorkOrderDetailsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Supprimer l'Ordre de Travail";
}

<div class="card card-outline card-danger">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-exclamation-triangle mr-1"></i> Supprimer — @Model.WONumber</h3>
    </div>
    <div class="card-body">
        <p>
            Vous êtes sur le point de supprimer définitivement cet ordre de travail en brouillon
            pour <strong>@Model.AircraftLabel</strong>.
        </p>
        <p class="text-muted">
            Seuls les OT en statut DRAFT peuvent être supprimés — une fois ouvert,
            un OT devient un enregistrement d'audit et ne peut plus être supprimé.
        </p>
    </div>
    <div class="card-footer">
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Irréversible. Continuer ?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Supprimer définitivement</button>
        </form>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">Annuler</a>
    </div>
</div>