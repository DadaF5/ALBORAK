@model List<FRAProject.ViewModels.AircraftMaintenance.WorkOrderListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Ordres de Travail";
}

<style>
    .wo-index table td, .wo-index table th {
        border-color: #363b44;
    }

    .wo-index code {
        color: #ff8fa3;
        background: transparent;
    }
</style>

<div class="wo-index card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-tools mr-1"></i> Ordres de Travail</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Nouvel OT</a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }

        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>N° OT</th>
                    <th>Aéronef</th>
                    <th>Types d'inspection</th>
                    <th>Type</th>
                    <th>Nature</th>
                    <th>Statut</th>
                    <th>Date ouverture</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(x => x.OpenDate))
                {
                    <tr>
                        <td><code>@item.WONumber</code></td>
                        <td>@item.AircraftLabel</td>
                        <td>
                            @foreach (var lbl in item.InspectionTypeLabels)
                            {
                                <span class="badge badge-info mr-1">@lbl</span>
                            }
                        </td>
                        <td>@item.WOType</td>
                        <td>@item.WOKind</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    "DRAFT" => "badge-secondary",
                                    "OPEN" => "badge-info",
                                    "IN_PROGRESS" => "badge-warning",
                                    "CLOSED" => "badge-success",
                                    _ => "badge-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td>@item.OpenDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary" title="Détails">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Aucun ordre de travail.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>