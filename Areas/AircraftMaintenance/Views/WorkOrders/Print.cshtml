@model FRAProject.ViewModels.AircraftMaintenance.WorkOrderDetailsViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>OT @Model.WONumber</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #000;
            background: #fff;
            margin: 0;
            padding: 20px;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                padding: 0;
            }

            .page {
                page-break-after: always;
            }
        }

        .toolbar {
            text-align: right;
            margin-bottom: 12px;
        }

            .toolbar button {
                padding: 8px 16px;
                font-size: 13px;
                cursor: pointer;
                background: #0d6efd;
                color: #fff;
                border: none;
                border-radius: 4px;
            }

        .letterhead {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 3px solid #000;
            padding-bottom: 8px;
            margin-bottom: 10px;
        }

            .letterhead .unit {
                font-size: 13px;
                font-weight: bold;
                text-transform: uppercase;
            }

                .letterhead .unit small {
                    display: block;
                    font-weight: normal;
                    font-size: 10px;
                    text-transform: none;
                }

            .letterhead .doc-title {
                text-align: right;
            }

                .letterhead .doc-title h1 {
                    font-size: 18px;
                    margin: 0 0 2px 0;
                }

                .letterhead .doc-title .subtitle {
                    font-size: 10px;
                    color: #444;
                }

                .letterhead .doc-title .form-badge {
                    display: inline-block;
                    margin-top: 4px;
                    border: 2px solid #000;
                    padding: 2px 10px;
                    font-weight: bold;
                    font-size: 13px;
                }

        .ref-table, .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }

            .ref-table td, .info-table td, .info-table th {
                border: 1px solid #000;
                padding: 4px 6px;
                vertical-align: top;
            }

            .ref-table .lbl, .info-table .lbl {
                font-weight: bold;
                background: #eee;
                width: 16%;
                font-size: 9px;
                text-transform: uppercase;
            }

        .section-title {
            font-weight: bold;
            font-size: 11px;
            text-transform: uppercase;
            background: #333;
            color: #fff;
            padding: 3px 6px;
            margin: 12px 0 0 0;
        }

        .subsection-title {
            font-weight: bold;
            font-size: 10px;
            text-transform: uppercase;
            background: #666;
            color: #fff;
            padding: 3px 6px;
            margin: 8px 0 0 0;
        }

        .badges span {
            display: inline-block;
            border: 1px solid #000;
            padding: 2px 8px;
            margin: 2px 4px 2px 0;
            font-size: 10px;
            font-weight: bold;
        }

        .jc-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 4px;
        }

            .jc-table th, .jc-table td {
                border: 1px solid #000;
                padding: 3px 5px;
                font-size: 9.5px;
                text-align: left;
            }

            .jc-table th {
                background: #eee;
                text-transform: uppercase;
                font-size: 8.5px;
            }

            .jc-table .center {
                text-align: center;
            }

        .remarks-box {
            border: 1px solid #000;
            min-height: 60px;
            padding: 6px;
            font-size: 10px;
            margin-top: 4px;
            white-space: pre-wrap;
        }

        .directives-box {
            border: 1px solid #000;
            padding: 6px;
            font-size: 10px;
            margin-top: 4px;
            white-space: pre-wrap;
            background: #fafafa;
        }

        .signoff-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 4px;
        }

            .signoff-table th, .signoff-table td {
                border: 1px solid #000;
                padding: 6px;
                font-size: 9.5px;
            }

            .signoff-table th {
                background: #eee;
                text-transform: uppercase;
                font-size: 8.5px;
            }

            .signoff-table .sig-line {
                height: 32px;
            }

            .signoff-table .signed {
                color: #006400;
                font-weight: bold;
            }

        .cert-box {
            border: 1px solid #000;
            padding: 8px;
            margin-top: 10px;
            font-size: 9.5px;
            font-style: italic;
        }

        .footer {
            margin-top: 16px;
            display: flex;
            justify-content: space-between;
            font-size: 8.5px;
            color: #555;
            border-top: 1px solid #999;
            padding-top: 4px;
        }

        .section-block {
            border: 2px solid #000;
            padding: 10px;
            margin-top: 16px;
            page-break-inside: avoid;
        }

        .section-block-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
            padding-bottom: 6px;
            margin-bottom: 8px;
        }

            .section-block-header h2 {
                font-size: 14px;
                margin: 0;
            }

            .section-block-header .form13-badge {
                border: 1px solid #000;
                padding: 2px 8px;
                font-weight: bold;
                font-size: 11px;
            }
    </style>
</head>
<body>

    <div class="toolbar no-print">
        <button onclick="window.print()">🖨 Imprimer / Print</button>
    </div>

    <div class="page">

        <div class="letterhead">
            <div class="unit">
                Forces Royales Air
                <small>2ème Base Aérienne de Réaction Rapide — Service Maintenance</small>
            </div>
            <div class="doc-title">
                <h1>ORDRE DE TRAVAIL</h1>
                <div class="subtitle">WORK ORDER — @Model.WONumber</div>
                <span class="form-badge">@Model.WOType</span>
            </div>
        </div>

        <table class="ref-table">
            <tr>
                <td class="lbl">N° OT / WO No.</td>
                <td><strong>@Model.WONumber</strong></td>
                <td class="lbl">Nature / Kind</td>
                <td>@Model.WOKind</td>
                <td class="lbl">Statut / Status</td>
                <td><strong>@Model.Status</strong></td>
            </tr>
        </table>

        <div class="section-title">Identification Aéronef / Aircraft Identification</div>
        <table class="info-table">
            <tr>
                <td class="lbl">Immatriculation / Registration</td>
                <td><strong>@Model.AircraftLabel</strong></td>
                <td class="lbl">N° de Série / Serial No.</td>
                <td>@(Model.AircraftSerialNumber ?? "—")</td>
            </tr>
            <tr>
                <td class="lbl">Code Interne / Internal Code</td>
                <td>@(Model.AircraftIntCode ?? "—")</td>
                <td class="lbl">N° Militaire / Mil. Tail No.</td>
                <td>@Model.AircraftTailNo</td>
            </tr>
            <tr>
                <td class="lbl">Type d'Aéronef / Aircraft Type</td>
                <td colspan="3">@Model.AcTypeLabel</td>
            </tr>
            <tr>
                <td class="lbl">Constructeur / Manufacturer</td>
                <td colspan="3">@(Model.ManufacturerLabel ?? "—")</td>
            </tr>
        </table>

        <div class="section-title">Position à l'Ouverture / Position at Opening</div>
        <table class="info-table">
            <tr>
                <td class="lbl">Date d'ouverture</td>
                <td>@Model.OpenDate.ToString("dd/MM/yyyy")</td>
                <td class="lbl">Heures / Hours</td>
                <td>@Model.OpenHours h</td>
                <td class="lbl">Cycles</td>
                <td>@Model.OpenCycles</td>
                <td class="lbl">Atterrissages / Landings</td>
                <td>@Model.OpenLandings</td>
            </tr>
            @if (Model.OpenedByUserName != null)
            {
                <tr>
                    <td class="lbl">Ouvert par / Opened by</td>
                    <td colspan="7">@Model.OpenedByUserName</td>
                </tr>
            }
        </table>

        <div class="section-title">Moteur(s) / Engine(s) — Relevé Manuel / Manual Log</div>
        <table class="info-table">
            <tr>
                <th style="border:1px solid #000; background:#eee; font-size:9px;">Position</th>
                <th style="border:1px solid #000; background:#eee; font-size:9px;">N° Série / S/N</th>
                <th style="border:1px solid #000; background:#eee; font-size:9px;">Heures / Hours</th>
                <th style="border:1px solid #000; background:#eee; font-size:9px;">Cycles</th>
            </tr>
            @{
                var engineCount = Model.MaxEngines > 0 ? Model.MaxEngines : 1;
            }
            @for (int i = 1; i <= engineCount; i++)
            {
                <tr><td>Moteur @i</td><td></td><td></td><td></td></tr>
            }
        </table>
        <p style="font-size:8.5px; color:#555; margin:2px 0 0 0;">
            Suivi individuel par moteur non encore digitalisé — renseigner manuellement.
        </p>

        @if (Model.WOKind == "CORRECTIVE")
        {
            <div class="section-title">Référence Défaut / Snag Reference</div>
            <table class="info-table">
                <tr><td class="lbl">N° Snag / Ref.</td><td style="height:20px;"></td></tr>
            </table>
        }

        @if (Model.InspectionTypeLabels.Any())
        {
            <div class="section-title">Type de Travail Demandé / Work Requested</div>
            <div class="badges">
                @foreach (var lbl in Model.InspectionTypeLabels)
                {
                    <span>@lbl</span>
                }
            </div>
        }

        @if (Model.JobCards.Any())
        {
            <div class="section-title">Job Cards / Tâches (Programme d'Entretien)</div>
            <table class="jc-table">
                <thead>
                    <tr>
                        <th style="width:20%;">Job Card</th>
                        <th style="width:14%;">Programme</th>
                        <th class="center" style="width:8%;">Oblig.</th>
                        <th class="center" style="width:10%;">Statut</th>
                        <th>Observations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jc in Model.JobCards)
                    {
                        <tr>
                            <td>@jc.JobCardLabel</td>
                            <td>@jc.MaintenanceProgramLabel</td>
                            <td class="center">@(jc.IsMandatory ? "OUI" : "NON")</td>
                            <td class="center">@jc.Status</td>
                            <td>@(jc.Observations ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="section-title">Remarques / Remarks</div>
        <div class="remarks-box">@(Model.Remarks ?? "")</div>

        @if (Model.Status == "CLOSED")
        {
            <div class="section-title">Clôture / Closure</div>
            <table class="info-table">
                <tr>
                    <td class="lbl">Date de clôture</td>
                    <td>@Model.CloseDate?.ToString("dd/MM/yyyy")</td>
                    <td class="lbl">Heures / Hours</td>
                    <td>@Model.CloseHours h</td>
                    <td class="lbl">Cycles</td>
                    <td>@Model.CloseCycles</td>
                    <td class="lbl">Atterrissages</td>
                    <td>@Model.CloseLandings</td>
                </tr>
                @if (Model.ClosedByUserName != null)
                {
                    <tr>
                        <td class="lbl">Clôturé par / Closed by</td>
                        <td colspan="7">@Model.ClosedByUserName</td>
                    </tr>
                }
            </table>

            <div class="cert-box">
                Je certifie que les travaux décrits dans le présent ordre de travail ont été exécutés
                conformément aux procédures et documents techniques applicables, et que l'aéronef est
                apte à reprendre le service dans les conditions mentionnées ci-dessus. / I certify that
                the work described in this work order has been performed in accordance with applicable
                procedures and technical documentation, and that the aircraft is fit for return to
                service under the conditions stated above.
            </div>
        }

        <div class="footer">
            <span>Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
            <span>ALBORAK GMAO FRA — Document généré électroniquement, à valider par signature manuscrite</span>
        </div>

    </div>

    @* ── One Formule 13 block per WorkOrderSection ─────────────────── *@
    @foreach (var sec in Model.Sections)
    {
        <div class="page section-block">
            <div class="section-block-header">
                <h2>FORMULE DE CONTRÔLE DES OPÉRATIONS D'ENTRETIEN ET DE REMISE EN ÉTAT — Formule 13</h2>
                <span class="form13-badge">@(sec.FormNumber ?? $"{sec.SectionCode}")</span>
            </div>

            <table class="ref-table">
                <tr>
                    <td class="lbl">Section responsable</td>
                    <td><strong>@sec.SectionCode — @sec.SectionName</strong></td>
                    <td class="lbl">Organisme responsable</td>
                    <td>@(sec.OrganismeResponsable ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">Type de travail</td>
                    <td>@(sec.TypeTravail ?? "—")</td>
                    <td class="lbl">Vieillissement</td>
                    <td>@(sec.VieillissementHours.HasValue ? $"{sec.VieillissementHours} h" : "—")</td>
                </tr>
                <tr>
                    <td class="lbl">Date début</td>
                    <td>@(sec.DateDebut?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="lbl">Date fin</td>
                    <td>@(sec.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                </tr>
                <tr>
                    <td class="lbl">Temps alloué</td>
                    <td>@(sec.TempsAlloueMinutes?.ToString() ?? "—") min</td>
                    <td class="lbl">Temps passé (Systém. / Retouche)</td>
                    <td>
                        @(sec.TempsPasseSystematiqueMinutes?.ToString() ?? "—") min /
                        @(sec.TempsPasseRetoucheMinutes?.ToString() ?? "—") min
                    </td>
                </tr>
            </table>

            <div class="subsection-title">Tableau I — Directives de l'Autorité Responsable</div>
            <div class="directives-box">
                @(sec.Directives ?? "—")
                @if (!string.IsNullOrEmpty(sec.TechnicalOrderReference))
                {
                    <div><strong>Référence T.O. :</strong> @sec.TechnicalOrderReference</div>
                }
                @if (!string.IsNullOrEmpty(sec.DirectiveIssuedByName))
                {
                    <div>
                        <strong>Émise par :</strong> @sec.DirectiveIssuedByName
                        @if (sec.DirectiveIssuedAtUtc.HasValue)
                        {
                            <span> — @sec.DirectiveIssuedAtUtc.Value.ToString("dd/MM/yyyy")</span>
                        }
                    </div>
                }
            </div>

            <div class="subsection-title">Tableau II — Équipements Changés ou Remis en État</div>
            <table class="jc-table">
                <thead>
                    <tr>
                        <th>Désignation / Position</th>
                        <th>Ancien</th>
                        <th>Nouveau</th>
                        <th>Motif dépose</th>
                        <th class="center">Sym.</th>
                        <th class="center">Date</th>
                        <th class="center">Temps passé</th>
                        <th>Exécutant</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in sec.Parts)
                    {
                        <tr>
                            <td>@(p.DesignationEtPosition ?? "—")</td>
                            <td>@(p.OldNomenclature) @(p.OldNumero)</td>
                            <td>@(p.NewNomenclature) @(p.NewNumero)</td>
                            <td>@(p.MotifDepose ?? "—")</td>
                            <td class="center">@(p.Symbole ?? "—")</td>
                            <td class="center">@(p.Date?.ToString("dd/MM/yy") ?? "—")</td>
                            <td class="center">@(p.TempsPasseMinutes?.ToString() ?? "—")'</td>
                            <td>@(p.ExecutantSpecial) @(p.ExecutantNom)</td>
                        </tr>
                    }
                    @if (!sec.Parts.Any())
                    {
                        <tr><td colspan="8" class="center">Aucun équipement changé</td></tr>
                    }
                </tbody>
            </table>

            <div class="subsection-title">Tableau III — Travaux Effectués (Systématiques - Retouches - Modifications)</div>
            <table class="jc-table">
                <thead>
                    <tr>
                        <th style="width:40%;">Désignation des travaux</th>
                        <th class="center">Date</th>
                        <th class="center">Alloué</th>
                        <th class="center">Système</th>
                        <th class="center">Retouches</th>
                        <th>Exécutant</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in sec.Tasks)
                    {
                        <tr>
                            <td>@t.DesignationTravaux</td>
                            <td class="center">@(t.Date?.ToString("dd/MM/yy") ?? "—")</td>
                            <td class="center">@(t.TempsAlloueMinutes?.ToString() ?? "—")'</td>
                            <td class="center">@(t.TempsPasseSystemeMinutes?.ToString() ?? "—")'</td>
                            <td class="center">@(t.TempsPasseRetouchesMinutes?.ToString() ?? "—")'</td>
                            <td>@(t.ExecutantSpecial) @(t.ExecutantNom)</td>
                        </tr>
                    }
                    @if (!sec.Tasks.Any())
                    {
                        <tr><td colspan="6" class="center">Aucun travail enregistré</td></tr>
                    }
                </tbody>
            </table>

            <div class="subsection-title">Visas</div>
            <table class="signoff-table">
                <thead>
                    <tr>
                        <th style="width:20%;">Niveau</th>
                        <th style="width:25%;">Nom</th>
                        <th style="width:15%;">Cachet</th>
                        <th style="width:20%;">Date</th>
                        <th style="width:20%;">Remarques</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var so in sec.SignOffs)
                    {
                        <tr>
                            <td><strong>@so.LevelLabel</strong></td>
                            @if (so.IsSigned)
                            {
                                <td class="signed">@so.SignedByName</td>
                                <td class="signed">@(so.StampReference ?? "—")</td>
                                <td class="signed">@so.SignedAtUtc!.Value.ToString("dd/MM/yyyy")</td>
                                <td>@(so.Remarks ?? "—")</td>
                            }
                            else
                            {
                                <td class="sig-line"></td>
                                <td class="sig-line"></td>
                                <td class="sig-line"></td>
                                <td class="sig-line"></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

            <div class="footer">
                <span>OT @Model.WONumber — Section @sec.SectionCode</span>
                <span>Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
    }

</body>
</html>
