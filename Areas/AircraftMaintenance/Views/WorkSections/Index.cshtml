@model List<FRAProject.ViewModels.AircraftMaintenance.WorkSectionListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sections de travail";
}

<style>
    .ws-index .group-row td {
        background-color: #23262d;
        color: #c9ccd1;
        border-top: 2px solid #363b44;
    }

    .ws-index table td, .ws-index table th {
        border-color: #363b44;
    }

    .ws-index code {
        color: #ff8fa3;
        background: transparent;
    }

    .ws-filter-bar {
        background-color: #2b2f36;
        padding: 10px 16px;
        border-bottom: 1px solid #363b44;
    }

        .ws-filter-bar select {
            background-color: #23262d;
            border: 1px solid #454b54;
            color: #e9ecef;
            max-width: 280px;
            display: inline-block;
        }

        .ws-filter-bar label {
            color: #c9ccd1;
            font-weight: 600;
            font-size: 0.85rem;
            margin-right: 8px;
        }
</style>

<div class="ws-index card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-sitemap mr-1"></i> Sections de travail</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Nouvelle section
        </a>
    </div>

    <div class="ws-filter-bar">
        <label for="acMainGroupFilter">Filtrer par famille d'aéronefs :</label>
        <select id="acMainGroupFilter" class="form-control form-control-sm">
            <option value="">-- Toutes --</option>
            @foreach (var acMainGroup in (List<string>)ViewBag.AllAcMainGroupLabels)
            {
                <option value="@acMainGroup">@acMainGroup</option>
            }
        </select>
    </div>

    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }

        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Nom</th>
                    <th>Famille d'aéronefs</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="workSectionsBody">
                @foreach (var group in Model.GroupBy(x => x.AcMainGroupLabel).OrderBy(g => g.Key))
                {
                    <tr class="group-row" data-acmaingroup="@group.Key">
                        <td colspan="5"><strong>@group.Key</strong></td>
                    </tr>
                    @foreach (var item in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Code))
                    {
                        <tr data-acmaingroup="@item.AcMainGroupLabel">
                            <td><code>@item.Code</code></td>
                            <td>@item.Name</td>
                            <td>@item.AcMainGroupLabel</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Actif</span>
                                }
                                else
                                {

                                    <span class="badge badge-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Supprimer
                                </a>
                            </td>
                        </tr>
                    }
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucune section définie.</td></tr>
                }
                <tr id="noResultsRow" style="display:none;">
                    <td colspan="5" class="text-center text-muted py-4">
                        Aucune section définie pour cette famille d'aéronefs.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('acMainGroupFilter')?.addEventListener('change', function (e) {
            var selected = e.target.value;
            var rows = document.querySelectorAll('#workSectionsBody tr[data-acmaingroup]');
            var visibleDataRows = 0;

            rows.forEach(function (row) {
                var matches = !selected || row.getAttribute('data-acmaingroup') === selected;
                row.style.display = matches ? '' : 'none';
                if (matches && !row.classList.contains('group-row')) {
                    visibleDataRows++;
                }
            });

            document.getElementById('noResultsRow').style.display =
                (selected && visibleDataRows === 0) ? '' : 'none';
        });
    </script>
}
