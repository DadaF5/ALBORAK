@model List<FRAProject.ViewModels.AircraftMaintenance.WorkSectionListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sections de travail";
}

<style>
    .ws-index .group-row td {
        background-color: #23262d;
        color: #c9ccd1;
        border-top: 2px solid #363b44;
    }

    .ws-index table td, .ws-index table th {
        border-color: #363b44;
    }

    .ws-index code {
        color: #ff8fa3;
        background: transparent;
    }
</style>

<div class="ws-index card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-sitemap mr-1"></i> Sections de travail</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Nouvelle section
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }

        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Nom</th>
                    <th>Type d'aéronef</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.GroupBy(x => x.AcTypeLabel).OrderBy(g => g.Key))
                {
                    <tr class="group-row">
                        <td colspan="5"><strong>@group.Key</strong></td>
                    </tr>
                    @foreach (var item in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Code))
                    {
                        <tr>
                            <td><code>@item.Code</code></td>
                            <td>@item.Name</td>
                            <td>@item.AcTypeLabel</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Actif</span>
                                }
                                else
                                {

                                    <span class="badge badge-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Supprimer
                                </a>
                            </td>
                        </tr>
                    }
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucune section définie.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>