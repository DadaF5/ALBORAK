@model IEnumerable<FRAProject.ViewModels.Rank.RankViewModel>

<h2>Ranks</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Add New Rank</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Full Rank</th>
            <th>Sequence</th>
            <th>Rank Type</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.FullRank</td>
                <td>@item.Sequence</td>
                <td>@item.RankTypeId</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

