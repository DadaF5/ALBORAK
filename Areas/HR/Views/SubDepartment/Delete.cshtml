@model FRAProject.ViewModels.SubDepartment.SubDepartmentDeleteViewModel

@{
    ViewData["Title"] = "Delete Sub-Department";
}

<div class="content-wrapper">

    <section class="content-header">
        <h1>Delete Sub-Department</h1>
        <p class="text-danger">Are you sure you want to delete this sub-department?</p>
    </section>

    <section class="content">

        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">Confirm Delete</h3>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Department</dt>
                        <dd class="col-sm-9">@Model.DepartmentName</dd>

                        <dt class="col-sm-3">Base</dt>
                        <dd class="col-sm-9">@Model.BaseName</dd>

                    </dl>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>

    </section>
</div>

