@page
@using Microsoft.AspNetCore.Identity
@using FRAProject.Models
@attribute [IgnoreAntiforgeryToken]
@inject SignInManager<ApplicationUser> SignInManager
@model FRAProject.Areas.Identity.Pages.Account.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FRA Flight Ops</title>

    <link href="/lib/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/lib/plugins/fontawesome-free/css/all.min.css" />

    <style>
        :root {
            --primary-color: #1a237e;
            --secondary-color: #283593;
            --accent-color: #00b0ff;
            --bg-dark-1: #0f172a;
            --bg-dark-2: #1e293b;
            --text-muted: #64748b;
            --border-soft: #e2e8f0;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            min-height: 100vh;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, var(--bg-dark-1) 0%, var(--bg-dark-2) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
        }

        .login-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: #fff;
            padding: 2rem 2rem 1.75rem;
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            text-align: left;
        }

        .brand-logo {
            width: 72px;
            height: 72px;
            object-fit: contain;
            flex-shrink: 0;
        }

        .brand h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .brand p {
            margin: 8px 0 0;
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .login-body {
            padding: 2rem;
        }

        .login-title {
            text-align: center;
            font-size: 1.9rem;
            font-weight: 400;
            color: #1f2937;
            margin-bottom: 1.75rem;
        }

        .form-label {
            font-weight: 600;
            color: #111827;
            margin-bottom: 0.45rem;
        }

        .form-control {
            border-radius: 12px;
            padding: 0.85rem 1rem;
            border: 2px solid var(--border-soft);
            font-size: 1rem;
            transition: all 0.2s ease-in-out;
        }

            .form-control:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 0.2rem rgba(0, 176, 255, 0.15);
            }

        .password-wrapper {
            position: relative;
        }

            .password-wrapper .form-control {
                padding-right: 3rem;
            }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 0.85rem;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #64748b;
            padding: 0;
            cursor: pointer;
        }

            .toggle-password:hover {
                color: var(--primary-color);
            }

        .form-check {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            margin-top: 0.5rem;
            margin-bottom: 1.35rem;
        }

        .form-check-input {
            margin-top: 0;
        }

            .form-check-input:checked {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
            }

        .form-check-label {
            color: #1f2937;
            font-weight: 500;
        }

        .btn-login {
            width: 100%;
            border: none;
            border-radius: 12px;
            padding: 0.9rem 1rem;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: #fff;
            font-size: 1.05rem;
            font-weight: 700;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .btn-login:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 12px 24px rgba(26, 35, 126, 0.25);
            }

            .btn-login:focus {
                color: #fff;
                box-shadow: 0 0 0 0.2rem rgba(40, 53, 147, 0.25);
            }

        .login-links {
            margin-top: 1.35rem;
            text-align: center;
            font-size: 0.96rem;
            line-height: 1.8;
        }

            .login-links a {
                color: var(--primary-color);
                text-decoration: none;
                font-weight: 600;
            }

                .login-links a:hover {
                    text-decoration: underline;
                }

        .validation-summary-errors,
        .text-danger.validation-summary-valid {
            margin-bottom: 1rem;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 1.1rem;
            }

        .alert {
            border-radius: 12px;
            border: none;
        }

        .field-validation-error {
            font-size: 0.875rem;
            margin-top: 0.35rem;
            display: block;
        }

        @@media (max-width: 576px) {
            body

        {
            padding: 16px;
            align-items: center;
        }

        .login-card {
            max-width: 100%;
            border-radius: 18px;
        }

        .login-header,
        .login-body {
            padding: 1.4rem;
        }

        .brand {
            flex-direction: column;
            text-align: center;
        }

            .brand h1 {
                font-size: 1.6rem;
            }

        .login-title {
            font-size: 1.6rem;
        }

        .login-links .separator {
            display: none;
        }

        .login-links a {
            display: block;
        }

        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="brand">
                <img src="~/images/Air_Force_small.png" alt="ALBORAK Logo" class="brand-logo" />
                <div>
                    <h1>AL-BORAQ</h1>
                    <p>Flight Operations System</p>
                </div>
            </div>
        </div>

        <div class="login-body">
            <div class="login-title">Sign in to your account</div>

            <div asp-validation-summary="All" class="text-danger"></div>

            @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@ViewData["ErrorMessage"]
                </div>
            }

            <form method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email"
                           class="form-control"
                           id="email"
                           name="email"
                           placeholder="name@example.com"
                           autocomplete="username"
                           required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <div class="password-wrapper">
                        <input type="password"
                               class="form-control"
                               id="password"
                               name="password"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button" class="toggle-password" id="togglePassword" aria-label="Show password">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="remember" name="remember" />
                    <label class="form-check-label" for="remember">Remember me</label>
                </div>

                <button type="submit" class="btn btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i>Log in
                </button>

                <div class="login-links">
                    <a asp-area="Identity" asp-page="/Account/ForgotPassword">Forgot your password?</a>
                    <span class="separator mx-2">•</span>
                    <a asp-area="Identity" asp-page="/Account/Register">Register as a new user</a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const togglePassword = document.getElementById('togglePassword');

            if (emailInput) {
                emailInput.focus();
            }

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', function () {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    this.innerHTML = isPassword
                        ? '<i class="fas fa-eye-slash"></i>'
                        : '<i class="fas fa-eye"></i>';
                    this.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                });
            }
        });
    </script>
</body>
</html>