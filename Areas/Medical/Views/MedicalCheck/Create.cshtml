@model FRAProject.ViewModels.MedicalCheckVm.MedicalCheckCreateVm
@using FRAProject.Enums

@{
    ViewData["Title"] = "Create Medical Check";
}

<h2>Create Medical Check</h2>

<hr />

<!-- ============================= -->
<!-- CREW CONTEXT                 -->
<!-- ============================= -->
<div class="alert alert-secondary">
    <strong>@Model.CrewMemberName</strong> — @Model.BaseId
</div>

<form asp-action="Create" method="post">

    <input type="hidden" asp-for="CrewMemberId" />
    <input type="hidden" asp-for="BaseId" />

    <!-- ============================= -->
    <!-- CHECK CORE DATA               -->
    <!-- ============================= -->
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="CheckDate" class="form-label"></label>
            <input asp-for="CheckDate" type="date" class="form-control" />
            <span asp-validation-for="CheckDate" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="CheckType" class="form-label"></label>
            <select asp-for="CheckType"
                    asp-items="Html.GetEnumSelectList<MedicalCheckType>()"
                    class="form-select">
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="Decision" class="form-label"></label>
            <select asp-for="Decision"
                    asp-items="Html.GetEnumSelectList<MedicalDecision>()"
                    class="form-select">
            </select>
        </div>
    </div>

    <!-- ============================= -->
    <!-- MEDICAL FLAGS                -->
    <!-- ============================= -->
    <fieldset class="border p-3 mb-3">
        <legend class="w-auto px-2">Medical Flags</legend>

        <div class="form-check">
            <input asp-for="Derogation" class="form-check-input" />
            <label asp-for="Derogation" class="form-check-label" style="padding-left:20px;"></label>
        </div>

        <div class="form-check">
            <input asp-for="Obesite" class="form-check-input" />
            <label asp-for="Obesite" class="form-check-label" style="padding-left:20px;">Obesity</label>
        </div>

        <div class="form-check">
            <input asp-for="CorrectionOptique" class="form-check-input" />
            <label asp-for="CorrectionOptique" class="form-check-label" style="padding-left:20px;">
                Optical correction
            </label>
        </div>

    </fieldset>
    <fieldset class="border p-3 mb-3">
        <legend class="w-auto px-2">Medical Validity Duration</legend>

        <div class="row">
            <div class="col-md-4">
                <label class="form-label">Years</label>
                <select asp-for="DurationYears" class="form-select">
                    <option value="0">0</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Months</label>
                <select asp-for="DurationMonths" class="form-select">
                    @for (int i = 0; i <= 11; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Days</label>
                <select asp-for="DurationDays" class="form-select">
                    @for (int i = 0; i <= 30; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
        </div>

        <span asp-validation-summary="ModelOnly" class="text-danger"></span>
    </fieldset>

    <!-- ============================= -->
    <!-- LATE CHECK HANDLING          -->
    <!-- ============================= -->
    
   
        <div class="alert alert-warning">
            <strong>Late medical check</strong><br />
            This check is overdue. A reason is mandatory.
        </div>

        <div class="mb-3">
            <label asp-for="LateCheckReason" class="form-label"></label>
            <textarea asp-for="LateCheckReason"
                      class="form-control"
                      rows="3"></textarea>
            <span asp-validation-for="LateCheckReason" class="text-danger"></span>
        </div>
   

    <!-- ============================= -->
    <!-- DOCTOR NOTES                 -->
    <!-- ============================= -->
    <div class="mb-3">
        <label asp-for="Decision" class="form-label"></label>
        <textarea asp-for="Decision"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <!-- ============================= -->
    <!-- ACTIONS                      -->
    <!-- ============================= -->
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            Save Medical Check
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>
