@model FRAProject.ViewModels.AcMainGroup.AcMainGroupViewModel

@{
    ViewData["Title"] = "Create Aircraft Main Group";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="content-wrapper">

    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">
                        <i class="fa fa-fighter-jet mr-2"></i>Create Aircraft Main Group
                    </h1>
                    <small class="text-muted">Add a new aircraft main group to the system</small>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home"><i class="fas fa-home mr-1"></i>Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index"><i class="fas fa-list mr-1"></i>Aircraft Main Groups</a></li>
                        <li class="breadcrumb-item active"><i class="fas fa-plus-circle mr-1"></i>Create</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <div class="card card-primary card-outline">
                        <div class="card-header border-bottom-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <h3 class="card-title mb-0">
                                    <i class="fas fa-plus-circle mr-2"></i>New Main Group Details
                                </h3>
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-arrow-left mr-1"></i> Back to List
                                </a>
                            </div>
                        </div>

                        <div class="card-body pt-0">
                            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                                <i class="fas fa-info-circle mr-2"></i>
                                <div>Fields marked with <span class="text-danger">*</span> are required</div>
                            </div>

                            <form asp-action="Create" method="post" id="createForm">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                    <h5 class="alert-heading">Please fix the following errors:</h5>
                                </div>

                                <div class="row">
                                    <!-- Category -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="AcCategoryId" class="form-label font-weight-bold">
                                                Aircraft Category <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-tags"></i></span>
                                                </div>
                                                <select asp-for="AcCategoryId" class="form-control select2"
                                                        data-placeholder="Select Category"
                                                        asp-items="ViewBag.AcCategories"
                                                        required>
                                                    <option value="">-- Select Category --</option>
                                                </select>
                                            </div>
                                            <span asp-validation-for="AcCategoryId" class="text-danger small"></span>
                                            <small class="form-text text-muted">Select the aircraft category for this group</small>
                                        </div>
                                    </div>

                                    <!-- Base -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="BaseId" class="form-label font-weight-bold">
                                                Base Location <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                                </div>
                                                <select asp-for="BaseId" class="form-control select2"
                                                        data-placeholder="Select Base"
                                                        asp-items="ViewBag.Bases"
                                                        required>
                                                    <option value="">-- Select Base --</option>
                                                </select>
                                            </div>
                                            <span asp-validation-for="BaseId" class="text-danger small"></span>
                                            <small class="form-text text-muted">Select the base location for this group</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <!-- Group Name -->
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label asp-for="Name" class="form-label font-weight-bold">
                                                Main Group Name <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-plane"></i></span>
                                                </div>
                                                <input asp-for="Name" class="form-control"
                                                       placeholder="Enter Main Group Name (e.g., 'F-16 Falcon')"
                                                       maxlength="100"
                                                       required />
                                            </div>
                                            <span asp-validation-for="Name" class="text-danger small"></span>
                                            <small class="form-text text-muted">Enter a descriptive name for the main group (max 100 characters)</small>
                                            <div class="progress mt-2" style="height: 3px;">
                                                <div class="progress-bar bg-info" id="nameProgress" style="width: 0%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Description -->
                                <div class="form-group">
                                    <label asp-for="Description" class="form-label font-weight-bold">
                                        Description
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-align-left"></i></span>
                                        </div>
                                        <textarea asp-for="Description" class="form-control"
                                                  rows="2"
                                                  placeholder="Provide detailed description of this main group (optional)"
                                                  maxlength="500"></textarea>
                                    </div>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between mt-1">
                                        <small class="form-text text-muted">Optional description (max 500 characters)</small>
                                        <small class="form-text text-muted"><span id="charCount">0</span>/500</small>
                                    </div>
                                </div>

                                <!-- Active Status -->
                                <div class="form-group">
                                    <div class="custom-control custom-switch custom-switch-lg">
                                        <input asp-for="IsActive" class="custom-control-input" id="isActiveSwitch" type="checkbox" checked />
                                        <label asp-for="IsActive" class="custom-control-label font-weight-bold" for="isActiveSwitch">
                                            <i class="fas fa-power-off mr-1"></i> Active Status
                                        </label>
                                    </div>
                                    <div class="alert alert-light border mt-2" id="statusAlert">
                                        <i class="fas fa-info-circle mr-2"></i>
                                        <span id="statusText">This group will be active and available for use immediately after creation.</span>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="form-group mt-5 pt-3 border-top">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <button type="submit" class="btn btn-success btn-lg px-4" id="submitBtn">
                                                <i class="fas fa-check-circle mr-2"></i> Create Main Group
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-lg ms-2" id="resetBtn">
                                                <i class="fas fa-redo mr-2"></i> Reset
                                            </button>
                                        </div>
                                        <div>
                                            <a asp-action="Index" class="btn btn-outline-danger btn-lg">
                                                <i class="fas fa-times-circle mr-2"></i> Cancel
                                            </a>
                                        </div>
                                    </div>
                                    <div class="text-center mt-3">
                                        <small class="text-muted">
                                            <i class="fas fa-shield-alt mr-1"></i>
                                            All information will be securely saved to the database
                                        </small>
                                    </div>
                                </div>

                            </form>
                        </div>

                        <div class="card-footer bg-light">
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        <i class="fas fa-clock mr-1"></i>
                                        Created: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                                <div class="col-md-6 text-right">
                                    <small class="text-muted">
                                        <i class="fas fa-user-circle mr-1"></i>
                                        User: @User.Identity.Name
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize Select2 for dropdowns
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%'
            });

            // Character counter for description
            $('#Description').on('input', function () {
                var length = $(this).val().length;
                $('#charCount').text(length);
                if (length > 450) {
                    $('#charCount').addClass('text-warning');
                } else {
                    $('#charCount').removeClass('text-warning');
                }
            });

            // Name input progress bar
            $('#Name').on('input', function () {
                var length = $(this).val().length;
                var percentage = (length / 100) * 100;
                $('#nameProgress').css('width', percentage + '%');
            });

            // Toggle status alert message
            $('#isActiveSwitch').change(function () {
                if ($(this).is(':checked')) {
                    $('#statusText').text('This group will be active and available for use immediately after creation.');
                    $('#statusAlert').removeClass('alert-warning').addClass('alert-light');
                } else {
                    $('#statusText').text('This group will be inactive and not available for use until activated.');
                    $('#statusAlert').removeClass('alert-light').addClass('alert-warning');
                }
            });

            // Form reset button
            $('#resetBtn').click(function () {
                if (confirm('Are you sure you want to reset the form? All entered data will be lost.')) {
                    document.getElementById('createForm').reset();
                    $('.select2').val(null).trigger('change');
                    $('#charCount').text('0');
                    $('#nameProgress').css('width', '0%');
                    $('#isActiveSwitch').prop('checked', true).trigger('change');
                }
            });

            // Form submit with loading state
            $('#createForm').submit(function () {
                $('#submitBtn').prop('disabled', true);
                $('#submitBtn').html('<span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span> Creating...');
            });

            // Show validation errors in a better way
            $('.field-validation-error').each(function () {
                $(this).closest('.form-group').addClass('has-error');
            });

            // Initialize tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>

    <style>
        .card {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border: 1px solid #dee2e6;
        }

        .card-header {
            background: linear-gradient(45deg, #2c3e50, #4a6491);
            color: white;
        }

        .form-group.has-error .form-control {
            border-color: #dc3545;
            background-color: #fff8f8;
        }

        .form-group.has-error .input-group-text {
            border-color: #dc3545;
            background-color: #f8d7da;
        }

        .select2-container--bootstrap4 .select2-selection--single {
            height: calc(2.25rem + 2px);
            padding: .375rem .75rem;
        }

        .custom-switch.custom-switch-lg .custom-control-label::before {
            width: 3.5rem;
            height: 1.75rem;
            border-radius: .9rem;
        }

        .custom-switch.custom-switch-lg .custom-control-label::after {
            width: calc(1.75rem - 4px);
            height: calc(1.75rem - 4px);
            border-radius: .9rem;
        }

        .custom-switch.custom-switch-lg .custom-control-input:checked ~ .custom-control-label::after {
            transform: translateX(1.75rem);
        }

        .btn-lg {
            padding: .75rem 2rem;
            font-size: 1.1rem;
        }

        .progress {
            background-color: #e9ecef;
        }

        .alert-light {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Better icon alignment */
        .input-group-text i {
            width: 16px;
            text-align: center;
        }

        /* Breadcrumb icon spacing */
        .breadcrumb-item i {
            margin-right: 4px;
        }
    </style>
}