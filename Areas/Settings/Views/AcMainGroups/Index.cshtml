@model FRAProject.Areas.Settings.ViewModels.AcMainGroupIndexVm
@{
    ViewData["Title"] = "Groupes d'aéronefs";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="container mt-3">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Groupes d'aéronefs</h4>
        <small class="text-muted">
            AcCategory → AcMainGroup → AcType → AircraftVersion
        </small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Nouveau groupe
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Search form ──────────────────────────────────────────────── *@
<div class="card card-dark border-secondary mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Catégorie</label>
                    <select name="searchAcCategoryId"
                            asp-items="Model.AcCategoryOptions"
                            class="form-select form-select-sm bg-dark text-white border-secondary">
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Base</label>
                    <select name="searchBaseId"
                            asp-items="Model.BaseOptions"
                            class="form-select form-select-sm bg-dark text-white border-secondary">
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Code</label>
                    <input name="searchCode" value="@Model.SearchCode"
                           class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="ex: CHASSE-2B…" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Nom</label>
                    <input name="searchName" value="@Model.SearchName"
                           class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="Rechercher…" />
                </div>

                <div class="col-md-1">
                    <label class="form-label small text-muted mb-1">Statut</label>
                    <select name="searchActive"
                            class="form-select form-select-sm bg-dark text-white border-secondary">
                        <option value="">Tous</option>
                        <option value="true"  @@(Model.SearchActive == true  ? "selected" : "")>Actifs</option>
                        <option value="false" @@(Model.SearchActive == false ? "selected" : "")>Inactifs</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <input type="hidden" name="sortColumn"    value="@Model.SortColumn" />
                    <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                    <input type="hidden" name="pageSize"      value="@Model.PageSize" />
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="fas fa-search me-1"></i>Rechercher
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary btn-sm"
                       title="Réinitialiser">
                        <i class="fas fa-times"></i>
                    </a>
                </div>

            </div>
        </form>
    </div>
</div>

@* ── Results info + page size picker ─────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-2">
    <small class="text-muted">
        @if (Model.TotalCount == 0)
        {
            <span>Aucun résultat.</span>
        }
        else
        {
            <span>
                Affichage @Model.FirstItem–@Model.LastItem
                sur @Model.TotalCount résultat(s)
            </span>
        }
    </small>
    <div class="d-flex align-items-center gap-1">
        <small class="text-muted me-1">Par page :</small>
        @foreach (var size in new[] { 10, 25, 50 })
        {
            <a asp-action="Index"
               asp-route-searchAcCategoryId="@Model.SearchAcCategoryId"
               asp-route-searchBaseId="@Model.SearchBaseId"
               asp-route-searchCode="@Model.SearchCode"
               asp-route-searchName="@Model.SearchName"
               asp-route-searchActive="@Model.SearchActive"
               asp-route-sortColumn="@Model.SortColumn"
               asp-route-sortDirection="@Model.SortDirection"
               asp-route-pageSize="@size"
               asp-route-pageNumber="1"
               class="btn btn-outline-secondary btn-sm @(Model.PageSize == size ? "active" : "")">
                @size
            </a>
        }
    </div>
</div>

@* ── Data table ───────────────────────────────────────────────── *@
<div class="card border-secondary">
    <div class="card-body p-0">
        <table class="table table-hover table-sm mb-0">
            <thead style="background-color: darkolivegreen;">
                <tr>
                    @{
                        string SortLink(string col) => Url.Action("Index", new
                        {
                            searchAcCategoryId = Model.SearchAcCategoryId,
                            searchBaseId       = Model.SearchBaseId,
                            searchCode         = Model.SearchCode,
                            searchName         = Model.SearchName,
                            searchActive       = Model.SearchActive,
                            sortColumn         = col,
                            sortDirection      = Model.SortDirectionFor(col),
                            pageNumber         = 1,
                            pageSize           = Model.PageSize
                        })!;
                    }
                    <th style="width:130px">
                        <a href="@SortLink("AcCategory")"
                           class="text-white text-decoration-none">
                            Catégorie
                            <i class="fas @Model.SortIconFor("AcCategory") ms-1"></i>
                        </a>
                    </th>
                    <th style="width:130px">
                        <a href="@SortLink("Base")"
                           class="text-white text-decoration-none">
                            Base
                            <i class="fas @Model.SortIconFor("Base") ms-1"></i>
                        </a>
                    </th>
                    <th style="width:120px">
                        <a href="@SortLink("Code")"
                           class="text-white text-decoration-none">
                            Code
                            <i class="fas @Model.SortIconFor("Code") ms-1"></i>
                        </a>
                    </th>
                    <th>
                        <a href="@SortLink("Name")"
                           class="text-white text-decoration-none">
                            Nom du groupe
                            <i class="fas @Model.SortIconFor("Name") ms-1"></i>
                        </a>
                    </th>
                        <th class="text-decoration-none text-white ">
                            Description
                            </th>
                    <th style="width:80px" class="text-center">
                        <a href="@SortLink("SortOrder")"
                           class="text-white text-decoration-none">
                            Ordre
                            <i class="fas @Model.SortIconFor("SortOrder") ms-1"></i>
                        </a>
                    </th>
                    <th style="width:90px" class="text-center">
                        <a href="@SortLink("IsActive")"
                           class="text-white text-decoration-none">
                            Statut
                            <i class="fas @Model.SortIconFor("IsActive") ms-1"></i>
                        </a>
                    </th>
                    <th style="width:160px" class="text-white text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="fas fa-layer-group me-2"></i>
                            Aucun groupe trouvé.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr id="row-@item.Id"
                            class="@(!item.IsActive ? "opacity-50" : "")">
                            <td>
                                <small class="text-muted">
                                    @(item.AcCategoryName ?? "—")
                                </small>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @(item.BaseName ?? "—")
                                </small>
                            </td>
                            <td>
                                <code class="text-warning">@item.Code</code>
                            </td>
                            <td class="fw-500">@item.Name</td>
                            <td>
                                <small class="text-muted">
                                    @(item.Description ?? "—")
                                </small>
                            </td>
                            <td class="text-center">
                                <small class="text-muted">@item.SortOrder</small>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm"
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @if (item.IsActive)
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm ms-1"
                                            title="Désactiver"
                                            onclick="toggleActive(@item.Id, false, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-outline-success btn-sm ms-1"
                                            title="Réactiver"
                                            onclick="toggleActive(@item.Id, true, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                        <i class="fas fa-check"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Pager ────────────────────────────────────────────────────── *@
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Pagination">
        <ul class="pagination pagination-sm justify-content-center mb-0">

            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link bg-dark border-secondary text-white"
                   asp-action="Index"
                   asp-route-searchAcCategoryId="@Model.SearchAcCategoryId"
                   asp-route-searchBaseId="@Model.SearchBaseId"
                   asp-route-searchCode="@Model.SearchCode"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchActive="@Model.SearchActive"
                   asp-route-sortColumn="@Model.SortColumn"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">&laquo;</a>
            </li>

            @for (int p = Math.Max(1, Model.PageNumber - 2);
                      p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link bg-dark border-secondary text-white"
                       asp-action="Index"
                       asp-route-searchAcCategoryId="@Model.SearchAcCategoryId"
                       asp-route-searchBaseId="@Model.SearchBaseId"
                       asp-route-searchCode="@Model.SearchCode"
                       asp-route-searchName="@Model.SearchName"
                       asp-route-searchActive="@Model.SearchActive"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortDirection="@Model.SortDirection"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-pageNumber="@p">@p</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link bg-dark border-secondary text-white"
                   asp-action="Index"
                   asp-route-searchAcCategoryId="@Model.SearchAcCategoryId"
                   asp-route-searchBaseId="@Model.SearchBaseId"
                   asp-route-searchCode="@Model.SearchCode"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchActive="@Model.SearchActive"
                   asp-route-sortColumn="@Model.SortColumn"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">&raquo;</a>
            </li>

        </ul>
    </nav>
}

@Html.AntiForgeryToken()

@section Scripts {
<script>
    const token = document.querySelector(
        'input[name="__RequestVerificationToken"]')?.value;

    function toggleActive(id, activate, name) {
        const action = activate ? 'Activate' : 'Delete';
        const msg    = activate
            ? `Réactiver le groupe « ${name} » ?`
            : `Désactiver le groupe « ${name} » ?`;

        if (!confirm(msg)) return;

        fetch(`/Settings/AcMainGroups/${action}/${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) { window.location.reload(); }
            else { alert(data.message ?? 'Une erreur est survenue.'); }
        })
        .catch(() => alert('Erreur réseau.'));
    }
</script>
}
</div>
