@model FRAProject.Areas.Settings.ViewModels.AcMainGroupFormDto

@{
    ViewData["Title"] = "Modifier le groupe";
}

<div class="container-fluid px-4 py-4">
    <div class="mx-auto" style="max-width: 1180px;">

        <!-- Main card -->
        <div class="card border-0 shadow-sm">

            <div class="card-body px-4 py-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-4">

                        <!-- Row 1 -->
                        <div class="col-md-4">
                            <label asp-for="AcCategoryId" class="form-label text-muted small fw-semibold mb-2">
                                Catégorie d'aéronef <span class="text-danger">*</span>
                            </label>
                            <select asp-for="AcCategoryId"
                                    asp-items="Model.AcCategoryOptions"
                                    class="form-select bg-dark text-white border-secondary shadow-sm">
                            </select>
                            <span asp-validation-for="AcCategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BaseId" class="form-label text-muted small fw-semibold mb-2">
                                Base aérienne <span class="text-danger">*</span>
                            </label>
                            <select asp-for="BaseId"
                                    asp-items="Model.BaseOptions"
                                    class="form-select bg-dark text-white border-secondary shadow-sm">
                            </select>
                            <span asp-validation-for="BaseId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label text-muted small fw-semibold mb-2">
                                Code <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Code"
                                   class="form-control bg-dark text-white border-secondary text-uppercase shadow-sm"
                                   maxlength="30"
                                   placeholder="ex: CHASSE-2B"
                                   style="max-width: 240px; letter-spacing: 1px; font-family: monospace;"
                                   oninput="this.value=this.value.toUpperCase()" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <!-- Row 2 -->
                        <div class="col-md-4">
                            <label asp-for="Name" class="form-label text-muted small fw-semibold mb-2">
                                Nom du groupe <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name"
                                   class="form-control bg-dark text-white border-secondary shadow-sm"
                                   maxlength="50"
                                   placeholder="ex: Chasse 2ème BAFRA…" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Description" class="form-label text-muted small fw-semibold mb-2">
                                Description
                            </label>
                            <input asp-for="Description"
                                   class="form-control bg-dark text-white border-secondary shadow-sm"
                                   maxlength="50"
                                   placeholder="Remarques…" />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SortOrder" class="form-label text-muted small fw-semibold mb-2">
                                Ordre d'affichage
                            </label>
                            <input asp-for="SortOrder"
                                   type="number"
                                   min="0"
                                   max="255"
                                   class="form-control bg-dark text-white border-secondary shadow-sm"
                                   style="max-width: 120px;" />
                            <span asp-validation-for="SortOrder" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">0–255</small>
                        </div>

                        <!-- Row 3 - Checkbox -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       type="checkbox"
                                       role="switch" />
                                <label asp-for="IsActive" class="form-check-label text-muted fw-semibold ms-2">
                                    Groupe actif
                                </label>
                            </div>
                        </div>

                    </div>

                    <!-- Footer actions -->
                    <div class="mt-5 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            @if (Model.IsActive)
                            {
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        onclick="quickToggle(@Model.Id, false, '@Html.Raw(Model.Name.Replace("'", "\\'"))')">
                                    <i class="bi bi-ban"></i> Désactiver ce groupe
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-outline-success btn-sm"
                                        onclick="quickToggle(@Model.Id, true, '@Html.Raw(Model.Name.Replace("'", "\\'"))')">
                                    <i class="bi bi-check-lg"></i> Réactiver ce groupe
                                </button>
                            }

                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-lg"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-floppy"></i> Enregistrer
                                </button>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}