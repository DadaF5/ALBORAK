@model FRAProject.Areas.Settings.ViewModels.AcStatusTypeFormDto


<div class="container mt-3">

<div class="row g-3">

    @* ── Code ─────────────────────────────────────────────────────── *@
    <div class="col-md-3">
        <label asp-for="Code" class="form-label text-muted small">
            Code <span class="text-danger">*</span>
        </label>
        <input asp-for="Code"
               class="form-control bg-dark text-white border-secondary text-uppercase"
               placeholder="ex: OPR"
               maxlength="10"
               style="letter-spacing:3px;font-family:monospace;"
               oninput="this.value=this.value.toUpperCase()" />
        <span asp-validation-for="Code" class="text-danger small"></span>
        <small class="text-muted">Code court unique — max 10 car.</small>
    </div>

    @* ── Name ─────────────────────────────────────────────────────── *@
    <div class="col-md-5">
        <label asp-for="Name" class="form-label text-muted small">
            Nom du statut <span class="text-danger">*</span>
        </label>
        <input asp-for="Name"
               class="form-control bg-dark text-white border-secondary"
               placeholder="ex: Opérationnel, En maintenance…" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    @* ── SortOrder ────────────────────────────────────────────────── *@
    <div class="col-md-2">
        <label asp-for="SortOrder" class="form-label text-muted small">
            Ordre d'affichage
        </label>
        <input asp-for="SortOrder"
               type="number"
               class="form-control bg-dark text-white border-secondary"
               min="0" max="9999" />
        <span asp-validation-for="SortOrder" class="text-danger small"></span>
        <small class="text-muted">1 = premier dans les listes</small>
    </div>

    @* ── IsActive ─────────────────────────────────────────────────── *@
    <div class="col-md-2 d-flex align-items-end pb-2">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox"
                   role="switch" />
                <label asp-for="IsActive" class="form-check-label text-muted" style="padding-left:20px;">
                Actif
            </label>
        </div>
    </div>

    @* ── Description ──────────────────────────────────────────────── *@
    <div class="col-12">
        <label asp-for="Description" class="form-label text-muted small">
            Description
        </label>
        <input asp-for="Description"
               class="form-control bg-dark text-white border-secondary"
               placeholder="Contexte d'utilisation de ce statut…"
               maxlength="200" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

</div>
</div>