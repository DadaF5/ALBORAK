@* ════════════════════════════════════════════════════════════════
   Save as: Areas/Settings/Views/AcTypes/Create.cshtml
   ════════════════════════════════════════════════════════════════ *@
@model FRAProject.Areas.Settings.ViewModels.AcTypeFormDto
@{
    ViewData["Title"] = "Nouveau type d'aéronef";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Nouveau type d'aéronef</h4>
            <small class="text-muted">
                <a asp-action="Index" class="text-muted text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                </a>
            </small>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @await Html.PartialAsync("_Form", Model)

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Enregistrer
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
