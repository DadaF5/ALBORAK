@model List<FRAProject.DTOs.AcTypeDto>

@{
    ViewData["Title"] = "Gestion type avion";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="container mt-3">
   @*  @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    } *@

    <div class="d-flex justify-content-between mb-3">
        <h3>Ac Types</h3>
        <a asp-action="Create" class="btn btn-success">Create New</a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Main Group</th>
                        <th>Manufacturer</th>
                        <th>Status</th>
                        <th>Sort Order</th>
                        <th>Max Engines</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.Code</td>
                                <td>@t.Name</td>
                                <td>@t.Description</td>
                                <td>@t.AcMainGroupName</td>
                                <td>@(string.IsNullOrWhiteSpace(t.ManufacturerName) ? "-" : t.ManufacturerName)</td>
                                <td>
                                    @if (t.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@t.SortOrder</td>
                                <td>@t.MaxEngines</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-info">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-3">No aircraft types found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>