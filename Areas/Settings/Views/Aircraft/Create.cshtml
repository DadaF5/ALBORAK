@* ════════════════════════════════════════════════════════════════
   Save as: Areas/Settings/Views/Aircraft/Create.cshtml
   ════════════════════════════════════════════════════════════════ *@
@model FRAProject.Areas.Settings.ViewModels.AircraftFormDto
@{
    ViewData["Title"] = "Nouvel aéronef";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Enregistrement d'un aéronef</h4>
            <small class="text-muted">
                <a asp-action="Index" class="text-muted text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i>Retour à la flotte
                </a>
            </small>
        </div>
        @if (Model.DossierId.HasValue)
        {
            <span class="badge bg-info text-dark">
                <i class="fas fa-link me-1"></i>
                Pré-rempli depuis dossier
                @(Model.DossierNumber ?? $"#{Model.DossierId}")
            </span>
        }
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_Form", Model)
        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Enregistrer dans la flotte
            </button>
        </div>
    </form>
</div>