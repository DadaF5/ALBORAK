@model FRAProject.Areas.Settings.ViewModels.AircraftFormDto
@{
    ViewData["Title"] = $"Modifier — {Model.Registration}";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">
            Modifier l'aéronef
            <span class="text-warning ms-2 font-monospace fw-bold"
                  style="font-size:18px;letter-spacing:3px;">
                @Model.Registration
            </span>
        </h4>
        <small class="text-muted">
            <a asp-action="Index" class="text-muted text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i>Retour à la flotte
            </a>
        </small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Print"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary btn-sm"
           target="_blank"
           title="Fiche aéronef">
            <i class="fas fa-print me-1"></i>Imprimer fiche
        </a>
        @if (!Model.IsActive)
        {
            <span class="badge bg-secondary fs-6">Inactif</span>
        }
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @await Html.PartialAsync("_Form", Model)

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            @if (Model.IsActive)
            {
                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        onclick="quickToggle(@Model.Id, false, '@Model.Registration')">
                    <i class="fas fa-ban me-1"></i>Désactiver
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-success btn-sm"
                        onclick="quickToggle(@Model.Id, true, '@Model.Registration')">
                    <i class="fas fa-check me-1"></i>Réactiver
                </button>
            }
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>Annuler
            </a>
            <button type="submit" class="btn btn-primary" onclick="syncMinutes()">
                <i class="fas fa-save me-1"></i>Enregistrer
            </button>
        </div>
    </div>
</form>

@Html.AntiForgeryToken()

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        function syncMinutes() {
            const h = parseInt(document.getElementById('fh-hours')?.value) || 0;
            const m = parseInt(document.getElementById('fh-mins')?.value) || 0;
            const tot = (h * 60) + m;

            const totalField = document.getElementById('totalFlightMinutes');
            const display = document.getElementById('fhDisplay');

            if (totalField) totalField.value = tot;
            if (display) display.textContent = h + ':' + String(m).padStart(2, '0');
        }

        function loadVersions(acTypeId) {
            if (!acTypeId) {
                repopulate('versionSelect', [], '— Version (optionnel) —');
                return;
            }

            fetch(`/Settings/Aircraft/GetVersions?acTypeId=${acTypeId}`)
                .then(r => r.json())
                .then(data => repopulate('versionSelect', data, '— Version (optionnel) —'));
        }

        function loadMissionRoles(acTypeId) {
            if (!acTypeId) {
                repopulate('missionRoleSelect', [], '— Rôle (optionnel) —');
                return;
            }

            fetch(`/Settings/Aircraft/GetMissionRoles?acTypeId=${acTypeId}`)
                .then(r => r.json())
                .then(data => repopulate('missionRoleSelect', data, '— Rôle (optionnel) —'));
        }

        function repopulate(selectId, items, placeholder) {
            const sel = document.getElementById(selectId);
            if (!sel) return;

            const currentValue = sel.value;
            sel.innerHTML = `<option value="">${placeholder}</option>`;

            items.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.value;
                opt.text = item.text;

                if (String(item.value) === String(currentValue)) {
                    opt.selected = true;
                }

                sel.appendChild(opt);
            });
        }

        function buildObs() {
            const typeText = document.getElementById('acTypeSelect')?.selectedOptions[0]?.text ?? '';
            const registration = document.querySelector('[name="Registration"]')?.value ?? '';
            const obsField = document.querySelector('[name="Obs"]');

            if (obsField && typeText && typeText !== '— Sélectionner le type —') {
                const typePart = typeText.split('—').pop()?.trim() ?? typeText;
                obsField.value = registration
                    ? `${typePart} / ${registration.toUpperCase()}`
                    : typePart;
            }
        }

        function updateStatusPreview() {
            const select = document.getElementById('statusSelect');
            const opt = select?.selectedOptions[0];
            const code = opt?.text?.split('—')[0]?.trim();
            const badge = document.getElementById('statusBadge');
            const wrap = document.getElementById('statusPreview');

            const statusColors = {
                'OPR': 'bg-success',
                'MNT': 'bg-warning text-dark',
                'AOG': 'bg-danger',
                'STK': 'bg-secondary',
                'RAD': 'bg-dark border border-secondary'
            };

            if (code && statusColors[code] && badge && wrap) {
                badge.className = `badge fs-6 ${statusColors[code]}`;
                badge.textContent = opt.text;
                wrap.classList.remove('d-none');
            } else if (wrap) {
                wrap.classList.add('d-none');
            }
        }

        function quickToggle(id, activate, registration) {
            const action = activate ? 'Activate' : 'Delete';
            const msg = activate
                ? `Réactiver l'aéronef ${registration} ?`
                : `Désactiver l'aéronef ${registration} ?`;

            if (!confirm(msg)) return;

            fetch(`/Settings/Aircraft/${action}/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Settings/Aircraft';
                } else {
                    alert(data.message ?? 'Erreur.');
                }
            })
            .catch(() => alert('Erreur réseau.'));
        }

        document.getElementById('fh-hours')?.addEventListener('input', syncMinutes);
        document.getElementById('fh-mins')?.addEventListener('input', syncMinutes);

        document.getElementById('acTypeSelect')?.addEventListener('change', function () {
            loadVersions(this.value);
            loadMissionRoles(this.value);
            buildObs();
        });
         // Edit.cshtml — same function, added right after the acTypeSelect
        // 'change' listener (after line 208's closing });), and called
        // alongside the existing syncMinutes()/updateStatusPreview() at the bottom
        function toggleCloudSeeding() {
            const opt = document.getElementById('acTypeSelect')?.selectedOptions[0];
            const code = opt?.text?.split('—')[0]?.trim();
            const wrapper = document.getElementById('cloudSeedingWrapper');
            if (wrapper) wrapper.classList.toggle('d-none', code !== 'AJET');
        }
        document.getElementById('acTypeSelect')?.addEventListener('change', toggleCloudSeeding);

        // ...further down, alongside the existing calls:
        syncMinutes();
        updateStatusPreview();
        toggleCloudSeeding();
        document.querySelector('[name="Registration"]')?.addEventListener('input', buildObs);
        document.getElementById('statusSelect')?.addEventListener('change', updateStatusPreview);

        syncMinutes();
        updateStatusPreview();

        document.querySelector('form')?.addEventListener('submit', function () {
            syncMinutes();
        });
    </script>
}