@model FRAProject.Areas.Settings.ViewModels.AircraftIndexVm
@{
    ViewData["Title"] = "Flotte aéronefs";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="container mt-3">

    @* ── Header ───────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Flotte aéronefs</h4>
            <small class="text-muted">
                Registre opérationnel — 2ème BAFRA
            </small>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Nouvel aéronef
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Fleet summary strip ──────────────────────────────────────── *@
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-secondary text-center py-2">
                <div style="font-family:monospace;font-size:24px;
                        font-weight:700;color:#e2e8f0;">
                    @Model.TotalAircraft
                </div>
                <small class="text-muted">Total flotte</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-success text-center py-2"
                 style="background:rgba(34,197,94,.06);">
                <div style="font-family:monospace;font-size:24px;
                        font-weight:700;color:#22c55e;">
                    @Model.TotalOpr
                </div>
                <small class="text-muted">OPR — Opérationnels</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-warning text-center py-2"
                 style="background:rgba(245,158,11,.06);">
                <div style="font-family:monospace;font-size:24px;
                        font-weight:700;color:#f59e0b;">
                    @Model.TotalMnt
                </div>
                <small class="text-muted">MNT — Maintenance</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-danger text-center py-2"
                 style="background:rgba(239,68,68,.06);">
                <div style="font-family:monospace;font-size:24px;
                        font-weight:700;color:#ef4444;">
                    @Model.TotalAog
                </div>
                <small class="text-muted">AOG — Cloués au sol</small>
            </div>
        </div>
    </div>

    @* ── Search ───────────────────────────────────────────────────── *@
    <div class="card border-secondary mb-3">
        <div class="card-body py-2">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-end">

                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">
                            Marque
                        </label>
                        <input name="searchRegistration" value="@Model.SearchRegistration"
                               class="form-control form-control-sm bg-dark
                                  text-white border-secondary"
                               placeholder="CN-…"
                               style="font-family:monospace;letter-spacing:2px;" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">
                            Type
                        </label>
                        <select name="searchAcTypeId"
                                asp-items="Model.AcTypeOptions"
                                class="form-select form-select-sm bg-dark
                                   text-white border-secondary">
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">
                            Statut
                        </label>
                        <select name="searchStatusId"
                                asp-items="Model.StatusOptions"
                                class="form-select form-select-sm bg-dark
                                   text-white border-secondary">
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">
                            Base
                        </label>
                        <select name="searchBaseId"
                                asp-items="Model.BaseOptions"
                                class="form-select form-select-sm bg-dark
                                   text-white border-secondary">
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label small text-muted mb-1">
                            Filtre
                        </label>
                        <select name="searchActive"
                                class="form-select form-select-sm bg-dark text-white border-secondary">
                            <option value="">Tous</option>

                            @if (Model.SearchActive == true)
                            {
                                <option value="true" selected="selected">Actifs</option>
                            }
                            else
                            {
                                <option value="true">Actifs</option>
                            }

                            @if (Model.SearchActive == false)
                            {
                                <option value="false" selected="selected">Inactifs</option>
                            }
                            else
                            {
                                <option value="false">Inactifs</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <input type="hidden" name="sortColumn"
                               value="@Model.SortColumn" />
                        <input type="hidden" name="sortDirection"
                               value="@Model.SortDirection" />
                        <input type="hidden" name="pageSize"
                               value="@Model.PageSize" />
                        <button type="submit"
                                class="btn btn-primary btn-sm w-100">
                            <i class="fas fa-search me-1"></i>Rechercher
                        </button>
                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-sm"
                           title="Réinitialiser">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @* ── Results info ─────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            @if (Model.TotalCount == 0)
            {
                <span>Aucun aéronef trouvé.</span>
            }
            else
            {
                <span>
                    Affichage @Model.FirstItem–@Model.LastItem
                    sur @Model.TotalCount aéronef(s)
                </span>
            }
        </small>
        <div class="d-flex align-items-center gap-1">
            <small class="text-muted me-1">Par page :</small>
            @foreach (var size in new[] { 10, 15, 25, 50 })
            {
                <a asp-action="Index"
                   asp-route-searchRegistration="@Model.SearchRegistration"
                   asp-route-searchAcTypeId="@Model.SearchAcTypeId"
                   asp-route-searchStatusId="@Model.SearchStatusId"
                   asp-route-searchBaseId="@Model.SearchBaseId"
                   asp-route-searchActive="@Model.SearchActive"
                   asp-route-sortColumn="@Model.SortColumn"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-pageSize="@size"
                   asp-route-pageNumber="1"
                   class="btn btn-outline-secondary btn-sm
                          @(Model.PageSize == size ? "active" : "")">
                    @size
                </a>
            }
        </div>
    </div>

    @* ── Fleet table ──────────────────────────────────────────────── *@
    <div class="card border-secondary">
        <div class="card-body p-0">
            <table class="table table-hover table-sm mb-0">
                <thead style="background-color: darkolivegreen;">
                    <tr>
                        @{
                            string SortLink(string col) => Url.Action("Index", new
                            {
                                searchRegistration = Model.SearchRegistration,
                                searchAcTypeId = Model.SearchAcTypeId,
                                searchStatusId = Model.SearchStatusId,
                                searchBaseId = Model.SearchBaseId,
                                searchActive = Model.SearchActive,
                                sortColumn = col,
                                sortDirection = Model.SortDirectionFor(col),
                                pageNumber = 1,
                                pageSize = Model.PageSize
                            })!;
                        }
                        <th style="width:100px">
                            <a href="@SortLink("Registration")"
                               class="text-white text-decoration-none">
                                Immat.
                                <i class="fas @Model.SortIconFor("Registration") ms-1"></i>
                            </a>
                        </th>
                        <th style="width:60px" class="text-center">
                            <a href="@SortLink("TailNumber")"
                               class="text-white text-decoration-none">
                                Queue
                                <i class="fas @Model.SortIconFor("TailNumber") ms-1"></i>
                            </a>
                        </th>
                        <th>
                            <a href="@SortLink("AcType")"
                               class="text-white text-decoration-none">
                                Type
                                <i class="fas @Model.SortIconFor("AcType") ms-1"></i>
                            </a>
                        </th>
                        <th style="width:120px">Version</th>
                        <th style="width:100px">
                            <a href="@SortLink("Base")"
                               class="text-white text-decoration-none">
                                Base
                                <i class="fas @Model.SortIconFor("Base") ms-1"></i>
                            </a>
                        </th>
                        <th style="width:90px" class="text-center">
                            <a href="@SortLink("Status")"
                               class="text-white text-decoration-none">
                                Statut
                                <i class="fas @Model.SortIconFor("Status") ms-1"></i>
                            </a>
                        </th>
                        <th style="width:90px" class="text-center">
                            <a href="@SortLink("FlightTime")"
                               class="text-white text-decoration-none">
                                HdV TSN
                                <i class="fas @Model.SortIconFor("FlightTime") ms-1"></i>
                            </a>
                        </th>
                        <th style="width:70px" class="text-center">
                            Cycles
                        </th>
                        <th style="width:110px" class="text-center text-white">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center text-muted py-5">
                                <i class="fas fa-plane me-2"></i>
                                Aucun aéronef dans la flotte.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr id="row-@item.Id"
                                class="@(!item.IsActive ? "opacity-50" : "")">
                                <td>
                                    <span class="fw-bold font-monospace
                                                     text-warning"
                                          style="font-size:13px;
                                                     letter-spacing:2px;">
                                        @item.Registration
                                    </span>
                                </td>
                                <td class="text-center">
                                    <small class="text-muted font-monospace">
                                        @item.TailNo
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-500">
                                        @(item.AcTypeName ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @(item.VersionName ?? "—")
                                    </small>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @(item.BaseName ?? "—")
                                    </small>
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.StatusCode))
                                    {
                                        <span class="badge @item.StatusBadgeClass"
                                              style="font-family:monospace;
                                                             font-size:11px;">
                                            @item.StatusCode
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="font-monospace small">
                                        @item.FlightHoursDisplay
                                    </span>
                                </td>
                                <td class="text-center">
                                    <small class="text-muted font-monospace">
                                        @item.TotalCycles.ToString("N0")
                                    </small>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm"
                                       title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Print"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm ms-1"
                                       title="Fiche aéronef"
                                       target="_blank">
                                        <i class="fas fa-print"></i>
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger
                                                               btn-sm ms-1"
                                                title="Désactiver"
                                                onclick="toggleActive(
                                                            @item.Id, false,
                                                            '@item.Registration')">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-success
                                                               btn-sm ms-1"
                                                title="Réactiver"
                                                onclick="toggleActive(
                                                            @item.Id, true,
                                                            '@item.Registration')">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Pager ────────────────────────────────────────────────────── *@
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Pagination">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link bg-dark border-secondary text-white"
                       asp-action="Index"
                       asp-route-searchRegistration="@Model.SearchRegistration"
                       asp-route-searchAcTypeId="@Model.SearchAcTypeId"
                       asp-route-searchStatusId="@Model.SearchStatusId"
                       asp-route-searchBaseId="@Model.SearchBaseId"
                       asp-route-searchActive="@Model.SearchActive"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortDirection="@Model.SortDirection"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-pageNumber="@(Model.PageNumber - 1)">
                        &laquo;
                    </a>
                </li>
                @for (int p = Math.Max(1, Model.PageNumber - 2);
                            p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link bg-dark border-secondary text-white"
                           asp-action="Index"
                           asp-route-searchRegistration="@Model.SearchRegistration"
                           asp-route-searchAcTypeId="@Model.SearchAcTypeId"
                           asp-route-searchStatusId="@Model.SearchStatusId"
                           asp-route-searchBaseId="@Model.SearchBaseId"
                           asp-route-searchActive="@Model.SearchActive"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-pageNumber="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link bg-dark border-secondary text-white"
                       asp-action="Index"
                       asp-route-searchRegistration="@Model.SearchRegistration"
                       asp-route-searchAcTypeId="@Model.SearchAcTypeId"
                       asp-route-searchStatusId="@Model.SearchStatusId"
                       asp-route-searchBaseId="@Model.SearchBaseId"
                       asp-route-searchActive="@Model.SearchActive"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortDirection="@Model.SortDirection"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-pageNumber="@(Model.PageNumber + 1)">
                        &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }

    @Html.AntiForgeryToken()

    @section Scripts {
        <script>
            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]')?.value;

            function toggleActive(id, activate, registration) {
                const action = activate ? 'Activate' : 'Delete';
                const msg    = activate
                    ? `Réactiver l'aéronef ${registration} ?`
                    : `Désactiver l'aéronef ${registration} ?`;

                if (!confirm(msg)) return;

                fetch(`/Settings/Aircraft/${action}/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) { window.location.reload(); }
                    else { alert(data.message ?? 'Erreur.'); }
                })
                .catch(() => alert('Erreur réseau.'));
            }
        </script>
    }
</div>