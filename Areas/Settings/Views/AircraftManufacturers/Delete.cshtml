@model FRAProject.Areas.Settings.Models.AircraftManufacturer
@{
    ViewData["Title"] = "Delete Constructeur";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this item?
</div>

<dl class="row">
    <dt class="col-sm-2">Code</dt>
    <dd class="col-sm-10">@Model.Code</dd>

    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>
</dl>

<form asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>