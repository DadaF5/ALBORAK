@model IEnumerable<FRAProject.Areas.Settings.Models.AircraftManufacturer>

@{
    ViewData["Title"] = "Constructeurs";
      Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";

}
<div class="container mt-3">
<h2>@ViewData["Title"]</h2>

<p>
    <a asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Create" class="btn btn-success">
        Create
    </a>
</p>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Active</th>
            <th>Sort</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Code</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
            <td>@item.SortOrder</td>
            <td class="text-end">
                <a asp-area="Settings" asp-controller="AircraftManufacturers" class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-area="Settings" asp-controller="AircraftManufacturers" class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-area="Settings" asp-controller="AircraftManufacturers" class="btn btn-danger"  asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>