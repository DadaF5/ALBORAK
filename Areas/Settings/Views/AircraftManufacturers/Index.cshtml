@model IEnumerable<FRAProject.Areas.Settings.Models.AircraftManufacturer>

@{
    ViewData["Title"] = "Constructeurs";
}

<style>
    .badge-status {
        font-size: 0.9em;
        padding: 5px 10px;
        border-radius: 12px;
    }
</style>

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Create" class="btn btn-primary">
        Create
    </a>
</p>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Active</th>
            <th>Sort</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Code</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                @if (item.IsActive)
                {
                    <span class="badge badge-success badge-status">
                        <i class="fas fa-check-circle"></i> Active
                    </span>
                }
                else
                {
                    <span class="badge badge-danger badge-status">
                        <i class="fas fa-ban"></i> Inactive
                    </span>
                }
            </td>
            <td>@item.SortOrder</td>
            <td class="text-end">
                <a asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-area="Settings" asp-controller="AircraftManufacturers" asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Deactivate</a>
            </td>
        </tr>
}
    </tbody>
</table>