@model FRAProject.Areas.Settings.Models.AircraftVersion
@{
    ViewData["Title"] = "Version aéronef Details";
}

<h2>@ViewData["Title"]</h2>

<dl class="row">
    <dt class="col-sm-2">Code</dt>
    <dd class="col-sm-10">@Model.Code</dd>

    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Active</dt>
    <dd class="col-sm-10">@Model.IsActive</dd>

    <dt class="col-sm-2">Sort</dt>
    <dd class="col-sm-10">@Model.SortOrder</dd>
</dl>

<a asp-area="Settings" asp-controller="AircraftVersions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-area="Settings" asp-controller="AircraftVersions" asp-action="Index" class="btn btn-secondary">Back</a>