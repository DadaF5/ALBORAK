@model List<FRAProject.ViewModels.Settings.AtaListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chapitres ATA";
}

<style>
    .ata-index table td, .ata-index table th {
        border-color: #363b44;
    }

    .ata-index code {
        color: #ff8fa3;
        background: transparent;
    }

    .ata-index .group-row td {
        background-color: #23262d;
        color: #c9ccd1;
        border-top: 2px solid #363b44;
    }
</style>

<div class="ata-index card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-list-ol mr-1"></i> Chapitres ATA</h3>
        <div>
            <a asp-controller="AtaCategory" asp-action="Index" class="btn btn-default btn-sm">
                <i class="fas fa-sitemap"></i> Catégories
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Nouveau chapitre ATA
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }

        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.GroupBy(x => x.CategoryName ?? "Sans catégorie"))
                {
                    <tr class="group-row">
                        <td colspan="5"><strong>@group.Key</strong></td>
                    </tr>
                    @foreach (var item in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Code))
                    {
                        <tr>
                            <td><code>@item.Code</code></td>
                            <td>@item.Name</td>
                            <td>@(item.Description ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Aucun chapitre ATA défini.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>