@model List<FRAProject.ViewModels.Settings.AtaCategoryListItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Catégories ATA";
}

<div class="card card-outline card-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-sitemap mr-1"></i> Catégories ATA</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Nouvelle catégorie</a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Code</th><th>Nom</th><th>Statut</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
                @foreach (var item in Model.OrderBy(x => x.SortOrder))
                {
                    <tr>
                        <td><code>@item.Code</code></td>
                        <td>@item.Name</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Actif</span>
                            }
                            else
                            {

                                <span class="badge badge-secondary">Inactif</span>
                            }
                        </td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary"><i class="fas fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>