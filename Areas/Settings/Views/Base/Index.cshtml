@using FRAProject.Areas.Settings.DTOs
@model List<BaseDto>

@{
    ViewData["Title"] = "Gestion des Bases";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="container mt-3">

    <div class="d-flex justify-content-between mb-3">
        <h3>Bases Aériennes</h3>
        <a asp-action="Create" class="btn btn-success">Create New</a>
    </div>

    <div class="card">
        <div class="p-0">
            <table class="table table-striped mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Nom de Base</th>
                        <th>Localisation</th>
                        <th>Latitude</th>
                        <th>Longitude</th>
                        <th>Status</th>
                        <th style="width: 200px; text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                <p class="mb-0">Aucune base trouvée. Cliquez sur "Nouvelle Base" pour ajouter.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td><strong>@item.BaseName</strong></td>
                                <td>@item.BaseNameLocal</td>
                                <td>@item.Latitude</td>
                                <td>@item.Longitude</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                            <td style="width: 200px; text-align:center;">
                                <a asp-area="Settings" 
                                    asp-controller="Base" 
                                    asp-action="Edit" 
                                    asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                    <button class="btn btn-sm btn-danger"
                                            onclick="deleteItem('Base', @item.Id, '@item.BaseName')"
                                            title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

@if (Model.Count > 0)
{
    <div class="text-muted small">
        <i class="fas fa-info-circle"></i> Total: @Model.Count base(s)
    </div>
}
@* Anti-forgery token for AJAX requests *@
@Html.AntiForgeryToken()
</div>

