@* ════════════════════════════════════════════════════════════════
   Save as: Areas/Settings/Views/CdnDocType/_Form.cshtml
   ════════════════════════════════════════════════════════════════ *@
@model FRAProject.Areas.Settings.ViewModels.CdnDocTypeFormDto

<div class="row g-3">

    <div class="col-md-2">
        <label asp-for="Code" class="form-label text-muted small">
            Code <span class="text-danger">*</span>
        </label>
        <input asp-for="Code"
               class="form-control bg-dark text-white border-secondary text-uppercase"
               placeholder="ex: CDN"
               maxlength="10"
               style="letter-spacing:3px;font-family:monospace;"
               oninput="this.value=this.value.toUpperCase()" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="Name" class="form-label text-muted small">
            Nom du document <span class="text-danger">*</span>
        </label>
        <input asp-for="Name"
               class="form-control bg-dark text-white border-secondary"
               placeholder="ex: Certificat de navigabilité…" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="SortOrder" class="form-label text-muted small">
            Ordre d'affichage
        </label>
        <input asp-for="SortOrder"
               type="number"
               class="form-control bg-dark text-white border-secondary"
               min="0" max="9999" />
        <span asp-validation-for="SortOrder" class="text-danger small"></span>
    </div>

    <div class="col-md-2 d-flex align-items-end pb-2">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input"
                   type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label text-muted">Actif</label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label text-muted small">Description</label>
        <input asp-for="Description"
               class="form-control bg-dark text-white border-secondary"
               placeholder="Contexte d'utilisation de ce type de document…"
               maxlength="200" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

</div>
