@model FRAProject.Areas.Settings.ViewModels.DossierStep4Dto
@{
    ViewData["Title"] = "Immatriculation — Étape 4";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Pièces justificatives</h4>
        <small class="text-muted">
            Réf. Art. 15, Points 1–6 — Guide GUI-DPC-001
        </small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning text-dark">Form 5a — Étape 4/5</span>
        @{
            var uploaded = Model.Slots.Count(s => s.IsUploaded);
            var total    = Model.Slots.Count;
            var required = Model.Slots.Count(s => s.IsRequired);
            var reqDone  = Model.Slots.Count(s => s.IsRequired && s.IsUploaded);
        }
        <span class="badge @(reqDone == required ? "bg-success" : "bg-secondary")">
            @reqDone / @required obligatoires
        </span>
    </div>
</div>

@await Html.PartialAsync("_WizardProgress",
    (FRAProject.Areas.Settings.ViewModels.WizardProgressVm)ViewBag.Progress)

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>
        @Html.ValidationSummary(false, null, new { @class = "mb-0" })
    </div>
}

@* ── Document slots ───────────────────────────────────────────── *@
<div class="d-flex flex-column gap-3" id="slotContainer">

    @foreach (var slot in Model.Slots)
    {
        <div class="card border-secondary" id="slot-@slot.DocumentTypeId">
            <div class="card-body py-3">
                <div class="d-flex align-items-start justify-content-between gap-3">

                    @* Left — doc info *@
                    <div class="flex-fill">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <code class="text-warning" style="font-size:11px;">
                                @slot.Code
                            </code>
                            @if (slot.ArticleReference != null)
                            {
                                <small class="text-muted">@slot.ArticleReference</small>
                            }
                            <span class="badge @slot.RequirementBadgeClass"
                                  style="font-size:10px;">
                                @slot.RequirementLabel
                            </span>
                        </div>
                        <div class="fw-500" style="font-size:13px;">@slot.Name</div>

                        @if (slot.AcceptedFormats != null || slot.MaxFileSizeMb != null)
                        {
                            <small class="text-muted">
                                @if (slot.AcceptedFormats != null)
                                {
                                    <span>Formats : @slot.AcceptedFormats</span>
                                }
                                @if (slot.MaxFileSizeMb != null)
                                {
                                    <span class="ms-2">Max : @slot.MaxFileSizeMb Mo</span>
                                }
                            </small>
                        }
                    </div>

                    @* Right — upload zone or uploaded file *@
                    <div style="min-width:260px;">

                        @* Uploaded state *@
                        <div id="uploaded-@slot.DocumentTypeId"
                             style="display:@(slot.IsUploaded ? "block" : "none");">
                            <div class="d-flex align-items-center gap-2 p-2 rounded
                                        border border-success"
                                 style="background:rgba(25,135,84,0.08);">
                                <i class="fas fa-check-circle text-success"></i>
                                <div class="flex-fill overflow-hidden">
                                    <div class="text-truncate" style="font-size:12px;"
                                         id="fname-@slot.DocumentTypeId">
                                        @(slot.FileName ?? "")
                                    </div>
                                    <small class="text-muted"
                                           id="fsize-@slot.DocumentTypeId">
                                        @(slot.FileSizeDisplay ?? "")
                                    </small>
                                </div>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        title="Supprimer"
                                        onclick="deleteDoc(@slot.DocumentTypeId,
                                                          @(slot.DocumentId ?? 0))">
                                    <i class="fas fa-trash" style="font-size:11px;"></i>
                                </button>
                            </div>
                        </div>

                        @* Upload zone *@
                        <div id="uploadzone-@slot.DocumentTypeId"
                             style="display:@(slot.IsUploaded ? "none" : "block");">
                            <label class="d-block p-3 rounded border border-secondary
                                          text-center"
                                   style="cursor:pointer;border-style:dashed!important;
                                          transition:all .15s;"
                                   id="zone-@slot.DocumentTypeId"
                                   onmouseover="this.style.borderColor='#ffc107'"
                                   onmouseout="this.style.borderColor=''">
                                <i class="fas fa-upload text-muted mb-1 d-block"></i>
                                <small class="text-muted">
                                    Choisir un fichier
                                </small>
                                <input type="file"
                                       class="d-none doc-input"
                                       accept="@slot.AcceptAttribute"
                                       data-doctype="@slot.DocumentTypeId"
                                       onchange="uploadDoc(this)" />
                            </label>
                            <div id="progress-@slot.DocumentTypeId"
                                 style="display:none;"
                                 class="mt-1">
                                <div class="progress" style="height:3px;">
                                    <div class="progress-bar progress-bar-striped
                                                progress-bar-animated bg-warning"
                                         style="width:100%"></div>
                                </div>
                                <small class="text-muted">Envoi en cours...</small>
                            </div>
                            <div id="error-@slot.DocumentTypeId"
                                 class="text-danger small mt-1"
                                 style="display:none;"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }

</div>

@* ── Navigation ───────────────────────────────────────────────── *@
<form asp-action="SaveStep4" asp-route-id="@Model.DossierId" method="post"
      class="mt-3">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between">
        <a asp-action="Step3"
           asp-route-id="@Model.DossierId"
           class="btn btn-outline-secondary">
            ← Précédent
        </a>
        <button type="submit" class="btn btn-primary"
                id="nextBtn"
                @(!Model.AllRequiredUploaded ? "disabled" : "")>
            Suivant : Validation →
        </button>
    </div>
</form>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    const token = document.querySelector(
        'input[name="__RequestVerificationToken"]')?.value;
    const dossierId = @Model.DossierId;
    let uploadedRequired = @Model.Slots.Count(s => s.IsRequired && s.IsUploaded);
    const totalRequired  = @Model.Slots.Count(s => s.IsRequired);

    // ── Upload ─────────────────────────────────────────────────────
    async function uploadDoc(input) {
        const docTypeId = input.dataset.doctype;
        const file      = input.files[0];
        if (!file) return;

        // Show progress
        document.getElementById(`uploadzone-${docTypeId}`).style.display = 'none';
        document.getElementById(`progress-${docTypeId}`).style.display   = 'block';
        document.getElementById(`error-${docTypeId}`).style.display      = 'none';

        const form = new FormData();
        form.append('documentTypeId', docTypeId);
        form.append('file', file);
        form.append('__RequestVerificationToken', token);

        try {
            const res  = await fetch(
                `/Settings/Dossier/UploadDocument/${dossierId}`, {
                method: 'POST', body: form
            });
            const data = await res.json();

            if (data.success) {
                // Show uploaded state
                document.getElementById(`fname-${docTypeId}`).textContent =
                    data.data.fileName;
                document.getElementById(`fsize-${docTypeId}`).textContent =
                    data.data.fileSizeDisplay;

                // Store documentId for delete
                document.querySelector(
                    `#slot-${docTypeId} button[onclick*="deleteDoc"]`)
                    ?.setAttribute('onclick',
                        `deleteDoc(${docTypeId}, ${data.data.documentId})`);

                document.getElementById(`progress-${docTypeId}`).style.display  = 'none';
                document.getElementById(`uploaded-${docTypeId}`).style.display  = 'block';

                updateNextButton(docTypeId, true);
            } else {
                showError(docTypeId, data.message ?? 'Erreur d\'envoi.');
            }
        } catch {
            showError(docTypeId, 'Erreur réseau.');
        }
    }

    // ── Delete ─────────────────────────────────────────────────────
    async function deleteDoc(docTypeId, documentId) {
        if (!confirm('Supprimer ce fichier ?')) return;

        const form = new FormData();
        form.append('documentId', documentId);
        form.append('__RequestVerificationToken', token);

        const res  = await fetch(
            `/Settings/Dossier/DeleteDocument/${dossierId}`, {
            method: 'POST', body: form
        });
        const data = await res.json();

        if (data.success) {
            document.getElementById(`uploaded-${docTypeId}`).style.display   = 'none';
            document.getElementById(`uploadzone-${docTypeId}`).style.display = 'block';
            document.getElementById(`progress-${docTypeId}`).style.display   = 'none';

            // Reset file input
            const input = document.querySelector(
                `#uploadzone-${docTypeId} input[type="file"]`);
            if (input) input.value = '';

            updateNextButton(docTypeId, false);
        }
    }

    // ── Helpers ────────────────────────────────────────────────────
    function showError(docTypeId, message) {
        document.getElementById(`progress-${docTypeId}`).style.display  = 'none';
        document.getElementById(`uploadzone-${docTypeId}`).style.display = 'block';
        const err = document.getElementById(`error-${docTypeId}`);
        err.textContent    = message;
        err.style.display  = 'block';
    }

    function updateNextButton(docTypeId, uploaded) {
        // Check if this slot is required
        const slot = document.getElementById(`slot-${docTypeId}`);
        const badge = slot?.querySelector('.badge');
        const isRequired = badge?.textContent.trim() === 'Obligatoire';

        if (isRequired) {
            uploadedRequired += uploaded ? 1 : -1;
            const btn = document.getElementById('nextBtn');
            if (btn) {
                btn.disabled = uploadedRequired < totalRequired;
            }
        }
    }
</script>
}
