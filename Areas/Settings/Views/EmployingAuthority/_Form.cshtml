@model FRAProject.Areas.Settings.ViewModels.EmployingAuthorityFormDto

<div class="row g-3">

    @* ── Code ─────────────────────────────────────────────────────── *@
    <div class="col-md-3">
        <div class="form-group">
            <label asp-for="Code" class="form-label text-muted small">
                Code <span class="text-danger">*</span>
            </label>
            <input asp-for="Code"
                   class="form-control bg-dark text-white border-secondary text-uppercase"
                   placeholder="ex: FRA, MR…"
                   maxlength="10"
                   style="letter-spacing:3px;font-family:monospace;font-size:15px;"
                   oninput="this.value=this.value.toUpperCase()" />
            <span asp-validation-for="Code" class="text-danger small"></span>
            <small class="text-muted">Code court unique — max 10 caractères</small>
        </div>
    </div>

    @* ── Name ─────────────────────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Name" class="form-label text-muted small">
                Nom officiel <span class="text-danger">*</span>
            </label>
            <input asp-for="Name"
                   class="form-control bg-dark text-white border-secondary"
                   placeholder="ex: Forces Royales Air…" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
    </div>

    @* ── Sort Order ───────────────────────────────────────────────── *@
    <div class="col-md-2">
        <div class="form-group">
            <label asp-for="SortOrder" class="form-label text-muted small">
                Ordre d'affichage
            </label>
            <input asp-for="SortOrder"
                   type="number"
                   class="form-control bg-dark text-white border-secondary"
                   min="0" max="9999" />
            <span asp-validation-for="SortOrder" class="text-danger small"></span>
            <small class="text-muted">1 = premier dans les listes</small>
        </div>
    </div>

    @* ── IsActive ─────────────────────────────────────────────────── *@
    <div class="col-md-1 d-flex align-items-end pb-2">
        <div class="form-check form-switch">
            <input asp-for="IsActive"
                   class="form-check-input"
                   type="checkbox"
                   role="switch" />
            <label asp-for="IsActive" class="form-check-label text-muted pl-4">
                Actif
            </label>
        </div>
    </div>

</div>
