@{
    ViewData["Title"] = "Accès Refusé";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    <i class="fas fa-lock"></i> Accès Refusé
                </h4>
            </div>
            <div class="card-body text-center py-5">
                <i class="fas fa-exclamation-triangle fa-5x text-warning mb-4"></i>
                <h5 class="mb-3">Vous n'avez pas l'autorisation d'accéder à cette page</h5>
                <p class="text-muted">
                    Cette section est réservée aux <strong>administrateurs</strong> uniquement.
                </p>
                <p class="text-muted">
                    Si vous pensez que vous devriez avoir accès, veuillez contacter votre administrateur système.
                </p>
                <hr>
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i> Retour à l'Accueil
                </a>
            </div>
        </div>
    </div>
</div>
