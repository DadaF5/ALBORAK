@model List<FRAProject.DTOs.BaseDto>
@{
    ViewData["Title"] = "Paramètres système";
    var activeTab = (ViewData["ActiveTab"]?.ToString() ?? "bases").ToLowerInvariant();
}

<div class="card card-mid">
    <div class="card-head">
        <div class="card-title">⚙ Paramètres</div>
    </div>
    <div class="card-body">
        <partial name="~/Areas/Settings/Views/Shared/_SettingsTabs.cshtml" />

        @if (activeTab == "bases")
        {
            <div id="bases-list-container">
                <partial name="~/Areas/Settings/Views/Base/_BaseList.cshtml" model="Model" />
            </div>
        }
        else
        {
            <div class="text-muted">
                Module "@activeTab" en cours de construction.
            </div>
        }
    </div>
</div>

<div class="modal fade" id="baseCrudModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Paramètres - Bases</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body" id="baseCrudModalBody"></div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
}

@section Scripts {
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const currentReturnUrl = '@(Context.Request.Path + Context.Request.QueryString)';
            const modalElement = document.getElementById('baseCrudModal');
            const modalBody = document.getElementById('baseCrudModalBody');
            const baseModal = modalElement ? new bootstrap.Modal(modalElement) : null;

            document.addEventListener('click', function (e) {
                const link = e.target.closest('.js-open-base-modal');
                if (!link || !baseModal) {
                    return;
                }

                e.preventDefault();
                const url = appendReturnUrl(link.getAttribute('href'));
                loadModalContent(url);
            });

            function appendReturnUrl(url) {
                const hasQuery = url.includes('?');
                return `${url}${hasQuery ? '&' : '?'}returnUrl=${encodeURIComponent(currentReturnUrl)}`;
            }

            function loadModalContent(url) {
                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (html) {
                        modalBody.innerHTML = html;
                        $.validator.unobtrusive.parse(modalBody);
                        baseModal.show();
                    },
                    error: function () {
                        showMessage('Impossible de charger le formulaire.', 'error');
                    }
                });
            }

            document.addEventListener('submit', function (e) {
                const form = e.target.closest('.base-modal-form');
                if (!form) {
                    return;
                }

                e.preventDefault();

                $.ajax({
                    url: form.action,
                    type: 'POST',
                    data: $(form).serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (response, status, xhr) {
                        const contentType = xhr.getResponseHeader('content-type') || '';
                        if (contentType.includes('application/json') && response.success) {
                            baseModal.hide();
                            window.location.href = response.redirectUrl || currentReturnUrl;
                            return;
                        }

                        modalBody.innerHTML = response;
                        $.validator.unobtrusive.parse(modalBody);
                    },
                    error: function (xhr) {
                        modalBody.innerHTML = xhr.responseText || 'Erreur serveur';
                        $.validator.unobtrusive.parse(modalBody);
                    }
                });
            });
        })();

        function deleteItem(controller, id, name) {
            if (!confirm(`Êtes-vous sûr de vouloir supprimer "${name}" ?`)) {
                return;
            }

            const token = document.querySelector('#bases-list-container input[name="__RequestVerificationToken"]')?.value;
            $.ajax({
                url: `/Settings/${controller}/Delete/${id}`,
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function () {
                    showMessage('Supprimé avec succès', 'success');
                    window.location.reload();
                },
                error: function () {
                    showMessage('Erreur lors de la suppression', 'error');
                }
            });
        }

        function showMessage(message, type) {
            if (window.toastr) {
                toastr[type](message);
                return;
            }
            alert(message);
        }
    </script>
}
