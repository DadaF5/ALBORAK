@{
    ViewData["Title"] = "Paramètres";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">⚙️ Paramètres du Système</h3>
                </div>
                <div class="card-body">
                    <!-- Navigation Tabs -->
                    <div class="btn-group mb-3" role="group">
                        <button type="button" class="btn btn-outline-primary settings-tab active" data-controller="Base">
                            🏢 Bases Aériennes
                        </button>
                        <button type="button" class="btn btn-outline-primary settings-tab" data-controller="AircraftManufacturers">
                            🏭 Constructeurs
                        </button>
                        <button type="button" class="btn btn-outline-primary settings-tab" data-controller="AircraftVersions">
                            ✈️ Versions d'Aéronefs
                        </button>
                        <button type="button" class="btn btn-outline-primary settings-tab" data-controller="AircraftTypes">
                            🛩️ Types d'Aéronefs
                        </button>
                        <button type="button" class="btn btn-outline-primary settings-tab" data-controller="Positions">
                            📍 Positions
                        </button>
                    </div>

                    <hr>

                    <!-- Dynamic Content Container -->
                    <div id="settingsContent">
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-spinner fa-spin fa-3x mb-3"></i>
                            <p>Chargement...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-load first tab
            loadList('Base');

            // Handle tab clicks
            $('.settings-tab').on('click', function() {
                const controller = $(this).data('controller');

                // Update active tab
                $('.settings-tab').removeClass('active');
                $(this).addClass('active');

                // Load list
                loadList(controller);
            });
        });

        // Load list for a controller
        function loadList(controller) {
            $('#settingsContent').html('<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');

            // Direct call to controller's List action
            const url = `/Settings/${controller}/List`;

            $.ajax({
                url: url,
                type: 'GET',
                success: function(response) {
                    $('#settingsContent').html(response);
                },
                error: function(xhr) {
                    let errorMsg = '<div class="alert alert-danger">' +
                                  '<i class="fas fa-exclamation-triangle"></i> Erreur de chargement';

                    if (xhr.status === 404) {
                        errorMsg += ' - Controller ou action introuvable';
                    } else if (xhr.responseText) {
                        errorMsg += ': ' + xhr.responseText;
                    }

                    errorMsg += '</div>';
                    $('#settingsContent').html(errorMsg);
                }
            });
        }

        // Delete item (called from partial views)
        function deleteItem(controller, id, name) {
            if (confirm(`Êtes-vous sûr de vouloir supprimer "${name}" ?`)) {
                $.ajax({
                    url: `/Settings/${controller}/Delete/${id}`,
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        toastr.success('Supprimé avec succès');
                        loadList(controller);
                    },
                    error: function(xhr) {
                        toastr.error('Erreur lors de la suppression');
                    }
                });
            }
        }
    </script>
}

