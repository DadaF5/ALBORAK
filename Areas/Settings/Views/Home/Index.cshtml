@model FRAProject.Areas.Settings.ViewModels.SettingsDashboardVm
@{
    ViewData["Title"] = "Paramètres — Tableau de bord";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

@* ══════════════════════════════════════════════════════════════════
   SETTINGS DASHBOARD — Lookup tables health overview
   ══════════════════════════════════════════════════════════════════ *@

<style>
    /* ── Dashboard-specific styles ─────────────────────────────── */
    .db-header {
        border-bottom: 1px solid #1e2230;
        padding-bottom: 16px;
        margin-bottom: 28px;
    }
    .db-title {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 4px;
    }
    .db-heading {
        font-size: 22px;
        font-weight: 700;
        color: #e2e8f0;
        margin: 0;
    }
    .db-timestamp {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 10px;
        color: #475569;
        margin-top: 4px;
    }

    /* ── Grand total strip ──────────────────────────────────────── */
    .totals-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 28px;
    }
    .total-cell {
        background: #111318;
        border: 1px solid #1e2230;
        border-radius: 8px;
        padding: 14px 20px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .total-cell.accent { border-color: #c9a84c; }
    .total-n {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 28px;
        font-weight: 700;
        color: #c9a84c;
        line-height: 1;
    }
    .total-l {
        font-size: 10px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ── Section header ─────────────────────────────────────────── */
    .section-hdr {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        margin-top: 8px;
    }
    .section-label {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #475569;
    }
    .section-line {
        flex: 1;
        height: 1px;
        background: #1e2230;
    }

    /* ── Lookup card ────────────────────────────────────────────── */
    .lookup-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 10px;
        margin-bottom: 20px;
    }
    .lookup-card {
        background: #111318;
        border: 1px solid #1e2230;
        border-radius: 8px;
        padding: 14px 16px;
        text-decoration: none;
        display: block;
        transition: border-color .15s, background .15s;
        position: relative;
        overflow: hidden;
    }
    .lookup-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 3px; height: 100%;
        background: #1e2230;
        transition: background .15s;
    }
    .lookup-card:hover {
        border-color: #c9a84c;
        background: rgba(201,168,76,.04);
        text-decoration: none;
    }
    .lookup-card:hover::before { background: #c9a84c; }

    .lc-icon {
        font-size: 11px;
        color: #475569;
        margin-bottom: 8px;
    }
    .lc-title {
        font-size: 12px;
        font-weight: 600;
        color: #cbd5e1;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .lc-counts {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 8px;
    }
    .lc-total {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 22px;
        font-weight: 700;
        color: #e2e8f0;
        line-height: 1;
    }
    .lc-active {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 10px;
        color: #64748b;
        text-align: right;
    }
    .lc-active span { display: block; }
    .lc-active .act { color: #22c55e; }
    .lc-active .ina { color: #ef4444; }

    /* ── Health bar ─────────────────────────────────────────────── */
    .health-bar-bg {
        height: 3px;
        background: #1e2230;
        border-radius: 2px;
        overflow: hidden;
    }
    .health-bar-fill {
        height: 100%;
        border-radius: 2px;
        transition: width .4s ease;
    }
    .hb-success { background: #22c55e; }
    .hb-warning { background: #f59e0b; }
    .hb-orange  { background: #f97316; }
    .hb-danger  { background: #ef4444; }

    /* ── Empty state ────────────────────────────────────────────── */
    .lc-empty {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 10px;
        color: #334155;
        margin-top: 2px;
    }

    /* ── Action link ────────────────────────────────────────────── */
    .lc-action {
        position: absolute;
        top: 12px; right: 12px;
        font-size: 9px;
        color: #334155;
        transition: color .15s;
    }
    .lookup-card:hover .lc-action { color: #c9a84c; }
</style>

@* ── Header ────────────────────────────────────────────────────── *@
<div class="db-header">
    <div class="db-title">2BAFRA · GMAO FRA · Settings</div>
    <h1 class="db-heading">Tableau de bord — Paramètres</h1>
    <div class="db-timestamp" id="ts">—</div>
</div>

@* ── Grand totals strip ───────────────────────────────────────── *@
<div class="totals-strip">
    <div class="total-cell accent">
        <div class="total-n">@Model.TotalTables</div>
        <div class="total-l">Tables lookup</div>
    </div>
    <div class="total-cell">
        <div class="total-n">@Model.TotalRecords</div>
        <div class="total-l">Enregistrements total</div>
    </div>
    <div class="total-cell">
        <div class="total-n" style="color:#22c55e;">@Model.TotalActive</div>
        <div class="total-l">Actifs</div>
    </div>
    <div class="total-cell">
        <div class="total-n" style="color:#ef4444;">@Model.TotalInactive</div>
        <div class="total-l">Inactifs</div>
    </div>
</div>

@* ── SECTION: Données de base ─────────────────────────────────── *@
<div class="section-hdr">
    <span class="section-label">Données de base</span>
    <div class="section-line"></div>
    <span class="section-label">@Model.DonneesDeBase.Count tables</span>
</div>

@* <div class="lookup-grid">
