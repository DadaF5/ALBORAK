@model FRAProject.Areas.Settings.ViewModels.ImmatriculationDocTypeFormDto
@{
    ViewData["Title"] = $"Modifier — {Model.Code}";
    Layout = "~/Areas/Settings/Views/Shared/_SettingsLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">
            Modifier le type de document
            <code class="text-warning ms-2" style="font-size:18px;">@Model.Code</code>
        </h4>
        <small class="text-muted">
            <a asp-action="Index" class="text-muted text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i>Retour à la liste
            </a>
        </small>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.ArticleReference != null)
        {
            <span class="badge bg-warning text-dark">@Model.ArticleReference</span>
        }
        @if (!Model.IsActive)
        {
            <span class="badge bg-secondary fs-6">Inactif</span>
        }
    </div>
</div>

@* Regulatory warning on edit ──────────────────────────────────── *@
<div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-3">
    <i class="fas fa-exclamation-triangle"></i>
    <small>
        Ce type est défini par la réglementation DAM (GUI-DPC-001).
        Modifier uniquement si une révision réglementaire le justifie.
    </small>
</div>

<div class="card border-secondary">
    <div class="card-header bg-dark border-secondary">
        <h6 class="mb-0 text-muted">
            <i class="fas fa-file-alt me-2"></i>Informations du type de document
        </h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            @await Html.PartialAsync("_Form", Model)
            <hr class="border-secondary mt-4" />
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (Model.IsActive)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                onclick="quickToggle(@Model.Id, false, '@Model.Code')">
                            <i class="fas fa-ban me-1"></i>Désactiver
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-success btn-sm"
                                onclick="quickToggle(@Model.Id, true, '@Model.Code')">
                            <i class="fas fa-check me-1"></i>Réactiver
                        </button>
                    }
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Enregistrer
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value;

        function quickToggle(id, activate, code) {
            const action = activate ? 'Activate' : 'Delete';
            const msg    = activate
                ? `Réactiver le type « ${code} » ?`
                : `Désactiver le type « ${code} » ?\n\nAttention : type réglementaire DAM.`;

            if (!confirm(msg)) return;

            fetch(`/Settings/ImmatriculationDocType/${action}/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Settings/ImmatriculationDocType';
                } else {
                    alert(data.message ?? 'Une erreur est survenue.');
                }
            })
            .catch(() => alert('Erreur réseau.'));
        }
    </script>
}
