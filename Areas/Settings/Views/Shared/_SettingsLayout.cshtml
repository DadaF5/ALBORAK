<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 2BAFRA Paramètres</title>

    <!-- AdminLTE CSS -->
    <link rel="stylesheet" href="~/css/adminlte.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <!-- Toastr -->
    <link rel="stylesheet" href="~/plugins/toastr/toastr.min.css" />
    <!-- Custom -->
    <link rel="stylesheet" href="~/css/gmao_fra.css" />

    @RenderSection("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed dark-mode">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-dark">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="~/" class="nav-link">🏠 Accueil</a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-area="Settings" asp-controller="Home" asp-action="Index" class="nav-link active">
                        ⚙️ Paramètres
                    </a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="~/" class="brand-link">
                <img src="~/img/logo.png" alt="2BAFRA Logo" class="brand-image img-circle elevation-3" style="opacity: .8" onerror="this.style.display='none'">
                <span class="brand-text font-weight-light">2BAFRA</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                        
                        <!-- Settings Section -->
                        <li class="nav-header">PARAMÈTRES SYSTÈME</li>
                        
                        <li class="nav-item">
                            <a asp-area="Settings" asp-controller="Home" asp-action="Index" class="nav-link active">
                                <i class="nav-icon fas fa-cog"></i>
                                <p>Tableau de Bord</p>
                            </a>
                        </li>

                        <li class="nav-header">DONNÉES DE BASE</li>
                        
                        <li class="nav-item">
                            <a href="#" onclick="loadList('Base'); return false;" class="nav-link">
                                <i class="nav-icon fas fa-map-marked-alt"></i>
                                <p>Bases Aériennes</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" onclick="loadList('AircraftManufacturers'); return false;" class="nav-link">
                                <i class="nav-icon fas fa-industry"></i>
                                <p>Constructeurs</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" onclick="loadList('AircraftTypes'); return false;" class="nav-link">
                                <i class="nav-icon fas fa-plane"></i>
                                <p>Types d'Aéronefs</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" onclick="loadList('AircraftVersions'); return false;" class="nav-link">
                                <i class="nav-icon fas fa-fighter-jet"></i>
                                <p>Versions d'Aéronefs</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" onclick="loadList('Positions'); return false;" class="nav-link">
                                <i class="nav-icon fas fa-sitemap"></i>
                                <p>Positions</p>
                            </a>
                        </li>

                        <li class="nav-header">NAVIGATION</li>
                        
                        <li class="nav-item">
                            <a href="~/" class="nav-link">
                                <i class="nav-icon fas fa-home"></i>
                                <p>Retour à l'Accueil</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="~/">Accueil</a></li>
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                            <i class="icon fas fa-check"></i> @TempData["SuccessMessage"]
                        </div>
                    }
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                            <i class="icon fas fa-ban"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Copyright &copy; 2024-@DateTime.Now.Year <a href="#">2BAFRA</a>.</strong>
            Tous droits réservés.
            <div class="float-right d-none d-sm-inline-block">
                <b>Version</b> 1.0.0
            </div>
        </footer>
    </div>

    <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/plugins/bootstrap/js/bootstrap.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/lib/dist/js/adminlte.min.js"></script>
    <!-- Toastr -->
    <script src="~/plugins/toastr/toastr.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
