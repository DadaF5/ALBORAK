@using FRAProject.Areas.SquadronOps.Models
@model CrewMemberQualification

@{
    ViewData["Title"] = "Edit Qualification";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var crewMemberName = ViewData["CrewMemberName"] as string;
    var qualificationName = ViewData["QualificationName"] as string;
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="CrewMembers" asp-action="Index">Crew Members</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-route-crewMemberId="@Model.CrewMemberId">@crewMemberName</a></li>
                    <li class="breadcrumb-item active">Edit @qualificationName</li>
                </ol>
            </nav>

            <h1>Edit Qualification for @crewMemberName</h1>
            <p class="lead">@qualificationName</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CrewMemberId" />
                <input type="hidden" asp-for="QualificationId" />

                <div class="card mb-4">
                    <div class="card-header">Qualification Details</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Qualification</label>
                            <input type="text" class="form-control-plaintext" value="@qualificationName" readonly />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ValidFrom" class="form-label">Valid From</label>
                                    <input asp-for="ValidFrom" type="date" class="form-control" />
                                    <span asp-validation-for="ValidFrom" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ValidUntil" class="form-label">Valid Until (Optional)</label>
                                    <input asp-for="ValidUntil" type="date" class="form-control" />
                                    <span asp-validation-for="ValidUntil" class="text-danger"></span>
                                    <small class="text-muted">Leave empty if qualification doesn't expire</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IssuedBy" class="form-label">Issued By</label>
                            <input asp-for="IssuedBy" class="form-control" maxlength="100" />
                            <span asp-validation-for="IssuedBy" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remarks" class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" maxlength="255"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-control" asp-items="ViewBag.Status"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <a asp-action="Index" asp-route-crewMemberId="@Model.CrewMemberId" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
