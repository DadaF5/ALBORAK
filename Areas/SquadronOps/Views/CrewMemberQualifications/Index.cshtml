@using FRAProject.Areas.SquadronOps.Models
@model IEnumerable<CrewMemberQualification>

@{
    ViewData["Title"] = "Crew Member Qualifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var crewMemberId = ViewData["CrewMemberId"] as int?;
    var crewMemberName = ViewData["CrewMemberName"] as string;
    var squadron = ViewData["Squadron"] as string;
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="CrewMembers" asp-action="Index">Crew Members</a></li>
                    <li class="breadcrumb-item active">Qualifications for @crewMemberName</li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center">
                <h2>Qualifications for @crewMemberName</h2>
                <div>
                    <a asp-action="Create" asp-route-crewMemberId="@crewMemberId" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add New Qualification
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(squadron))
            {
                <p class="text-muted">Squadron: @squadron</p>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No qualifications found for this crew member. 
            <a asp-action="Create" asp-route-crewMemberId="@crewMemberId">Add the first qualification</a>.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Qualification</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Valid From</th>
                                <th>Valid Until</th>
                                <th>Issued By</th>
                                <th>Remarks</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.IsCurrent ? "table-success" : "table-warning")">
                                    <td>
                                        <strong>@item.Qualification?.Name</strong>
                                        @if (ViewBag.PrimaryQualificationId == item.QualificationId)
                                        {
                                            <span class="badge bg-primary ms-2">Primary</span>
                                        }
                                    </td>
                                    <td>@item.Qualification?.QualificationType</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(item.Status)">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.ValidFrom?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.ValidUntil.HasValue)
                                        {
                                            <span class="@(item.ValidUntil.Value.Date < DateTime.Today ? "text-danger" : "")">
                                                @item.ValidUntil.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>@item.IssuedBy</td>
                                    <td>@item.Remarks</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                            class="btn btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                            @if (item.Status == "Active" && ViewBag.PrimaryQualificationId != item.QualificationId)
                                            {
                                                <a asp-action="SetAsPrimary" asp-route-id="@item.Id" class="btn btn-outline-info" 
                                                title="Set as Primary">
                                                    <i class="fas fa-star"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Active" => "bg-success",
            "Expired" => "bg-secondary",
            "Suspended" => "bg-warning",
            "Revoked" => "bg-danger",
            _ => "bg-info"
        };
    }
}
