@using FRAProject.Areas.SquadronOps.Models
@model CrewMember

@{
    ViewData["Title"] = "Create Crew Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">
    <!-- Compact Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h1 class="h3 mb-1">Create New Crew Member</h1>
                    <p class="text-muted small mb-0">Add a new crew member to the system</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i>Back to List
                    </a>
                </div>
            </div>

            <!-- Information Alert -->
            <div class="alert alert-info small py-1 px-2 mb-0">
                <i class="fas fa-info-circle mr-1"></i>
                Please provide either a photo URL or upload an image file. Each person can be assigned to at most one crew member.
            </div>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card border">
                <div class="card-header bg-light py-2 px-3">
                    <h6 class="mb-0 font-weight-bold">
                        <i class="fas fa-user-plus mr-1"></i>Crew Member Information
                    </h6>
                </div>

                <form asp-action="Create" method="post" class="form-horizontal" id="crew-member-form" enctype="multipart/form-data">
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_CrewMemberFormPartial", Model)
                    </div>

                    <!-- Form Footer -->
                    <div class="card-footer bg-white py-2 px-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-times mr-1"></i>Cancel
                                </a>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="fas fa-plus-circle mr-1"></i>Create Crew Member
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Instructions/Help -->
    <div class="row mt-2">
        <div class="col-12">
            <div class="card border-light">
                <div class="card-body py-1 px-3">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">
                                <i class="fas fa-lightbulb mr-1"></i>
                                Required fields are marked with *
                            </small>
                        </div>
                        <div class="col-md-6 text-md-right">
                            <small class="text-muted">
                                <i class="fas fa-clock mr-1"></i>
                                Created: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .container-fluid {
            padding-left: 20px;
            padding-right: 20px;
        }

        .form-control-sm, .custom-file-sm .custom-file-label {
            font-size: 0.875rem;
            padding: 0.25rem 0.5rem;
            height: calc(1.8125rem + 2px);
        }

            .custom-file-sm .custom-file-label::after {
                padding: 0.25rem 0.5rem;
                font-size: 0.875rem;
                height: calc(1.8125rem + 2px);
                line-height: 1.5;
            }

        .col-form-label-sm {
            padding-top: calc(0.25rem + 1px);
            padding-bottom: calc(0.25rem + 1px);
            font-size: 0.875rem;
            font-weight: 500;
        }

        .btn-sm {
            padding: 0.25rem 0.75rem;
            font-size: 0.875rem;
        }

        .card-header {
            padding: 0.5rem 1rem;
        }

        .card-body {
            padding: 1rem;
        }

        .card-footer {
            padding: 0.75rem 1rem;
        }

        hr {
            margin: 0.5rem 0;
        }

        .alert {
            margin-bottom: 0.5rem;
            padding: 0.25rem 0.75rem;
            font-size: 0.875rem;
        }

        /* Ensure form groups are compact */
        .form-group.row {
            margin-bottom: 0.5rem;
        }

        /* Make checkboxes align properly */
        .custom-control {
            min-height: 1.3125rem;
            padding-left: 1.5rem;
        }

        .custom-control-label {
            padding-top: 0.125rem;
            font-size: 0.875rem;
        }

        .custom-control-input {
            width: 1rem;
            height: 1rem;
            margin-top: 0.125rem;
        }

        /* Photo preview styling */
        .img-thumbnail {
            padding: 0.125rem;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .container-fluid {
                padding-left: 10px;
                padding-right: 10px;
            }

            .col-form-label-sm {
                text-align: left !important;
                padding-bottom: 0.125rem;
            }

            .form-group.row > .col-sm-8 {
                padding-left: 15px;
            }
        }

        /* Required field indicator */
        .field-required::after {
            content: " *";
            color: #dc3545;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Add Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <script>
        // Photo preview functionality
        function clearPhoto() {
            const photoPreview = document.getElementById('photoPreview');
            const photoPlaceholder = document.getElementById('photoPlaceholder');
            const photoUrlInput = document.getElementById('photoUrlInput');
            const photoFileInput = document.getElementById('photoFileInput');
            const photoFileLabel = document.getElementById('photoFileLabel');

            if (photoPreview) {
                photoPreview.style.display = 'none';
                photoPreview.src = '';
            }
            if (photoPlaceholder) {
                photoPlaceholder.style.display = 'block';
            }
            if (photoUrlInput) {
                photoUrlInput.value = '';
            }
            if (photoFileInput) {
                photoFileInput.value = '';
            }
            if (photoFileLabel) {
                photoFileLabel.innerText = 'Choose file';
            }
        }

        // Initialize photo preview on page load
        document.addEventListener('DOMContentLoaded', function() {
            const photoUrlInput = document.getElementById('photoUrlInput');
            const photoFileInput = document.getElementById('photoFileInput');
            const photoFileLabel = document.getElementById('photoFileLabel');
            const photoPreview = document.getElementById('photoPreview');
            const photoPlaceholder = document.getElementById('photoPlaceholder');

            // Initialize file input label
            if (photoFileInput && photoFileLabel) {
                // Update file input label
                photoFileInput.addEventListener('change', function(e) {
                    var fileName = e.target.files[0] ? e.target.files[0].name : 'Choose file';
                    photoFileLabel.innerText = fileName;

                    // Preview the image
                    if (e.target.files && e.target.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            if (photoPreview) {
                                photoPreview.src = e.target.result;
                                photoPreview.style.display = 'block';
                            }
                            if (photoPlaceholder) {
                                photoPlaceholder.style.display = 'none';
                            }
                        };
                        reader.readAsDataURL(e.target.files[0]);
                    }
                });
            }

            // Handle URL input changes with debouncing
            let urlTimer;
            if (photoUrlInput) {
                photoUrlInput.addEventListener('input', function() {
                    clearTimeout(urlTimer);
                    urlTimer = setTimeout(() => {
                        const url = photoUrlInput.value.trim();
                        if (url) {
                            // Clear file input if URL is entered
                            if (photoFileInput) {
                                photoFileInput.value = '';
                                if (photoFileLabel) {
                                    photoFileLabel.innerText = 'Choose file';
                                }
                            }

                            // Try to load the URL image
                            if (photoPreview) {
                                photoPreview.src = url;
                                photoPreview.onload = function() {
                                    photoPreview.style.display = 'block';
                                    if (photoPlaceholder) {
                                        photoPlaceholder.style.display = 'none';
                                    }
                                };
                                photoPreview.onerror = function() {
                                    // If URL fails, keep placeholder
                                    photoPreview.style.display = 'none';
                                    if (photoPlaceholder) {
                                        photoPlaceholder.style.display = 'block';
                                    }
                                };
                            }
                        } else {
                            if (photoPreview) {
                                photoPreview.style.display = 'none';
                            }
                            if (photoPlaceholder) {
                                photoPlaceholder.style.display = 'block';
                            }
                        }
                    }, 500);
                });
            }

            // Form submission loading state and validation
            const form = document.getElementById('crew-member-form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    // Check if either photo URL or file is provided (as per controller validation)
                    const photoUrl = photoUrlInput ? photoUrlInput.value.trim() : '';
                    const hasPhotoFile = photoFileInput && photoFileInput.files.length > 0;

                    if (!photoUrl && !hasPhotoFile) {
                        e.preventDefault();
                        alert('Please provide a photo (either upload an image or enter an image URL).');
                        return;
                    }

                    const submitButton = this.querySelector('button[type="submit"]');
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Creating...';
                    }
                });
            }

            // Enhance validation feedback
            if (form) {
                const inputs = form.querySelectorAll('.form-control');
                inputs.forEach(input => {
                    input.addEventListener('blur', function() {
                        if (this.classList.contains('input-validation-error')) {
                            this.classList.add('is-invalid');
                        } else {
                            this.classList.remove('is-invalid');
                        }
                    });
                });
            }

            // Add required field indicators
            const requiredFields = ['SequenceNo', 'NickName', 'PersonId', 'SquadronId', 'CrewMemberType', 'Status'];
            requiredFields.forEach(fieldName => {
                const label = document.querySelector(`label[for="${fieldName}"]`);
                if (label) {
                    label.classList.add('field-required');
                }
            });
        });
    </script>
}