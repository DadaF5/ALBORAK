@using FRAProject.Areas.SquadronOps.Models
@model CrewMember

@{
    ViewData["Title"] = "Delete Crew Member";
}

<h2>Delete Crew Member</h2>

<h4>Confirm delete</h4>

<div>
    <dl class="row">
        <dt class="col-sm-3">NickName</dt>
        <dd class="col-sm-9">@Model.NickName</dd>

        <dt class="col-sm-3">Person</dt>
        <dd class="col-sm-9">@((Model.Person != null) ? (Model.Person.FirstName + " " + Model.Person.LastName) : "—")</dd>

        <dt class="col-sm-3">Squadron</dt>
        <dd class="col-sm-9">@Model.Squadron?.Name</dd>

        <dt class="col-sm-3">Primary Qualification</dt>
        <dd class="col-sm-9">@Model.PrimaryQualification?.Name</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
