@using FRAProject.Areas.SquadronOps.Models
@model IEnumerable<Mission>

@{
    ViewData["Title"] = "Missions";
}

<h2 class="mb-3">Missions</h2>

<p>
    <a asp-action="Create" class="btn btn-sm btn-primary">Create Mission</a>
</p>

<table class="table table-bordered table-sm">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Phase</th>
            <th>Scope</th>
            <th style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No missions found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Code</td>
                    <td>@item.Phase?.Name</td>
                    <td>
                        @if (item.SquadronId == null)
                        {
                            <span class="badge bg-secondary">Global</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Squadron</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                        <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Deactivate this mission?');">
                                Deactivate
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

