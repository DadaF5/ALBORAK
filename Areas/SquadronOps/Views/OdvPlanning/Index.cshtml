@model FRAProject.Areas.SquadronOps.ViewModels.OdvIndexVm
@using FRAProject.Areas.SquadronOps.Models

@{
    ViewData["Title"] = "Programme de vol";

    // Local helpers — status → (Bootstrap badge class, French label).
    // OdvStatus only has Planned/Cancelled referenced anywhere seen this
    // session (Enums.OdvStatus) — default label falls back to ToString()
    // for any other value so nothing throws if more are added later.
    (string css, string label) OdvBadge(FRAProject.Enums.OdvStatus? status) => status switch
    {
        FRAProject.Enums.OdvStatus.Cancelled => ("bg-danger", "Annulé"),
        FRAProject.Enums.OdvStatus.Planned => ("bg-secondary", "Planifié"),
        null => ("bg-secondary", "—"),
        _ => ("bg-secondary", status.ToString() ?? "—")
    };

    (string css, string label) SortieBadge(SortieStatus status) => status switch
    {
        SortieStatus.Planned => ("bg-secondary", "Planifiée"),
        SortieStatus.AircraftAssigned => ("bg-info text-dark", "Avion assigné"),
        SortieStatus.Airborne => ("bg-primary", "En vol"),
        SortieStatus.Landed => ("bg-primary", "Atterrie"),
        SortieStatus.CrewChiefReported => ("bg-warning text-dark", "Compte-rendu CrewChief"),
        SortieStatus.Finalized => ("bg-success", "Clôturée"),
        SortieStatus.Canceled => ("bg-danger", "Annulée"),
        _ => ("bg-secondary", status.ToString())
    };

    var prevDate = Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDate = Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd");
    var todayDate = DateTime.Today.ToString("yyyy-MM-dd");
}

@*
    NEW (Batch 13, 2026-08-30) — the real "Programme de vol" operational
    board. First real content wired into _SquadronOpsLayout.cshtml
    (Batch 10's shell, approved but empty until now).

    Grounded in the real OdvPlanningController.Index/Create/Edit/Cancel
    actions and OdvIndexVm/OdvCreateVm/Odv.cs/Sortie.cs — every field and
    route below matches those exactly.

    ONE deliberate scope cut, flagged rather than guessed: no crew
    assignment UI here. The Batch 10 layout comment says Sorties/
    SortieCrews are meant to be worked "from within that board... via a
    crew-assignment modal", but no SortieCrewsController has been sent
    this session — building that blind risks a modal that posts to a
    route/shape that doesn't exist. Each sortie row below shows assigned
    crew count only (if any); a real "Assign crew" action needs that
    controller's real file first. Everything else in the workflow —
    Create ODV, Edit ODV, Cancel ODV, Add Sortie, AssignAircraft,
    RecordDeparture, RecordArrival, RecordPostFlight, Finalize, Cancel
    Sortie — is wired for real, using each action's confirmed real route.

    Finalize has NO GET action in SortiesController (only POST) — it was
    clearly meant to be submitted right from this board, not a separate
    page. Built as a single shared Bootstrap modal below, populated via a
    small vanilla-JS onclick handler (matches the no-library-dependency
    pattern already used in RecordPostFlight.cshtml's snag-block toggle).
*@

<h1>Programme de vol</h1>
<p class="text-muted">Tableau opérationnel — ODVs et sorties du jour.</p>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-odvDate="@prevDate" title="Jour précédent">&laquo;</a>
        <input type="date" name="odvDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control" style="max-width:180px;" onchange="this.form.submit()" />
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-odvDate="@nextDate" title="Jour suivant">&raquo;</a>
        <a class="btn btn-outline-primary" asp-action="Index" asp-route-odvDate="@todayDate">Aujourd'hui</a>
    </form>

    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createOdvPanel">
        + Nouvel ODV
    </button>
</div>

<div class="collapse" id="createOdvPanel">
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Nouvel ODV — @Model.SelectedDate.ToString("dd/MM/yyyy")</h5>
            @*
                Create's controller action returns BadRequest(JSON) on
                validation failure and Redirect on success (confirmed from
                the real OdvPlanningController.Create) — NOT View(model) —
                so this form is submitted via AJAX (see Scripts) rather
                than a plain POST, otherwise a validation failure would
                just show raw JSON in the browser.
            *@
            <div class="text-danger mb-2" data-ajax-errors></div>
            <form asp-controller="OdvPlanning" asp-action="Create" method="post" data-ajax="true">
                <input type="hidden" asp-for="CreateModel.OdvDate" />
                <div class="row">
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.SquadronId" class="form-label"></label>
                        <select asp-for="CreateModel.SquadronId" asp-items="Model.Squadrons" class="form-select">
                            <option value="">-- Escadron --</option>
                        </select>
                        <span asp-validation-for="CreateModel.SquadronId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.AcMainGroupId" class="form-label"></label>
                        <select asp-for="CreateModel.AcMainGroupId" asp-items="Model.AcMainGroups" class="form-select">
                            <option value="">-- Groupe avion --</option>
                        </select>
                        <span asp-validation-for="CreateModel.AcMainGroupId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.MissionId" class="form-label"></label>
                        <select asp-for="CreateModel.MissionId" asp-items="Model.Missions" class="form-select">
                            <option value="">-- Mission --</option>
                        </select>
                        <span asp-validation-for="CreateModel.MissionId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.CallSignId" class="form-label"></label>
                        <select asp-for="CreateModel.CallSignId" asp-items="Model.CallSigns" class="form-select">
                            <option value="">-- Indicatif --</option>
                        </select>
                        <span asp-validation-for="CreateModel.CallSignId" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.Zone" class="form-label"></label>
                        <select asp-for="CreateModel.Zone" asp-items="Model.ZoneList" class="form-select"></select>
                        <span asp-validation-for="CreateModel.Zone" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.MissionType" class="form-label"></label>
                        <select asp-for="CreateModel.MissionType" asp-items="Model.MissionTypeList" class="form-select"></select>
                        <span asp-validation-for="CreateModel.MissionType" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.TOFF" class="form-label"></label>
                        <input asp-for="CreateModel.TOFF" class="form-control" placeholder="hh:mm" />
                        <span asp-validation-for="CreateModel.TOFF" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label asp-for="CreateModel.Area" class="form-label"></label>
                        <input asp-for="CreateModel.Area" class="form-control" />
                        <span asp-validation-for="CreateModel.Area" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 form-group mb-3">
                        <label asp-for="CreateModel.Obs" class="form-label"></label>
                        <textarea asp-for="CreateModel.Obs" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Créer l'ODV</button>
                <button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#createOdvPanel">Annuler</button>
            </form>
        </div>
    </div>
</div>

@if (Model.Odvs == null || !Model.Odvs.Any())
{
    <div class="alert alert-info">Aucun ODV pour cette date.</div>
}
else
{
    foreach (var odv in Model.Odvs)
    {
        var (odvCss, odvLabel) = OdvBadge(odv.OdvStatus);
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <strong>@(odv.Squadron?.Name ?? "—")</strong>
                    &nbsp;|&nbsp; @(odv.CallSign?.Code ?? "—")
                    &nbsp;|&nbsp; TOFF @(odv.TOFF?.ToString(@"hh\:mm") ?? "—")
                    &nbsp;|&nbsp; @(odv.Mission?.Name ?? "—")
                    &nbsp;|&nbsp; @odv.Zone &nbsp;/&nbsp; @odv.MissionType
                    <span class="badge @odvCss ms-2">@odvLabel</span>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Sorties" asp-action="Create" asp-route-odvId="@odv.Id">
                        + Ajouter une sortie
                    </a>
                    @if (odv.OdvStatus !=  FRAProject.Enums.OdvStatus.Cancelled)
                    {
                        <a class="btn btn-sm btn-outline-secondary"
                           asp-action="Edit" asp-route-id="@odv.Id" asp-route-odvDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">
                            Modifier
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#cancelOdvModal"
                                data-odv-id="@odv.Id">
                            Annuler l'ODV
                        </button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(odv.Obs))
            {
                <div class="card-body py-2 border-bottom">
                    <small class="text-muted">Obs: @odv.Obs</small>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Sortie</th>
                            <th>Type</th>
                            <th>Avion</th>
                            <th>TOFF réel</th>
                            <th>Atterrissage réel</th>
                            <th>Équipage</th>
                            <th>Statut</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (odv.Sorties == null || !odv.Sorties.Any())
                        {
                            <tr><td colspan="8" class="text-muted">Aucune sortie.</td></tr>
                        }
                        else
                        {
                            foreach (var sortie in odv.Sorties.OrderBy(s => s.Sequence))
                            {
                                var (sCss, sLabel) = SortieBadge(sortie.Status);
                                <tr>
                                    <td>@sortie.SortieCode</td>
                                    <td>@(sortie.AcType?.Name ?? "—")</td>
                                    <td>@(sortie.Aircraft?.Registration ?? "—")</td>
                                    <td>@(sortie.RealTOFF?.ToString("HH:mm") ?? "—")</td>
                                    <td>@(sortie.RealLandingTime?.ToString("HH:mm") ?? "—")</td>
                                    <td>@(sortie.SortieCrews?.Count ?? 0)</td>
                                    <td><span class="badge @sCss">@sLabel</span></td>
                                    <td class="d-flex flex-wrap gap-1">
                                        @switch (sortie.Status)
                                        {
                                            case SortieStatus.Planned:
                                                <a class="btn btn-sm btn-primary" asp-controller="Sorties" asp-action="Edit" asp-route-id="@sortie.Id">Modifier</a>
                                                <a class="btn btn-sm btn-primary" asp-controller="Sorties" asp-action="AssignAircraft" asp-route-id="@sortie.Id">Assigner avion</a>
                                                break;
                                            case SortieStatus.AircraftAssigned:
                                                <a class="btn btn-sm btn-primary" asp-controller="Sorties" asp-action="RecordDeparture" asp-route-id="@sortie.Id">Départ (ATC)</a>
                                                break;
                                            case SortieStatus.Airborne:
                                                <a class="btn btn-sm btn-primary" asp-controller="Sorties" asp-action="RecordArrival" asp-route-id="@sortie.Id">Arrivée (ATC)</a>
                                                break;
                                            case SortieStatus.Landed:
                                                <a class="btn btn-sm btn-primary" asp-controller="Sorties" asp-action="RecordPostFlight" asp-route-id="@sortie.Id">Post-vol (CrewChief)</a>
                                                break;
                                            case SortieStatus.CrewChiefReported:
                                                <button type="button" class="btn btn-sm btn-success"
                                                        data-bs-toggle="modal" data-bs-target="#finalizeModal"
                                                        data-sortie-id="@sortie.Id"
                                                        data-sortie-code="@sortie.SortieCode">
                                                    Clôturer (Squadron)
                                                </button>
                                                break;
                                            case SortieStatus.Finalized:
                                                <span class="text-muted">Clôturée @(sortie.FinalizedAtUtc?.ToString("dd/MM HH:mm"))</span>
                                                break;
                                            case SortieStatus.Canceled:
                                                <span class="text-muted">@sortie.CancellationReason</span>
                                                break;
                                        }
                                        @if (sortie.Status != SortieStatus.Finalized && sortie.Status != SortieStatus.Canceled)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#cancelSortieModal"
                                                    data-sortie-id="@sortie.Id">
                                                Annuler
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* ============================= MODALS ============================= *@

<div class="modal fade" id="cancelOdvModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-controller="OdvPlanning" asp-action="Cancel" method="post" class="modal-content" data-ajax="true">
            <input type="hidden" name="id" id="cancelOdvId" />
            <input type="hidden" name="odvDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
            <div class="modal-header">
                <h5 class="modal-title">Annuler l'ODV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Toutes les sorties non clôturées de cet ODV seront également annulées.</p>
                <div class="text-danger mb-2" data-ajax-errors></div>
                <label class="form-label">Motif</label>
                <textarea name="reason" class="form-control" rows="2"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="cancelSortieModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-controller="Sorties" asp-action="Cancel" method="post" class="modal-content" data-ajax="true">
            <input type="hidden" name="id" id="cancelSortieId" />
            <div class="modal-header">
                <h5 class="modal-title">Annuler la sortie</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-danger mb-2" data-ajax-errors></div>
                <label class="form-label">Motif</label>
                <textarea name="reason" class="form-control" rows="2"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
            </div>
        </form>
    </div>
</div>

@* Finalize — SortieFinalizeVm has no GET-backed view anywhere in
   SortiesController (POST-only action), so this is the page it's
   submitted from, per Dadda's original "...at squadron => mission
   closed" sequence happening from the ops board itself. *@
<div class="modal fade" id="finalizeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-controller="Sorties" asp-action="Finalize" method="post" class="modal-content" data-ajax="true">
            <input type="hidden" name="SortieId" id="finalizeSortieId" />
            <div class="modal-header">
                <h5 class="modal-title">Clôturer la sortie <span id="finalizeSortieCode"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-danger mb-2" data-ajax-errors></div>
                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Durée totale (min)</label>
                        <input type="number" name="DurationMinutes" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Dont jour (min)</label>
                        <input type="number" name="DayMinutes" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Dont nuit (min)</label>
                        <input type="number" name="NightMinutes" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Atterrissages</label>
                        <input type="number" name="Landings" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Approches</label>
                        <input type="number" name="Approachs" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">T/G O's Landings</label>
                        <input type="number" name="TGOsLandings" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Instrument simulé</label>
                        <input type="number" step="0.1" name="InstSimulated" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Instrument réel</label>
                        <input type="number" step="0.1" name="InstActual" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Heures IFR</label>
                        <input type="number" step="0.1" name="IFRHours" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Interceptions</label>
                        <input type="number" name="Interceptions" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Contacts radar</label>
                        <input type="number" name="RadarContacts" class="form-control" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="form-label">Contacts approche</label>
                        <input type="number" name="AppContacts" class="form-control" />
                    </div>
                    <div class="col-md-12 form-group mb-3">
                        <label class="form-label">Notes escadron</label>
                        <textarea name="SquadronReportNotes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="submit" class="btn btn-success">Clôturer la sortie</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            document.getElementById('cancelOdvModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('cancelOdvId').value = btn.getAttribute('data-odv-id');
            });
            document.getElementById('cancelSortieModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('cancelSortieId').value = btn.getAttribute('data-sortie-id');
            });
            document.getElementById('finalizeModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('finalizeSortieId').value = btn.getAttribute('data-sortie-id');
                document.getElementById('finalizeSortieCode').textContent = btn.getAttribute('data-sortie-code') || '';
            });

            // ─────────────────────────────────────────────────────────
            // AJAX submission for forms marked data-ajax="true".
            //
            // Why: OdvPlanningController.Create/Cancel and
            // SortiesController.Cancel/Finalize all return
            // BadRequest(Dictionary<string,string[]>) on validation
            // failure and a 302 redirect on success (confirmed from the
            // real controller code) — never View(model). A plain HTML
            // form POST would show raw JSON in the browser on any
            // failure (e.g. "already cancelled", missing aircraft,
            // out-of-scope squadron). This intercepts submit, posts via
            // fetch, and on failure maps each JSON key to the matching
            // asp-validation-for span (data-valmsg-for="<key>") when one
            // exists, or drops it into the form's [data-ajax-errors] box
            // otherwise (that's where "" -keyed general errors land,
            // e.g. Cancel's "This ODV is already cancelled.").
            // ─────────────────────────────────────────────────────────
            document.querySelectorAll('form[data-ajax="true"]').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    var errBox = form.querySelector('[data-ajax-errors]');
                    if (errBox) errBox.innerHTML = '';
                    form.querySelectorAll('[data-valmsg-for]').forEach(function (span) {
                        span.textContent = '';
                    });

                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) submitBtn.disabled = true;

                    try {
                        var resp = await fetch(form.getAttribute('action') || form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (resp.redirected) {
                            window.location.href = resp.url;
                            return;
                        }
                        if (resp.ok) {
                            window.location.reload();
                            return;
                        }

                        var data = null;
                        try { data = await resp.json(); } catch (parseErr) { /* not JSON */ }

                        var generalMessages = [];
                        if (data && typeof data === 'object') {
                            Object.keys(data).forEach(function (key) {
                                var messages = Array.isArray(data[key]) ? data[key] : [data[key]];
                                var span = form.querySelector('[data-valmsg-for="' + key + '"]');
                                if (span) {
                                    span.textContent = messages.join(' ');
                                } else {
                                    generalMessages = generalMessages.concat(messages);
                                }
                            });
                        } else {
                            generalMessages.push('Une erreur est survenue (HTTP ' + resp.status + ').');
                        }

                        if (generalMessages.length) {
                            if (errBox) {
                                errBox.innerHTML = generalMessages.map(function (m) { return '<div>' + m + '</div>'; }).join('');
                            } else {
                                window.alert(generalMessages.join('\n'));
                            }
                        }
                    } catch (networkErr) {
                        if (errBox) errBox.textContent = 'Erreur réseau — réessayez.';
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            });
        })();
    </script>
}
