@model FRAProject.Areas.SquadronOps.ViewModels.OdvIndexVm
@using FRAProject.Areas.SquadronOps.Models
@using FRAProject.Areas.Settings.Models
@using FRAProject.Areas.SquadronOps.Services
@using System.Text.Json
@using FRAProject
@using FRAProject.Enums

@{
    ViewData["Title"] = "Programme de vol";

    // NEW (Batch 15, 2026-08-30) — data for the "Ajouter une sortie à un
    // ODV" combined card's client-side cascading dropdowns (see that
    // card's own comment further down). Plain System.Text.Json, no new
    // dependency. Kept to exactly the three fields each dropdown needs —
    // nothing else about these entities is exposed to the page.
    //
    // FIX (Batch 16, 2026-08-30) — AcType's real namespace is
    // FRAProject.Areas.Settings.Models (confirmed from the real AcType.cs)
    // — Batch 15 fully-qualified this fallback as
    // FRAProject.Areas.AircraftMaintenance.Models.AcType, which would not
    // have compiled (same mistake as OdvIndexVm.cs's using list, fixed
    // there too). Fixed via the @using above instead of a fully-qualified
    // name.
    var acTypesJson = JsonSerializer.Serialize(
        (Model.AcTypesFull ?? new List<AcType>())
            .Select(t => new { id = t.Id, name = t.Name, acMainGroupId = t.AcMainGroupId }));

    var crewJson = JsonSerializer.Serialize(
        (Model.CrewMembersFull ?? new List<CrewMember>())
            .Select(c => new { id = c.Id, name = c.NickName + " — " + c.Captain, squadronId = c.SquadronId }));

    // NEW (Batch 16, 2026-08-30), RE-KEYED (Batch 17, 2026-08-30) —
    // allowed AircraftRole list for the redesigned combined card's dynamic
    // crew rows. "Captain" is deliberately excluded from every entry here
    // — the combined card has a separate, always-present Captain field;
    // offering "Captain" again in a dynamic row would let two different
    // people both get posted as Captain, which nothing here or
    // server-side actually forbids semantically.
    //
    // FIX (Batch 17) — Batch 16 keyed this by AcMainGroupId, which was
    // wrong: a real query showed the F16-2B AcMainGroup contains BOTH the
    // single-seat F16C and the two-seat F16D, so a single-seat sortie was
    // wrongly offered the two-seat jet's extra roles. AircraftRoleCatalog
    // itself was re-keyed on AcType.Code (see that file's header), so
    // this lookup now keys by AcTypeId (an int, safe as a JS object key)
    // instead, built from Model.AcTypesFull (already populated since
    // Batch 15). The client still never needs to know about Code.
    var roleCatalogJson = JsonSerializer.Serialize(
        (Model.AcTypesFull ?? new List<AcType>())
            .ToDictionary(
                t => t.Id.ToString(),
                t => AircraftRoleCatalog.GetAllowedRoles(t.Code)
                    .Where(r => r != FRAProject.Enums.AircraftRole.Captain)
                    .Select(r => new { id = (int)r, name = r.ToString() })
                    .ToList()
            ));

    (string css, string label) OdvBadge(FRAProject.Enums.OdvStatus? status) => status switch
    {
        FRAProject.Enums.OdvStatus.Cancelled => ("bg-danger", "Annulé"),
        FRAProject.Enums.OdvStatus.Planned => ("bg-secondary", "Planifié"),
        null => ("bg-secondary", "—"),
        _ => ("bg-secondary", status.ToString() ?? "—")
    };

    (string css, string label) SortieBadge(SortieStatus status) => status switch
    {
        SortieStatus.Planned => ("bg-secondary", "Planifiée"),
        SortieStatus.AircraftAssigned => ("bg-info text-dark", "Avion assigné"),
        SortieStatus.Airborne => ("bg-primary", "En vol"),
        SortieStatus.Landed => ("bg-primary", "Atterrie"),
        SortieStatus.CrewChiefReported => ("bg-warning text-dark", "CR CrewChief"),
        SortieStatus.Finalized => ("bg-success", "Clôturée"),
        SortieStatus.Canceled => ("bg-danger", "Annulée"),
        _ => ("bg-secondary", status.ToString())
    };

    var prevDate = Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDate = Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd");
    var todayDate = DateTime.Today.ToString("yyyy-MM-dd");
}

@*
    REBUILT (Batch 14, 2026-08-30) — Dadda shared the real legacy
    CIPL_FlyingProgram.aspx/.vb WebForms page as "the layout users are
    used to" and asked for a similar structure. This replaces Batch 13's
    Index.cshtml with the same real data/actions, restyled to match the
    legacy page's actual layout: a Filters bar, one Create-ODV card, a
    single bordered table (ODV columns + a compact nested Sorties table
    inside the last cell of each row, exactly like the legacy Repeater-
    inside-Repeater), a read-only Cnx checkbox, and icon-style row
    actions — all in the already-approved light-blue palette from
    Batch 10's _SquadronOpsLayout.cshtml (colors, not structure, stay
    consistent with what Dadda already approved — only the LAYOUT is
    borrowed from the legacy page, per the request).

    Three deliberate departures from the legacy page, decided this batch
    (see the AskUserQuestion answers) or forced by real gaps — flagged,
    not silently ported:

    1. "Add Sortie to ODV" card — REBUILT this batch (Batch 15,
       2026-08-30), now that SortieCrewsController.cs is in hand. See the
       "Ajouter une sortie à un ODV" card and its Batch 15 comment further
       down for the full design: there is still no single backend action
       that creates a sortie AND assigns crew in one database transaction
       (Sorties/Create and SortieCrews/Create remain two separate real
       actions on two separate controllers) — this card gets the one-step
       *feel* through client-side AJAX orchestration instead, calling one
       then the other. The per-sortie "+ Ajouter" link in each ODV row
       (linking to the real Sorties/Create page) is kept as a fallback for
       adding a bare sortie without any crew, or a second/third sortie to
       an ODV already handled by the combined card.

    2. Legacy's trash-icon "Delete" is a HARD DELETE (real SQL DELETE,
       cascaded via sp_CIPL_DeleteODVCascade) — OdvPlanningController has
       no Delete action at all, only Cancel (soft — sets OdvStatus, keeps
       every record). The icon here is wired to the real Cancel action
       instead; no hard-delete equivalent exists in the new system by
       design (matches the IsActive=false soft-delete convention used
       elsewhere in this app), not an oversight.

    3. Legacy's Edit is a true Bootstrap modal populated via server-side
       postback. The real OdvPlanningController.Edit returns a full
       View(vm) — a whole page with its own layout, not a partial — so
       loading it into a modal without building a partial-view variant
       would nest one layout inside another. Kept as a separate page
       (Batch 13's Edit.cshtml, unchanged) with an icon-styled trigger to
       at least visually match the Actions column.

    NEW this batch: an Escadron filter dropdown (only visible to an
    unrestricted/Admin user — see OdvPlanningController's Batch 14
    comment) matching the legacy ddlSqnID control.

    UPDATED (Batch 15, 2026-08-30) — the per-sortie "Action" cell now
    also carries a 👥 link to the new SortieCrews/Index page (see the
    Batch 15 README). No inline crew names/count are shown in this
    board — the query behind Model.Odvs (GetBoardForDateAsync) hasn't
    been confirmed to eager-load SortieCrews, and guessing at that would
    risk a null-reference on a board that currently renders fine; the
    link is a safe addition that costs nothing if the collection isn't
    loaded. Showing crew inline (matching legacy's Captain/Co-Pilot/
    Pax-01/Pax-02 columns) is flagged as a possible follow-up once that
    repository method is confirmed.
*@

<h1>Programme de vol</h1>
<p class="text-muted">Tableau opérationnel — ODVs et sorties du jour.</p>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<style>
    /* Structural classes ported from the legacy CIPL_FlyingProgram.aspx
       page, recolored to the already-approved Batch 10 light-blue
       palette (var(--brand-blue) etc. come from _SquadronOpsLayout.cshtml
       — this page inherits them, no redefinition needed here beyond the
       few not already defined by the shell). */
    .table-tight td, .table-tight th { padding: .35rem; vertical-align: middle; }
    .odv-canceled    { background: #ffe0e0; }
    .btn-xs          { padding: .15rem .4rem; font-size: .75rem; line-height: 1.2; }
    .badge-soft      { background: #e9ecef; color: #495057; border: 1px solid #dee2e6; }

    .sortie-inner    { width: 100%; border-collapse: collapse; }
    .sortie-inner td { padding: .25rem .4rem; font-size: .78rem; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
    .sortie-inner tr:last-child td { border-bottom: none; }
    .sortie-inner tr.s-canceled { background: #fff1f1; }
    .sortie-inner .col-seq  { width: 34px;  text-align: center; font-weight: 700; }
    .sortie-inner .col-type { width: 70px; }
    .sortie-inner .col-ac   { width: 80px; }
    .sortie-inner .col-time { width: 70px; }
    .sortie-inner .col-stat { width: 130px; }
    .sortie-inner .col-act  { text-align: right; white-space: nowrap; }
    thead.thead-dark th { background: var(--brand-blue-dark, #0f4a99); color: #fff; border-color: var(--brand-blue-dark, #0f4a99); }
</style>

<div class="card card-outline mb-3" style="border-top-color: var(--brand-blue, #1c64c9);">
    <div class="card-header py-2"><h3 class="card-title mb-0" style="font-size:1rem;">🔎 Filtres</h3></div>
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="form-row align-items-end">
            @if (Model.IsUnrestrictedScope)
            {
                <div class="col-md-3 form-group mb-2">
                    <label class="mb-1">Escadron</label>
                    <select name="squadronId" asp-items="Model.Squadrons" class="form-control form-control-sm" onchange="this.form.submit()">
                        <option value="">-- Toutes --</option>
                    </select>
                </div>
            }
            <div class="col-md-3 form-group mb-2">
                <label class="mb-1">Date</label>
                <input type="date" name="odvDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                @if (Model.IsUnrestrictedScope && Model.SelectedSquadronId.HasValue)
                {
                    <input type="hidden" name="squadronId" value="@Model.SelectedSquadronId" />
                }
            </div>
            <div class="col-md-3 form-group mb-2 d-flex" style="gap:.35rem;">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-odvDate="@prevDate" asp-route-squadronId="@Model.SelectedSquadronId" title="Jour précédent">&laquo;</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-odvDate="@nextDate" asp-route-squadronId="@Model.SelectedSquadronId" title="Jour suivant">&raquo;</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-odvDate="@todayDate" asp-route-squadronId="@Model.SelectedSquadronId">Aujourd'hui</a>
            </div>
            <div class="col-md-2 form-group mb-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Refresh</button>
            </div>
        </form>
    </div>
</div>

<div class="card card-outline mb-3" style="border-top-color: var(--brand-blue, #1c64c9);">
    <div class="card-header py-2">
        <h3 class="card-title mb-0" style="font-size:1rem;">➕ Créer un ODV (Mission)</h3>
    </div>
    <div class="card-body py-2">
        @*
            Create's controller action returns BadRequest(JSON) on
            validation failure and a redirect on success (confirmed from
            the real OdvPlanningController.Create) — never View(model) —
            so this form is submitted via AJAX (see Scripts).
        *@
        <div class="text-danger mb-2" data-ajax-errors></div>
        <form asp-controller="OdvPlanning" asp-action="Create" method="post" data-ajax="true">
            <input type="hidden" asp-for="CreateModel.OdvDate" />
            <div class="form-row">
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Call-Sign</label>
                    <select asp-for="CreateModel.CallSignId" asp-items="Model.CallSigns" class="form-control form-control-sm">
                        <option value="">--</option>
                    </select>
                    <span asp-validation-for="CreateModel.CallSignId" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Escadron</label>
                    <select asp-for="CreateModel.SquadronId" asp-items="Model.Squadrons" class="form-control form-control-sm">
                        <option value="">--</option>
                    </select>
                    <span asp-validation-for="CreateModel.SquadronId" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Groupe avion</label>
                    <select asp-for="CreateModel.AcMainGroupId" asp-items="Model.AcMainGroups" class="form-control form-control-sm">
                        <option value="">--</option>
                    </select>
                    <span asp-validation-for="CreateModel.AcMainGroupId" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Mission</label>
                    <select asp-for="CreateModel.MissionId" asp-items="Model.Missions" class="form-control form-control-sm">
                        <option value="">--</option>
                    </select>
                    <span asp-validation-for="CreateModel.MissionId" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Area</label>
                    <input asp-for="CreateModel.Area" class="form-control form-control-sm" value="SECTEUR" />
                </div>
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">TOFF</label>
                    <input asp-for="CreateModel.TOFF" class="form-control form-control-sm" placeholder="hh:mm" />
                </div>

                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Zone</label>
                    <select asp-for="CreateModel.Zone" asp-items="Model.ZoneList" class="form-control form-control-sm"></select>
                </div>
                <div class="col-md-2 form-group mb-2">
                    <label class="mb-1">Type mission</label>
                    <select asp-for="CreateModel.MissionType" asp-items="Model.MissionTypeList" class="form-control form-control-sm"></select>
                </div>
                <div class="col-md-4 form-group mb-2">
                    <label class="mb-1">Obs</label>
                    <textarea asp-for="CreateModel.Obs" class="form-control form-control-sm" rows="1"></textarea>
                </div>
                <div class="col-md-2 form-group mb-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-sm btn-info w-100">Créer ODV</button>
                </div>
            </div>
        </form>
    </div>
</div>

@*
    NEW (Batch 15, 2026-08-30), REDESIGNED (Batch 16, 2026-08-30) —
    "Ajouter une sortie à un ODV", matching legacy's one-step card
    (Sortie + full crew in a single submit). No single backend action does
    all of that today — this card gets there with client-side AJAX
    orchestration:

      1. POST Sorties/Create (with X-Requested-With so the Batch 15
         branch in SortiesController.Create returns JSON instead of
         redirecting — see that controller's Batch 15 comment).
      2. On success, POST SortieCrews/Create once for Captain, plus once
         per dynamic crew row added — run concurrently, since none of
         them depends on another's result.

    SortieCrewsController.Create/.Edit were deliberately NOT given the
    same AJAX branch (see SortieCrews/Create.cshtml's header comment on
    why those pages stay plain full-page posts) — so step 2 detects
    success purely from resp.redirected, reliable without any controller
    change: that action's only two real outcomes are a redirect (success)
    or a 200 View(model) (validation failure), confirmed from its real
    code. A crew-slot failure is reported but does not roll back the
    sortie or stop the remaining rows — the sortie already exists at that
    point, and any row that failed can still be fixed from the new
    Équipage (SortieCrews) page. Genuine trade-off, not a single atomic
    transaction the way legacy's one sp_CIPL_InsertSortie call was —
    flagging plainly rather than presenting it as equivalent.

    WHY REDESIGNED — Batch 15 shipped this with 4 FIXED slots (Captain/
    Co-Pilot/Pax1/Pax2), modelled on legacy's own fixed layout. Once real
    per-aircraft crew structures were confirmed (2026-08-30), that turned
    out to fit neither: F16 is Captain + exactly ONE of Copilot/
    WeaponOfficer/FlightEngineer (no passengers, ever, and only on the
    two-seat F16D — the single-seat F16C is Captain-only); C130 is Captain
    + up to FOUR others (Copilot/Navigator/FlightEngineer/Loadmaster, also
    no passengers). Per Dadda's choice, this is now: a fixed Captain field
    (every sortie needs a pilot-in-command) + a dynamic, repeatable
    "add crew row" list, each row picking a Crew Member and a Role.

    FIX (Batch 17, 2026-08-30) — Batch 16 filtered the Role dropdown by
    whichever ODV was selected, keyed on the ODV's AcMainGroup. That was
    wrong: a real query showed the F16-2B AcMainGroup contains BOTH the
    single-seat F16C and the two-seat F16D, so selecting an F16 ODV
    offered Copilot/WeaponOfficer/FlightEngineer even for a single-seat
    sortie. Role validity depends on the specific AcType, not the
    AcMainGroup — and the AcType isn't known until the "Type avion"
    dropdown itself is set (it's populated, but not pre-selected, once an
    ODV is chosen — an ODV's AcMainGroup can contain more than one
    AcType). So the Role dropdown per row is now filtered live from
    roleCatalogJson (embedded below, re-keyed by AcTypeId, built
    server-side from AircraftRoleCatalog.GetAllowedRoles(AcType.Code) —
    see that file and OdvPlanningController's Batch 17 comment) against
    whichever Type avion is selected, not the ODV. "Ajouter un membre
    d'équipage" stays disabled until a Type avion is chosen. An AcType not
    yet configured in AircraftRoleCatalog (F5E, F5F, AJET, at the time of
    writing) offers every non-Captain role, unfiltered — see that
    catalog's own comment for why that's the deliberate fallback.
    Changing ODV or Type avion clears any rows already added (their role
    choices may no longer be valid for the new aircraft) rather than
    trying to carry them over silently.

    CrewSeat still only has two values (Front/Rear) — with up to five
    crew total (Captain + up to four rows for a C130), Seat can only ever
    pair people up, not give each a distinct physical seat. This batch
    defaults Captain to Front and every dynamic row to Rear; editable
    afterward per person via the Équipage page. Not something this batch
    invents a fix for — flagged, not silently worked around, same as
    Batch 15/16's note on this.

    Dropdowns are populated client-side from the acTypesJson/crewJson/
    roleCatalogJson embedded below — Type avion and Captain filtered
    against whichever ODV is selected (data-squadron-id /
    data-acmaingroup-id on each ODV <option>), and Role filtered against
    whichever Type avion is selected (see the Scripts section). This is a
    client-side convenience only; Sorties/Create and SortieCrews/Create
    both already re-check AcMainGroup/AcType/Squadron/Role membership
    server-side regardless (the latter's server-side AircraftRole check
    was itself re-keyed to AcType.Code in Batch 17 — see that
    controller), so a stale or tampered selection is still safely
    rejected.
*@
<div class="card card-outline mb-3" style="border-top-color: var(--brand-blue, #1c64c9);">
    <div class="card-header py-2">
        <h3 class="card-title mb-0" style="font-size:1rem;">✈️ Ajouter une sortie à un ODV</h3>
    </div>
    <div class="card-body py-2">
        <div class="text-danger mb-2" id="addSortieErrors"></div>
        <div class="alert alert-success py-1 px-2 mb-2" id="addSortieSuccess" style="display:none;"></div>
        <form id="addSortieForm" class="form-row align-items-end" onsubmit="return false;">
            @Html.AntiForgeryToken()
            <div class="col-md-3 form-group mb-2">
                <label class="mb-1">ODV</label>
                <select id="as_OdvId" class="form-control form-control-sm">
                    <option value="">-- Sélectionner --</option>
                    @foreach (var odvOpt in (Model.Odvs ?? new List<Odv>()).Where(o => o.OdvStatus != FRAProject.Enums.OdvStatus.Cancelled))
                    {
                        <option value="@odvOpt.Id" data-squadron-id="@odvOpt.SquadronId" data-acmaingroup-id="@odvOpt.AcMainGroupId">
                            ODV #@odvOpt.Id — @(odvOpt.Mission?.Name ?? "—") (@(odvOpt.CallSign?.Code ?? "—"))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 form-group mb-2">
                <label class="mb-1">Sortie code</label>
                <input id="as_SortieCode" class="form-control form-control-sm" maxlength="10" />
                <span class="text-danger small" id="as_err_SortieCode"></span>
            </div>
            <div class="col-md-2 form-group mb-2">
                <label class="mb-1">Type avion</label>
                <select id="as_AcTypeId" class="form-control form-control-sm">
                    <option value="">-- Choisir un ODV --</option>
                </select>
                <span class="text-danger small" id="as_err_AcTypeId"></span>
            </div>
            <div class="col-md-2 form-group mb-2">
                <label class="mb-1">Config</label>
                <input id="as_Configuration" class="form-control form-control-sm" maxlength="100" />
                <span class="text-danger small" id="as_err_Configuration"></span>
            </div>
            <div class="col-md-1 form-group mb-2">
                <label class="mb-1">Seq</label>
                <input id="as_Sequence" type="number" min="1" value="1" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 form-group mb-2">
                <label class="mb-1">Captain</label>
                <select id="as_CaptainId" class="form-control form-control-sm">
                    <option value="">-- Choisir un ODV --</option>
                </select>
            </div>
        </form>

        <hr class="my-2" />

        <div class="d-flex align-items-center mb-2">
            <strong class="small text-muted">Équipage additionnel</strong>
            <button type="button" id="as_AddCrewRow" class="btn btn-sm btn-outline-primary ml-auto" disabled>
                ➕ Ajouter un membre d'équipage
            </button>
        </div>
        <div id="as_CrewRows"></div>
        <div class="text-muted small mb-2" id="as_CrewRowsHint">Sélectionnez d'abord un ODV pour ajouter de l'équipage.</div>

        <div class="d-flex justify-content-end">
            <button type="button" id="as_Submit" class="btn btn-sm btn-success">➕ Ajouter la sortie</button>
        </div>
    </div>
</div>

<script type="application/json" id="as_AcTypesJson">@Html.Raw(acTypesJson)</script>
<script type="application/json" id="as_CrewJson">@Html.Raw(crewJson)</script>
<script type="application/json" id="as_RoleCatalogJson">@Html.Raw(roleCatalogJson)</script>

<div class="card mb-3">
    <div class="card-header d-flex align-items-center py-2">
        <h3 class="card-title mb-0" style="font-size:1rem;">📋 ODV &amp; Sorties</h3>
        <span class="ml-auto badge badge-soft">Pré-vol : création / modification / ajout / annulation</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-tight mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th style="width:55px;">ODV</th>
                        <th style="width:100px;">Mission</th>
                        <th style="width:60px;">TOFF</th>
                        <th style="width:90px;">C/Sign</th>
                        <th style="width:90px;">Area</th>
                        <th style="width:50px;">PRV</th>
                        <th>Obs</th>
                        <th style="width:45px;">Cnx</th>
                        <th style="width:70px;">Actions</th>
                        <th>
                            <span>Sorties</span>
                            <table class="sortie-inner mt-1" style="opacity:.7;">
                                <tr>
                                    <td class="col-seq" style="font-weight:600;">Seq</td>
                                    <td class="col-type" style="font-weight:600;">Type</td>
                                    <td class="col-ac" style="font-weight:600;">A/C</td>
                                    <td class="col-time" style="font-weight:600;">TOFF réel</td>
                                    <td class="col-stat" style="font-weight:600;">Statut</td>
                                    <td class="col-act" style="font-weight:600;">Action</td>
                                </tr>
                            </table>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Odvs == null || !Model.Odvs.Any())
                    {
                        <tr><td colspan="10" class="text-muted text-center py-3">Aucun ODV pour cette date.</td></tr>
                    }
                    else
                    {
                        foreach (var odv in Model.Odvs)
                        {
                            var (odvCss, odvLabel) = OdvBadge(odv.OdvStatus);
                            var isPrv = string.Equals((odv.Area ?? "").Trim(), "PRV", StringComparison.OrdinalIgnoreCase);
                            <tr class="@(isPrv ? "table-warning" : (odv.OdvStatus == FRAProject.Enums.OdvStatus.Cancelled ? "odv-canceled" : ""))">
                                <td class="text-muted small">@odv.Id</td>
                                <td><strong>@(odv.Mission?.Name ?? "—")</strong></td>
                                <td>@(odv.TOFF?.ToString(@"hh\:mm") ?? "—")</td>
                                <td>@(odv.CallSign?.Code ?? "—")</td>
                                <td>@odv.Area</td>
                                <td class="text-center">
                                    @if (isPrv)
                                    {
                                        <span class="badge bg-primary">PRV</span>
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td class="small">@odv.Obs</td>
                                <td class="text-center">
                                    <input type="checkbox" disabled="disabled" @(odv.OdvStatus == FRAProject.Enums.OdvStatus.Cancelled ? "checked" : "") title="@odvLabel" />
                                </td>
                                <td class="text-center text-nowrap">
                                    <a class="btn btn-xs btn-outline-primary" asp-action="Edit" asp-route-id="@odv.Id" asp-route-odvDate="@Model.SelectedDate.ToString("yyyy-MM-dd")" title="Modifier">
                                        ✏️
                                    </a>
                                    @if (odv.OdvStatus != FRAProject.Enums.OdvStatus.Cancelled)
                                    {
                                        <button type="button" class="btn btn-xs btn-outline-danger ml-1" data-bs-toggle="modal" data-bs-target="#cancelOdvModal" data-odv-id="@odv.Id" title="Annuler l'ODV">
                                            🚫
                                        </button>
                                    }
                                    <a class="btn btn-xs btn-outline-secondary ml-1 mt-1" asp-controller="Sorties" asp-action="Create" asp-route-odvId="@odv.Id" title="Ajouter une sortie">
                                        ➕
                                    </a>
                                </td>
                                <td style="padding:0; vertical-align:top;">
                                    @if (odv.Sorties == null || !odv.Sorties.Any())
                                    {
                                        <div class="text-muted small p-2">Aucune sortie.</div>
                                    }
                                    else
                                    {
                                        <table class="sortie-inner">
                                            @foreach (var sortie in odv.Sorties.OrderBy(s => s.Sequence))
                                            {
                                                var (sCss, sLabel) = SortieBadge(sortie.Status);
                                                <tr class="@(sortie.Status == SortieStatus.Canceled ? "s-canceled" : "")">
                                                    <td class="col-seq">@sortie.Sequence</td>
                                                    <td class="col-type">@(sortie.AcType?.Name ?? "—")</td>
                                                    <td class="col-ac">@(sortie.Aircraft?.Registration ?? "—")</td>
                                                    <td class="col-time">@(sortie.RealTOFF?.ToString("HH:mm") ?? "—")</td>
                                                    <td class="col-stat"><span class="badge @sCss">@sLabel</span></td>
                                                    <td class="col-act">
                                                        @switch (sortie.Status)
                                                        {
                                                            case SortieStatus.Planned:
                                                                <a class="btn btn-xs btn-primary" asp-controller="Sorties" asp-action="AssignAircraft" asp-route-id="@sortie.Id">Assigner avion</a>
                                                                break;
                                                            case SortieStatus.AircraftAssigned:
                                                                <a class="btn btn-xs btn-primary" asp-controller="Sorties" asp-action="RecordDeparture" asp-route-id="@sortie.Id">Départ</a>
                                                                break;
                                                            case SortieStatus.Airborne:
                                                                <a class="btn btn-xs btn-primary" asp-controller="Sorties" asp-action="RecordArrival" asp-route-id="@sortie.Id">Arrivée</a>
                                                                break;
                                                            case SortieStatus.Landed:
                                                                <a class="btn btn-xs btn-primary" asp-controller="Sorties" asp-action="RecordPostFlight" asp-route-id="@sortie.Id">Post-vol</a>
                                                                break;
                                                            case SortieStatus.CrewChiefReported:
                                                                <button type="button" class="btn btn-xs btn-success" data-bs-toggle="modal" data-bs-target="#finalizeModal" data-sortie-id="@sortie.Id" data-sortie-code="@sortie.SortieCode">Clôturer</button>
                                                                break;
                                                            case SortieStatus.Finalized:
                                                                <span class="badge bg-secondary" title="@(sortie.FinalizedAtUtc?.ToString("dd/MM HH:mm"))">🔒 Locked</span>
                                                                break;
                                                            case SortieStatus.Canceled:
                                                                <span class="text-muted" title="@sortie.CancellationReason">🚫</span>
                                                                break;
                                                        }
                                                        @if (sortie.Status != SortieStatus.Finalized && sortie.Status != SortieStatus.Canceled)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-danger ml-1" data-bs-toggle="modal" data-bs-target="#cancelSortieModal" data-sortie-id="@sortie.Id" title="Annuler la sortie">
                                                                ✖
                                                            </button>
                                                        }
                                                        <a class="btn btn-xs btn-outline-secondary ml-1" asp-controller="SortieCrews" asp-action="Index" asp-route-sortieId="@sortie.Id" title="Équipage">
                                                            👥
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

