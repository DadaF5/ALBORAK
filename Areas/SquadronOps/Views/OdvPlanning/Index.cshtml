@model FRAProject.ViewModels.OdvIndexVm
@{
    ViewData["Title"] = "Squadron Flying Program";
    bool isAdmin = User.IsInRole("Admin");
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- ============================= -->
<!-- ODV DETAILS (CREATE)         -->
<!-- ============================= -->
<div class="card mb-8" style="margin-top:0px;">
    <div class="card-body">
        <div class="row">
            <div class="form-control" style="font-size:18px; color:white; padding-left:30px; background-color:dodgerblue;">
                Squadron Daily Flying Program
            </div>
        </div>
        
        <div class="col-md-2">
            <form method="get" asp-action="Index" class="row mb-1" id="dateForm">
                <label class="form-label">Date</label>
                <input type="date"
                       name="odvDate"
                       class="form-control"
                       value="@(Model.SelectedDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))"
                       onchange="this.form.submit()" />
            </form>
        </div>
        
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CreateModel.OdvDate" id="createOdvDate" />
            <div class="row g-3">
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-2">
                        <label class="form-label">Aircraft Group</label>
                        <select asp-for="CreateModel.AcMainGroupId" required
                                class="form-control"
                                asp-items="Model.AcMainGroups">
                            <option value="">-- Select Group --</option>
                        </select>
                        <span asp-validation-for="CreateModel.AcMainGroupId" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Squadron</label>
                        <select asp-for="CreateModel.SquadronId" required
                                class="form-control"
                                asp-items="Model.Squadrons">
                            <option value="">-- Select Squadron --</option>
                        </select>
                        <span asp-validation-for="CreateModel.SquadronId" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="CreateModel.SquadronId" />
                    <input type="hidden" asp-for="CreateModel.AcMainGroupId" />
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <strong>Squadron:</strong> @ViewBag.SquadronName
                        </div>
                        <div class="col-md-4">
                            <strong>Aircraft Group:</strong> @ViewBag.AcMainGroupName
                        </div>
                    </div>
                }
                
                <div class="col-md-2">
                    <label class="form-label">Call Sign</label>
                    <select asp-for="CreateModel.CallSignId" class="form-control"
                            asp-items="Model.CallSigns" required></select>
                    <span asp-validation-for="CreateModel.CallSignId" class="text-danger"></span>
                </div>
                
                <div class="col-md-1">
                    <label class="form-label">Mission</label>
                    <select asp-for="CreateModel.MissionId" class="form-control"
                            asp-items="Model.Missions" required></select>
                    <span asp-validation-for="CreateModel.MissionId" class="text-danger"></span>
                </div>

                <div class="col-md-1">
                    <label class="form-label">Area</label>
                    <input asp-for="CreateModel.Area" class="form-control" required />
                    <span asp-validation-for="CreateModel.Area" class="text-danger"></span>
                </div>

                <div class="col-md-1">
                    <label class="form-label">TOFF</label>
                    <input asp-for="CreateModel.TOFF" type="time"
                           asp-format="{0:HH:mm}"
                           class="form-control"
                           pattern="[0-9]{2}:[0-9]{2}"
                           required />
                    <span asp-validation-for="CreateModel.TOFF" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Obs</label>
                    <input asp-for="CreateModel.Obs" class="form-control" />
                </div>

                <div class="col-md-1">
                    <label class="form-label">Add ODV</label>
                    <button type="submit" class="btn btn-success w-100">+ Create</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ============================= -->
<!-- PLANNED ODVs GRID            -->
<!-- ============================= -->
<table class="table table-bordered table-sm">
    <thead class="table-primary text-center">
        <tr>
            <th rowspan="2">Mission</th>
            <th rowspan="2">TOFF</th>
            <th rowspan="2">Call Sign</th>
            <th rowspan="2">Area</th>
            <th rowspan="2">Status</th>
            <th rowspan="2">Actions</th>
            <th colspan="8">Sortie Details & Crew Assignment</th>
        </tr>
        <tr>
            <th>Sortie</th>
            <th>Config</th>
            <th>Aircraft Type</th>
            <th>Fuel</th>
            <th>Captain</th>
            <th>Copilot</th>
            <th>Mechanic</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Odvs.Any())
        {
            <tr>
                <td colspan="15" class="text-center text-muted">No ODVs planned.</td>
            </tr>
        }
        else
        {
            foreach (var odv in Model.Odvs)
            {
                var sortieCounter = 0;
                var maxSortiesInOdv = odv.Sorties?.Count() ?? 0;

                @if (maxSortiesInOdv == 0)
                {
                    <tr>
                        <td>@odv.Mission?.Name</td>
                        <td>@(odv.TOFF?.ToString(@"hh\:mm"))</td>
                        <td>@odv.CallSign?.Code</td>
                        <td>@odv.Area</td>
                        <td>@odv.OdvStatus</td>
                        <td class="text-center">
                            <a asp-action="Edit"
                               asp-route-id="@odv.Id"
                               asp-route-odvDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>
                            <a asp-controller="Sorties"
                               asp-action="Create"
                               asp-route-odvId="@odv.Id"
                               class="btn btn-sm btn-success">
                                + Add Sortie
                            </a>
                        </td>
                        <td colspan="8" class="text-muted text-center">No sorties planned</td>
                    </tr>
                }
                else
                {
                    foreach (var sortie in odv.Sorties.OrderBy(s => s.Sequence))
                    {
                        // Get crew by role/seat - USING CORRECT ENUM VALUES
                        var captain = sortie.SortieCrews?.FirstOrDefault(sc =>
                            sc.Seat == FRAProject.Enums.CrewSeat.Front &&
                            sc.AircraftRole == FRAProject.Enums.AircraftRole.Captain);

                        var copilot = sortie.SortieCrews?.FirstOrDefault(sc =>
                            sc.Seat == FRAProject.Enums.CrewSeat.Rear &&
                            sc.AircraftRole == FRAProject.Enums.AircraftRole.Copilot);

                        var mechanic = sortie.SortieCrews?.FirstOrDefault(sc =>
                            sc.AircraftRole == FRAProject.Enums.AircraftRole.Mechanic);

                        <tr>
                            @if (sortieCounter == 0)
                            {
                                <td rowspan="@maxSortiesInOdv">@odv.Mission?.Name</td>
                                <td rowspan="@maxSortiesInOdv">@(odv.TOFF?.ToString(@"hh\:mm"))</td>
                                <td rowspan="@maxSortiesInOdv">@odv.CallSign?.Code</td>
                                <td rowspan="@maxSortiesInOdv">@odv.Area</td>
                                <td rowspan="@maxSortiesInOdv">@odv.OdvStatus</td>
                                <td rowspan="@maxSortiesInOdv" class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@odv.Id"
                                       asp-route-odvDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-primary">
                                        Edit
                                    </a>
                                    <a asp-controller="Sorties"
                                       asp-action="Create"
                                       asp-route-odvId="@odv.Id"
                                       class="btn btn-sm btn-success">
                                        + Add Sortie
                                    </a>
                                </td>
                            }

                            <td>
                                <small class="badge bg-info">@sortie.Status</small>
                            </td>
                            <td>@sortie.Configuration</td>
                            <td>@sortie.AcType?.Name</td>
                            <td>@sortie.FuelQuantity</td>

                            <!-- Captain Column -->
                            <td>
                                @if (captain != null)
                                {
                                    <div class="crew-display captain">
                                        <strong>@captain.CrewMember?.Captain</strong>
                                        @* @if (!string.IsNullOrEmpty(captain.Role))
                                        {
                                            <small class="d-block text-muted">@captain.Role</small>
                                        } *@
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Copilot Column -->
                            <td>
                                @if (copilot != null)
                                {
                                    <div class="crew-display copilot">
                                        <strong>@copilot.CrewMember?.Captain</strong>
                                        @* @if (!string.IsNullOrEmpty(copilot.Role))
                                        {
                                            <small class="d-block text-muted">@copilot.Role</small>
                                        } *@
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Mechanic Column -->
                            <td>
                                @if (mechanic != null)
                                {
                                    <div class="crew-display mechanic">
                                        <strong>@mechanic.CrewMember?.Captain</strong>
                                        @* @if (!string.IsNullOrEmpty(mechanic.Role))
                                        {
                                            <small class="d-block text-muted">@mechanic.Role</small>
                                        } *@
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Sorties"
                                       asp-action="Edit"
                                       asp-route-id="@sortie.Id"
                                       class="btn btn-outline-primary">
                                        Edit
                                    </a>
                                    <a asp-controller="SortieCrews"
                                       asp-action="Index"
                                       asp-route-sortieId="@sortie.Id"
                                       class="btn btn-outline-secondary">
                                        Crew
                                    </a>
                                </div>
                            </td>
                        </tr>

                        sortieCounter++;
                    }
                }
            }
        }
    </tbody>
</table>

<style>
    .crew-display {
        padding: 4px;
        border-radius: 4px;
        margin: 2px 0;
    }
    
    .crew-display.captain {
        background-color: rgba(13, 110, 253, 0.1);
        border-left: 3px solid #0d6efd;
    }
    
    .crew-display.copilot {
        background-color: rgba(25, 135, 84, 0.1);
        border-left: 3px solid #198754;
    }
    
    .crew-display.mechanic {
        background-color: rgba(255, 193, 7, 0.1);
        border-left: 3px solid #ffc107;
    }

    .badge-sm {
        font-size: 0.7em;
        padding: 2px 4px;
    }

    /* Make rows more compact */
    .table-sm td, .table-sm th {
        padding: 0.3rem;
        vertical-align: middle;
    }

    /* Alternating row colors for better readability */
    tbody tr:nth-child(even) {
        background-color: rgba(0, 0, 0, 0.02);
    }
    
    /* Highlight rows with missing crew */
    .crew-missing {
        background-color: rgba(220, 53, 69, 0.05) !important;
    }
    
    /* Highlight rows with full crew */
    .crew-complete {
        background-color: rgba(25, 135, 84, 0.05) !important;
    }
</style>

<script>
    // Optional: Add row highlighting based on crew completeness
    document.addEventListener('DOMContentLoaded', function() {
        // Add CSS classes to rows based on crew status
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const captainCell = row.querySelector('td:nth-child(6)'); // Captain column
            const copilotCell = row.querySelector('td:nth-child(7)'); // Copilot column
            const mechanicCell = row.querySelector('td:nth-child(8)'); // Mechanic column
            
            // Check if cells exist (skip header rows)
            if (captainCell && copilotCell) {
                const hasCaptain = !captainCell.querySelector('.text-muted');
                const hasCopilot = !copilotCell.querySelector('.text-muted');
                
                if (hasCaptain && hasCopilot) {
                    row.classList.add('crew-complete');
                } else if (!hasCaptain || !hasCopilot) {
                    row.classList.add('crew-missing');
                }
            }
        });
    });
</script>


