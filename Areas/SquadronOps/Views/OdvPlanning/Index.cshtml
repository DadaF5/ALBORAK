@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            document.getElementById('cancelOdvModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('cancelOdvId').value = btn.getAttribute('data-odv-id');
            });
            document.getElementById('cancelSortieModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('cancelSortieId').value = btn.getAttribute('data-sortie-id');
            });
            document.getElementById('finalizeModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('finalizeSortieId').value = btn.getAttribute('data-sortie-id');
                document.getElementById('finalizeSortieCode').textContent = btn.getAttribute('data-sortie-code') || '';
            });

            // AJAX submission for forms marked data-ajax="true" — see the
            // Batch 13 README for why (Create/Cancel/Finalize return
            // BadRequest(JSON) on failure and a redirect on success,
            // never View(model)).
            document.querySelectorAll('form[data-ajax="true"]').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    var errBox = form.querySelector('[data-ajax-errors]');
                    if (errBox) errBox.innerHTML = '';
                    form.querySelectorAll('[data-valmsg-for]').forEach(function (span) {
                        span.textContent = '';
                    });

                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) submitBtn.disabled = true;

                    try {
                        var resp = await fetch(form.getAttribute('action') || form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (resp.redirected) {
                            window.location.href = resp.url;
                            return;
                        }
                        if (resp.ok) {
                            window.location.reload();
                            return;
                        }

                        var data = null;
                        try { data = await resp.json(); } catch (parseErr) { /* not JSON */ }

                        var generalMessages = [];
                        if (data && typeof data === 'object') {
                            Object.keys(data).forEach(function (key) {
                                var messages = Array.isArray(data[key]) ? data[key] : [data[key]];
                                var span = form.querySelector('[data-valmsg-for="' + key + '"]');
                                if (span) {
                                    span.textContent = messages.join(' ');
                                } else {
                                    generalMessages = generalMessages.concat(messages);
                                }
                            });
                        } else {
                            generalMessages.push('Une erreur est survenue (HTTP ' + resp.status + ').');
                        }

                        if (generalMessages.length) {
                            if (errBox) {
                                errBox.innerHTML = generalMessages.map(function (m) { return '<div>' + m + '</div>'; }).join('');
                            } else {
                                window.alert(generalMessages.join('\n'));
                            }
                        }
                    } catch (networkErr) {
                        if (errBox) errBox.textContent = 'Erreur réseau — réessayez.';
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            });
        })();
    </script>

    @* NEW (Batch 15, 2026-08-30), REDESIGNED (Batch 16, 2026-08-30) — "Ajouter une sortie à un ODV" combined-card orchestration. See that card's own header comment above for the design. *@
    <script>
        (function () {
            var acTypesEl = document.getElementById('as_AcTypesJson');
            var crewEl = document.getElementById('as_CrewJson');
            var roleCatalogEl = document.getElementById('as_RoleCatalogJson');
            var AC_TYPES = acTypesEl ? JSON.parse(acTypesEl.textContent || '[]') : [];
            var CREW = crewEl ? JSON.parse(crewEl.textContent || '[]') : [];
            // Keyed by AcTypeId (string) -> [{id, name}], built server-side
            // by AircraftRoleCatalog — see OdvPlanning/Index.cshtml's top
            // code block and that catalog's own comment for which
            // AcType.Code values are configured. RE-KEYED (Batch 17,
            // 2026-08-30) from AcMainGroupId to AcTypeId — see this
            // card's header comment above for why (F16-2B contains both
            // the single- and two-seat F16 variants, so AcMainGroup alone
            // isn't specific enough to determine valid roles).
            var ROLE_CATALOG = roleCatalogEl ? JSON.parse(roleCatalogEl.textContent || '{}') : {};

            // AircraftRole ordinals (Enums/AircraftRole.cs, Batch 15/16):
            // Captain=0.
            // CrewSeat ordinals (Enums/CrewSeat.cs, real, unchanged): Front=1, Rear=2.
            var SEAT_FRONT = 1, SEAT_REAR = 2;
            var ROLE_CAPTAIN = 0;

            var odvSelect = document.getElementById('as_OdvId');
            var acTypeSelect = document.getElementById('as_AcTypeId');
            var captainSelect = document.getElementById('as_CaptainId');
            var addRowBtn = document.getElementById('as_AddCrewRow');
            var rowsContainer = document.getElementById('as_CrewRows');
            var rowsHint = document.getElementById('as_CrewRowsHint');

            if (!odvSelect) return; // card not on this page render (shouldn't happen, defensive only)

            // Current ODV's eligible crew / allowed roles — updated on
            // every ODV change, read by addCrewRow() when building each
            // new row's dropdowns.
            var currentCrew = [];
            var currentRoles = [];
            var rowSeq = 0;

            function fillSelect(select, items, placeholder) {
                select.innerHTML = '';
                var opt0 = document.createElement('option');
                opt0.value = '';
                opt0.textContent = placeholder;
                select.appendChild(opt0);
                items.forEach(function (it) {
                    var opt = document.createElement('option');
                    opt.value = it.id;
                    opt.textContent = it.name;
                    select.appendChild(opt);
                });
            }

            function clearCrewRows() {
                rowsContainer.innerHTML = '';
            }

            function addCrewRow() {
                rowSeq++;
                var row = document.createElement('div');
                row.className = 'form-row align-items-end mb-2 as-crew-row';
                row.setAttribute('data-row-id', rowSeq);
                row.innerHTML =
                    '<div class="col-md-4 form-group mb-0">' +
                        '<select class="form-control form-control-sm as-row-crew"><option value="">-- Membre --</option></select>' +
                    '</div>' +
                    '<div class="col-md-4 form-group mb-0">' +
                        '<select class="form-control form-control-sm as-row-role"><option value="">-- Rôle --</option></select>' +
                    '</div>' +
                    '<div class="col-md-2 form-group mb-0">' +
                        '<button type="button" class="btn btn-sm btn-outline-danger as-row-remove">✖ Retirer</button>' +
                    '</div>';

                fillSelect(row.querySelector('.as-row-crew'), currentCrew, '-- Membre --');
                fillSelect(row.querySelector('.as-row-role'), currentRoles, '-- Rôle --');

                row.querySelector('.as-row-remove').addEventListener('click', function () {
                    row.remove();
                });

                rowsContainer.appendChild(row);
            }

            // Batch 17: role validity depends on the specific AcType, not
            // the AcMainGroup an ODV belongs to (an ODV's AcMainGroup can
            // contain more than one AcType — F16-2B has both F16C and
            // F16D). So selecting an ODV only populates Captain and the
            // Type avion options now; currentRoles/addRowBtn are handled
            // by the acTypeSelect listener below, once a specific AcType
            // is actually chosen.
            odvSelect.addEventListener('change', function () {
                var opt = odvSelect.selectedOptions[0];
                clearCrewRows();
                currentRoles = [];
                addRowBtn.disabled = true;

                if (!opt || !opt.value) {
                    fillSelect(acTypeSelect, [], '-- Choisir un ODV --');
                    fillSelect(captainSelect, [], '-- Choisir un ODV --');
                    currentCrew = [];
                    rowsHint.textContent = 'Sélectionnez d\'abord un ODV pour ajouter de l\'équipage.';
                    return;
                }
                var acMainGroupId = opt.getAttribute('data-acmaingroup-id');
                var squadronId = parseInt(opt.getAttribute('data-squadron-id'), 10);

                fillSelect(acTypeSelect, AC_TYPES.filter(function (t) { return t.acMainGroupId === parseInt(acMainGroupId, 10); }), '-- Sélectionner --');

                currentCrew = CREW.filter(function (c) { return c.squadronId === squadronId; });
                fillSelect(captainSelect, currentCrew, '--');

                rowsHint.textContent = 'Sélectionnez le type avion pour ajouter de l\'équipage.';
            });

            // NEW (Batch 17, 2026-08-30) — this is what actually resolves
            // currentRoles now, since AircraftRoleCatalog is keyed on
            // AcType.Code and an ODV's AcMainGroup can offer more than one
            // AcType (e.g. F16C vs F16D). Any rows already added are
            // cleared — their role choices may no longer be valid for the
            // newly-selected AcType.
            acTypeSelect.addEventListener('change', function () {
                clearCrewRows();
                var acTypeId = acTypeSelect.value;

                if (!acTypeId) {
                    currentRoles = [];
                    addRowBtn.disabled = true;
                    rowsHint.textContent = 'Sélectionnez le type avion pour ajouter de l\'équipage.';
                    return;
                }

                currentRoles = ROLE_CATALOG[acTypeId] || [];
                addRowBtn.disabled = false;
                rowsHint.textContent = currentRoles.length
                    ? ''
                    : 'Aucun rôle configuré pour ce type d\'avion — tous les rôles seront proposés; vérifiez après coup sur la page Équipage.';
            });

            addRowBtn.addEventListener('click', addCrewRow);

            function clearErrors() {
                document.getElementById('addSortieErrors').innerHTML = '';
                document.getElementById('addSortieSuccess').style.display = 'none';
                ['SortieCode', 'AcTypeId', 'Configuration'].forEach(function (f) {
                    var el = document.getElementById('as_err_' + f);
                    if (el) el.textContent = '';
                });
            }

            function getToken() {
                var el = document.querySelector('#addSortieForm input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            // SortieCrewsController.Create is deliberately NOT given an
            // AJAX-JSON branch (see SortieCrews/Create.cshtml's header
            // comment) — its only two real outcomes are a redirect on
            // success or a 200 View(model) on validation failure, so
            // resp.redirected is the only reliable success signal
            // available here without a second controller change.
            async function postCrew(sortieId, crewMemberId, seat, aircraftRole, roleText, isPrimary) {
                if (!crewMemberId || !aircraftRole) return { ok: true, skipped: true };
                var fd = new FormData();
                fd.append('__RequestVerificationToken', getToken());
                fd.append('SortieId', sortieId);
                fd.append('CrewMemberId', crewMemberId);
                fd.append('Seat', seat);
                fd.append('AircraftRole', aircraftRole);
                fd.append('Role', roleText);
                fd.append('IsPrimary', isPrimary ? 'true' : 'false');

                var resp = await fetch('@Url.Action("Create", "SortieCrews")', {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                return { ok: resp.redirected };
            }

            var submitBtn = document.getElementById('as_Submit');
            submitBtn?.addEventListener('click', async function () {
                clearErrors();

                var odvOpt = odvSelect.selectedOptions[0];
                if (!odvOpt || !odvOpt.value) {
                    document.getElementById('addSortieErrors').textContent = 'Sélectionnez un ODV.';
                    return;
                }

                submitBtn.disabled = true;

                try {
                    var fd = new FormData();
                    fd.append('__RequestVerificationToken', getToken());
                    fd.append('OdvId', odvOpt.value);
                    fd.append('SortieCode', document.getElementById('as_SortieCode').value);
                    fd.append('AcTypeId', acTypeSelect.value);
                    fd.append('Configuration', document.getElementById('as_Configuration').value);
                    fd.append('Sequence', document.getElementById('as_Sequence').value || '1');

                    var resp = await fetch('@Url.Action("Create", "Sorties")', {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!resp.ok) {
                        var errors = null;
                        try { errors = await resp.json(); } catch (e) { /* not JSON */ }
                        var messages = [];
                        if (errors && typeof errors === 'object') {
                            Object.keys(errors).forEach(function (key) {
                                var msgs = Array.isArray(errors[key]) ? errors[key] : [errors[key]];
                                var span = document.getElementById('as_err_' + key);
                                if (span) {
                                    span.textContent = msgs.join(' ');
                                } else {
                                    messages = messages.concat(msgs);
                                }
                            });
                        } else {
                            messages.push('La sortie n\'a pas pu être créée (HTTP ' + resp.status + ').');
                        }
                        if (messages.length) {
                            document.getElementById('addSortieErrors').innerHTML =
                                messages.map(function (m) { return '<div>' + m + '</div>'; }).join('');
                        }
                        return;
                    }

                    var data = await resp.json();
                    var sortieId = data.sortieId;

                    // Captain (fixed field) + one call per dynamic crew
                    // row — all independent, run concurrently rather than
                    // sequentially. A crew-row failure is reported but
                    // does not roll back the sortie or the other rows —
                    // see the card's header comment. Every dynamic row
                    // defaults to Seat=Rear (Captain is Front) — see the
                    // header comment on CrewSeat's two-value limitation.
                    var calls = [
                        postCrew(sortieId, captainSelect.value, SEAT_FRONT, ROLE_CAPTAIN, 'Captain', true)
                    ];
                    var rowEls = rowsContainer.querySelectorAll('.as-crew-row');
                    rowEls.forEach(function (row) {
                        var crewSel = row.querySelector('.as-row-crew');
                        var roleSel = row.querySelector('.as-row-role');
                        var roleText = roleSel.selectedOptions[0] ? roleSel.selectedOptions[0].textContent : '';
                        calls.push(postCrew(sortieId, crewSel.value, SEAT_REAR, roleSel.value, roleText, false));
                    });

                    var crewResults = await Promise.all(calls);
                    var failedCount = crewResults.filter(function (r) { return !r.skipped && !r.ok; }).length;

                    var successBox = document.getElementById('addSortieSuccess');
                    successBox.style.display = '';
                    successBox.textContent = failedCount === 0
                        ? ('Sortie ' + data.sortieCode + ' créée avec l\'équipage sélectionné.')
                        : ('Sortie ' + data.sortieCode + ' créée, mais ' + failedCount + ' affectation(s) d\'équipage ont échoué ' +
                           '(déjà affecté, rôle invalide, ou données manquantes) — vérifiez la page Équipage de cette sortie après actualisation.');

                    setTimeout(function () { window.location.reload(); }, 1600);
                } catch (networkErr) {
                    document.getElementById('addSortieErrors').textContent = 'Erreur réseau — réessayez.';
                } finally {
                    submitBtn.disabled = false;
                }
            });
        })();
    </script>
}
