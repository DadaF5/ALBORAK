@model FRAProject.ViewModels.OdvIndexVm
@* ODV Details form (left panel) *@
<div class="card p-3">
    <h5>ODV Details Part</h5>
    <form asp-action="CreateOdv" method="post" class="row g-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SquadronId" value="@Model.SelectedSquadronId" />
        <div class="col-md-3">
            <label class="form-label">Call-Sign</label>
            <select name="CallSignId" class="form-select">
                <option value="">--</option>
                @foreach (var cs in Model.CallSigns)
                {
                    <option value="@cs.Value">@cs.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Mission</label>
            <select name="MissionId" class="form-select">
                <option value="">--</option>
                @foreach (var m in Model.Missions)
                {
                    <option value="@m.Value">@m.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Area</label>
            <input name="Area" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">TOFF</label>
            <input name="TOFF" class="form-control" type="time" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Obs</label>
            <input name="Obs" class="form-control" />
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-primary"> <i class="bi bi-plus-circle"></i> Add</button>
        </div>
    </form>
</div>
