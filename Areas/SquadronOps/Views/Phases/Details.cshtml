@model FRAProject.ViewModels.PhaseViewModel
@{
    ViewData["Title"] = "Phase Details";
}

<div class="container">
    <div class="row mb-3">
        <div class="col"><h2>Phase Details</h2></div>
        <div class="col text-right">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
</div>
