@model List<FRAProject.ViewModels.PhaseViewModel>
@{
    ViewData["Title"] = "Phases";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h2>Phases</h2>
        </div>
        <div class="col text-right">
            <a asp-action="Create" class="btn btn-primary btn-sm">New Phase</a>
        </div>
    </div>

    <table class="table table-striped table-sm">
        <thead class="thead-light">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th style="width:160px" class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td class="text-right">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary mr-1">Details</a>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary mr-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>