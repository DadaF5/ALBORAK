@model FRAProject.Areas.SquadronOps.ViewModels.SortieCrewCreateVm

@{
    ViewData["Title"] = "Ajouter un membre d'équipage";
}

@*
    NEW (Batch 15, 2026-08-30). Standalone full-page form, NOT AJAX — see
    SortieCrews/Index.cshtml's header comment: the real
    SortieCrewsController.Create POST returns View(model) (HTTP 200) on
    validation failure, unlike OdvPlanning/Sorties' BadRequest(JSON)
    contract, so the plain asp-validation-summary/asp-validation-for
    pattern (same as Sorties/RecordDeparture.cshtml) is the correct one
    here, not the data-ajax="true" fetch handler used elsewhere in this
    module.

    Seat / Rôle avion dropdown text comes straight from the real
    controller's GetSeatOptions()/GetAircraftRoleOptions() (enum
    .ToString(), e.g. "Front", "WeaponOfficer") — left as the controller
    sends it rather than relabeling only on this page, so what you see
    here always matches what the controller actually offers. Flagged in
    the README as a possible cosmetic follow-up ([Display] attributes on
    the enums, or a formatting helper in the controller).

    CHANGED (Batch 16, 2026-08-30) — the Rôle avion options are no longer
    every AircraftRole value: GetAircraftRoleOptions() now filters through
    AircraftRoleCatalog per this sortie's own AcMainGroup (F16 vs C130
    etc. see different lists). Nothing changed on THIS page for that —
    the filtering happens entirely server-side before ViewBag.AircraftRoles
    reaches here.
*@

<h1>Ajouter un membre d'équipage</h1>
<h4>Sortie @Model.SortieCode</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SortieId" />

            <div class="form-group mb-3">
                <label asp-for="CrewMemberId" class="form-label">Membre d'équipage</label>
                <select asp-for="CrewMemberId" asp-items="ViewBag.CrewMembers" class="form-select">
                    <option value="">-- Sélectionner --</option>
                </select>
                <span asp-validation-for="CrewMemberId" class="text-danger"></span>
                @if (ViewBag.CrewMembers == null || !((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.CrewMembers).Any())
                {
                    <div class="form-text text-warning">Aucun membre d'équipage disponible (actif, non déjà affecté, de l'escadron de cet ODV).</div>
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="Seat" class="form-label">Place</label>
                <select asp-for="Seat" asp-items="ViewBag.Seats" class="form-select"></select>
                <span asp-validation-for="Seat" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AircraftRole" class="form-label">Rôle avion</label>
                <select asp-for="AircraftRole" asp-items="ViewBag.AircraftRoles" class="form-select"></select>
                <span asp-validation-for="AircraftRole" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Role" class="form-label">Rôle (texte libre)</label>
                <input asp-for="Role" class="form-control" placeholder="ex : Pilote, Copilote, Observateur..." />
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsPrimary" class="form-check-input" />
                <label asp-for="IsPrimary" class="form-check-label">Membre principal</label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Remarks" class="form-label">Remarques</label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Ajouter" class="btn btn-primary" />
                <a asp-action="Index" asp-route-sortieId="@Model.SortieId" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
