@model FRAProject.Areas.SquadronOps.ViewModels.SortieCrewCreateVm

@{
    ViewData["Title"] = "Modifier l'affectation";
}

@* NEW (Batch 15, 2026-08-30) — same standalone full-page pattern as Create.cshtml; see its header comment. *@

<h1>Modifier l'affectation</h1>
<h4>Sortie @Model.SortieCode — @Model.CrewMemberName</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SortieId" />

            <div class="form-group mb-3">
                <label asp-for="CrewMemberId" class="form-label">Membre d'équipage</label>
                <select asp-for="CrewMemberId" asp-items="ViewBag.CrewMembers" class="form-select">
                    <option value="">-- Sélectionner --</option>
                </select>
                <span asp-validation-for="CrewMemberId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Seat" class="form-label">Place</label>
                <select asp-for="Seat" asp-items="ViewBag.Seats" class="form-select"></select>
                <span asp-validation-for="Seat" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AircraftRole" class="form-label">Rôle avion</label>
                <select asp-for="AircraftRole" asp-items="ViewBag.AircraftRoles" class="form-select"></select>
                <span asp-validation-for="AircraftRole" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Role" class="form-label">Rôle (texte libre)</label>
                <input asp-for="Role" class="form-control" placeholder="ex : Pilote, Copilote, Observateur..." />
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsPrimary" class="form-check-input" />
                <label asp-for="IsPrimary" class="form-check-label">Membre principal</label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Remarks" class="form-label">Remarques</label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Enregistrer" class="btn btn-primary" />
                <a asp-action="Index" asp-route-sortieId="@Model.SortieId" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
