@model List<FRAProject.Areas.SquadronOps.Models.SortieCrew>
@using FRAProject.Enums
@{
    ViewData["Title"] = "Équipage";
    int sortieId = ViewBag.SortieId;
    string? sortieCode = ViewBag.SortieCode;
    int odvId = ViewBag.OdvId;

    string SeatLabel(FRAProject.Enums.CrewSeat seat) => seat switch
    {
        FRAProject.Enums.CrewSeat.Front => "Avant",
        FRAProject.Enums.CrewSeat.Rear => "Arrière",
        _ => seat.ToString()
    };
}

@*
    NEW (Batch 15, 2026-08-30) — the crew-assignment page flagged as
    blocked since Batch 13, now unblocked by the real
    SortieCrewsController.cs. Built as a standalone full page, NOT an
    AJAX/modal pattern like OdvPlanning/Sorties — see the README for why:
    SortieCrewsController.Create/.Edit return a normal View(model) (HTTP
    200) on validation failure, not BadRequest(JSON). Reusing the
    JSON-AJAX submit handler here would silently swallow validation
    errors (resp.ok would be true and the page would just reload).
*@

<h1>Équipage — Sortie @sortieCode</h1>
<p class="text-muted">Affectation des membres d'équipage à cette sortie.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a asp-controller="OdvPlanning" asp-action="Index" class="btn btn-sm btn-outline-secondary">⬅ Retour au tableau</a>
    <a asp-controller="OdvPlanning" asp-action="Edit" asp-route-id="@odvId" class="btn btn-sm btn-outline-secondary">Voir l'ODV</a>
    <a asp-action="Create" asp-route-sortieId="@sortieId" class="btn btn-sm btn-primary">➕ Ajouter un membre d'équipage</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:90px;">Place</th>
                    <th>Membre d'équipage</th>
                    <th style="width:150px;">Rôle avion</th>
                    <th>Rôle (libre)</th>
                    <th style="width:80px;">Principal</th>
                    <th>Remarques</th>
                    <th style="width:130px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="7" class="text-muted text-center py-3">Aucun membre d'équipage affecté à cette sortie.</td></tr>
                }
                else
                {
                    foreach (var sc in Model)
                    {
                        <tr>
                            <td>@SeatLabel(sc.Seat)</td>
                            <td>
                                @(sc.CrewMember?.Captain ?? "—")
                                @if (!string.IsNullOrEmpty(sc.CrewMember?.NickName))
                                {
                                    <span class="text-muted small">(@sc.CrewMember.NickName)</span>
                                }
                            </td>
                            <td>@sc.AircraftRole</td>
                            <td>@(sc.Role ?? "—")</td>
                            <td class="text-center">
                                @if (sc.IsPrimary)
                                {
                                    <span class="badge bg-primary">Oui</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="small">@(sc.Remarks ?? "—")</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@sc.Id" title="Modifier">✏️</a>
                                <form asp-action="Delete" asp-route-id="@sc.Id" method="post" class="d-inline" onsubmit="return confirm('Retirer ce membre d\'équipage de la sortie ?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Retirer">🗑️</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
