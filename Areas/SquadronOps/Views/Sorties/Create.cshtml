@model FRAProject.ViewModels.SortieCreateVm

@{
    ViewData["Title"] = "Add Sortie";

    // Define this variable at the top level so it's accessible everywhere
    var acTypes = ViewBag.AcTypes as IEnumerable<SelectListItem>;
    var hasAircraftTypes = acTypes != null && acTypes.Any();
}

<style>
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.75);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1050;
        padding: 20px;
    }

    .popup-container {
        background-color: #2d3748;
        border-radius: 16px;
        max-width: 500px;
        width: 100%;
    }

    .popup-content {
        padding: 30px;
    }

    /* Disabled select styling */
    .select-disabled {
        cursor: not-allowed;
        opacity: 0.6;
        background-color: #4a5568 !important;
    }
</style>

<div class="popup-overlay">
    <div class="popup-container">
        <div class="popup-content">
            <h4 class="text-white mb-4">Add Sortie</h4>

            <!-- Display warning message if any -->
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @TempData["Warning"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Display info message if any -->
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["Info"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Create" method="post" id="sortieForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OdvId" />

                <div class="mb-3">
                    <label class="form-label text-white">Sortie Code</label>
                    <input asp-for="SortieCode" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="SortieCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Aircraft Type</label>

                    @if (hasAircraftTypes)
                    {
                        <select asp-for="AcTypeId" asp-items="ViewBag.AcTypes"
                                class="form-select bg-dark text-white border-secondary" required>
                            <option value="">-- Select Type --</option>
                        </select>
                    }
                    else
                    {
                        <select class="form-select bg-dark text-white border-secondary select-disabled" disabled>
                            <option>No aircraft types available</option>
                        </select>
                        <input type="hidden" asp-for="AcTypeId" value="0" />
                        <div class="text-warning mt-1">
                            <small>You cannot create sorties without assigned aircraft types.</small>
                        </div>
                    }

                    <span asp-validation-for="AcTypeId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Configuration</label>
                    <input asp-for="Configuration" class="form-control bg-dark text-white border-secondary" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-white">Sequence</label>
                    <input asp-for="Sequence" class="form-control bg-dark text-white border-secondary" />
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    @if (hasAircraftTypes)
                    {
                        <button type="submit" class="btn btn-success">Save</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success" disabled>Save</button>
                    }
                    <a asp-controller="OdvPlanning" asp-action="Index"
                       class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Disable form submission if no aircraft types
        document.addEventListener('DOMContentLoaded', function() {
            var form = document.getElementById('sortieForm');
            var hasAircraftTypes = @hasAircraftTypes.ToString().ToLower();

            if (!hasAircraftTypes) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    alert('Cannot submit: No aircraft types available for your account.');
                    return false;
                });
            }
        });
    </script>
}