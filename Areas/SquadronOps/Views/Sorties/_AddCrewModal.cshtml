@model int  
@* sortieId *@
<form id="add-crew-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="sortieId" value="@Model" />
    <div class="mb-2">
        <label>Member</label>
        <select name="personId" class="form-select">
            <option value="">-- select --</option>
            @foreach (var cm in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.CrewMembers)
            {
                <option value="@cm.Value">@cm.Text</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label>Role</label>
        <input name="role" class="form-control" />
    </div>
    <div class="form-check mb-2">
        <input name="isPrimary" type="checkbox" value="true" class="form-check-input" id="isPrimary" />
        <label for="isPrimary" class="form-check-label">Primary</label>
    </div>
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary ms-2">Add Crew</button>
    </div>
</form>
