@model SquadronViewModel
@using FRAProject.Areas.SquadronOps.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Create Squadron";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h2>Create Squadron</h2>
        </div>
        <div class="col text-right">
            <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="FrenchName"></label>
                <input asp-for="FrenchName" class="form-control" />
                <span asp-validation-for="FrenchName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="CallSign"></label>
                <input asp-for="CallSign" class="form-control" />
                <span asp-validation-for="CallSign" class="text-danger"></span>
            </div>

            <div class="form-group col-md-4">
                <label asp-for="CallSignShort"></label>
                <input asp-for="CallSignShort" class="form-control" />
                <span asp-validation-for="CallSignShort" class="text-danger"></span>
            </div>

            <div class="form-group col-md-4">
                <label asp-for="WingId">Wing</label>
                <select asp-for="WingId" asp-items="Model.Wings" class="form-control"></select>
                <span asp-validation-for="WingId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="LogoFile">Logo (PNG / JPG)</label>
            <input asp-for="LogoFile" type="file" accept="image/*" class="form-control-file" id="logoFileInput" />
            <small class="form-text text-muted">Choose an image to upload. A preview will appear below.</small>
            <span asp-validation-for="LogoFile" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Preview</label>
            <div>
                <img id="logoPreview" src="@Url.Content("~/images/placeholder.png")" alt="Logo preview" style="width:140px;height:140px;object-fit:cover;border:1px solid #ddd;border-radius:4px;" />
            </div>
        </div>

        <div class="form-group form-check">
            <input asp-for="Active" class="form-check-input" type="checkbox" />
            <label asp-for="Active" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        // simple client-side preview
        (function () {
            var input = document.getElementById('logoFileInput');
            var preview = document.getElementById('logoPreview');
            input && input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) {
                    preview.src = '@Url.Content("~/images/placeholder.png")';
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (ev) {
                    preview.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            });

            // basic bootstrap validation styling (optional)
            (function () {
                'use strict';
                var forms = document.getElementsByClassName('needs-validation');
                Array.prototype.forEach.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            })();
        })();
    </script>
    @* client validation scripts (if you use unobtrusive validation) *@
    <partial name="_ValidationScriptsPartial" />
}