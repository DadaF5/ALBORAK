@using FRAProject.Areas.SquadronOps.ViewModels
@model SquadronViewModel
@{
    ViewData["Title"] = "Squadron Details";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h2>Squadron Details</h2>
        </div>
        <div class="col text-right">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <label class="d-block">Logo</label>
            <div class="mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                {
                    <img src="@Url.Content(Model.LogoPath)" alt="@Model.Name logo" style="width:240px;height:240px;object-fit:cover;border:1px solid #ddd;border-radius:4px;" />
                }
                else
                {
                    <img src="@Url.Content("~/images/placeholder.png")" alt="No logo" style="width:240px;height:240px;object-fit:cover;border:1px solid #ddd;border-radius:4px;" />
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
            {
                <form asp-action="DeleteLogo" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete logo permanently?')">Delete Logo</button>
                </form>
            }
        </div>

        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">French Name</dt>
                <dd class="col-sm-8">@Model.FrenchName</dd>

                <dt class="col-sm-4">Call-Sign</dt>
                <dd class="col-sm-8">@Model.CallSign</dd>

                <dt class="col-sm-4">Short Call-Sign</dt>
                <dd class="col-sm-8">@Model.CallSignShort</dd>

                <dt class="col-sm-4">Wing</dt>
                <dd class="col-sm-8">@Model.WingName</dd>

                <dt class="col-sm-4">Base</dt>
                <dd class="col-sm-8">@Model.BaseName</dd>

                <dt class="col-sm-4">Logo Path</dt>
                <dd class="col-sm-8">@Model.LogoPath</dd>

                <dt class="col-sm-4">Active</dt>
                <dd class="col-sm-8">@(Model.Active ? "Yes" : "No")</dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to list</a>
            </div>
        </div>
    </div>
</div>
