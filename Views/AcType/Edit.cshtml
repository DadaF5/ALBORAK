@model FRAProject.ViewModels.AcType.AcTypeViewModel
@{
    ViewData["Title"] = "Edit AcType";
}

<div class="container mt-3">
    <div class="card">
        <div class="card-header">
            <h4>Edit AcType</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AcMainGroupId" class="form-label"></label>
                    <select asp-for="AcMainGroupId" class="form-select" asp-items="Model.AcMainGroups">
                        <option value="">-- Select Main Group --</option>
                    </select>
                    <span asp-validation-for="AcMainGroupId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
