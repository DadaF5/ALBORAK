@model FRAProject.ViewModels.AircraftViewModel
@{
    ViewData["Title"] = "Create Aircraft";
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {

            // On change of MainGroup, load related AcTypes via AJAX
            $('#AcMainGroupId').change(function () {
                var mainGroupId = $(this).val();
                var acTypeDropdown = $('#AcTypeId');
                acTypeDropdown.empty();
                acTypeDropdown.append($('<option>').val('').text('-- Select Aircraft Type --'));

                if (mainGroupId) {
                    $.getJSON('@Url.Action("GetAcTypesByMainGroup", "Aircraft")/' + mainGroupId, function (data) {
                        $.each(data, function (i, item) {
                            acTypeDropdown.append($('<option>').val(item.id).text(item.name));
                        });
                    });
                }
            });

            // Set default AcStatusType as "Serviceable"
            $('#AcStatusTypeId').val('@Model.DefaultServiceableStatusId');
        });
    </script>
}

<div class="container mt-3">
    <div class="card">
        <div class="card-header">
            <h4>Create New Aircraft</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Cascading Dropdowns at the Top -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="AcMainGroups" class="form-label">Main Group</label>
                        <select id="AcMainGroupId" name="AcMainGroupId" class="form-select" asp-items="Model.AcMainGroups">
                            <option value="">-- Select Main Group --</option>
                        </select>
                        <span asp-validation-for="AcMainGroups" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AcTypeId" class="form-label">Aircraft Type</label>
                        <select id="AcTypeId" name="AcTypeId" class="form-select">
                            <option value="">-- Select Aircraft Type --</option>
                            <!-- Populated dynamically -->
                        </select>
                        <span asp-validation-for="AcTypeId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AcStatusTypeId" class="form-label">Status</label>
                        <select id="AcStatusTypeId" name="AcStatusTypeId" class="form-select" asp-items="Model.AcStatusTypes">
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="AcStatusTypeId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Other Fields -->
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="TailNo" class="form-label"></label>
                        <input asp-for="TailNo" class="form-control" />
                        <span asp-validation-for="TailNo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Registration" class="form-label"></label>
                        <input asp-for="Registration" class="form-control" />
                        <span asp-validation-for="Registration" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="IntCode" class="form-label"></label>
                        <input asp-for="IntCode" class="form-control" />
                        <span asp-validation-for="IntCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="Manufacturer" class="form-label"></label>
                        <input asp-for="Manufacturer" class="form-control" />
                        <span asp-validation-for="Manufacturer" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="SerialNumber" class="form-label"></label>
                        <input asp-for="SerialNumber" class="form-control" />
                        <span asp-validation-for="SerialNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ManufactureDate" class="form-label"></label>
                        <input asp-for="ManufactureDate" class="form-control" type="date" />
                        <span asp-validation-for="ManufactureDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6 form-check mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="col-md-6 form-check mt-2">
                        <input asp-for="IsServiceable" class="form-check-input" />
                        <label asp-for="IsServiceable" class="form-check-label"></label>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-12">
                        <label asp-for="Obs" class="form-label"></label>
                        <textarea asp-for="Obs" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Obs" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>
