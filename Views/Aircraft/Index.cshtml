@model FRAProject.ViewModels.AircraftIndexViewModel
@* @using Microsoft.AspNetCore.Mvc.Rendering *@

@{
    ViewData["Title"] = "Aircrafts";
}

<div class="container-fluid mt-3">

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-2">
                    <select asp-for="FilterBaseId" class="form-select" asp-items="Model.Bases">
                        <option value="">-- All Bases --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select asp-for="FilterAcTypeId" class="form-select" asp-items="Model.AcTypes">
                        <option value="">-- All Types --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select asp-for="FilterStatusTypeId" class="form-select" asp-items="Model.StatusTypes">
                        <option value="">-- All Status --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Create" class="btn btn-success">Create New Aircraft</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Registration</th>
                        <th>Tail No</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Base</th>
                        <th>Serviceable</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Aircrafts)
                    {
                        <tr>
                            <td>@a.Registration</td>
                            <td>@a.TailNo</td>
                            <td>@a.AcType?.Name</td>
                            <td>@a.AcStatusType?.StatusName</td>
                            <td>@a.AcType?.AcMainGroup?.Base?.BaseName</td>
                            <td>
                                @if (a.Serviceable)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">No</span>
                                }
                            </td>
                            <td>
                                @if (a.Active)
                                {
                                    <span class="badge bg-primary">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-info">Edit</a>
                                <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

