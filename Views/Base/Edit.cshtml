@model FRAProject.ViewModels.Base.BaseViewModel

@{
    ViewData["Title"] = "Edit Base";
}

<h2>Edit Base</h2>

<form asp-action="Edit" method="post">
    @* Hidden Id *@
    <input type="hidden" asp-for="Base.Id" />

    <div class="form-group">
        <label asp-for="Base.BaseName"></label>
        <input asp-for="Base.BaseName" class="form-control" />
        <span asp-validation-for="Base.BaseName" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Base.BaseNameLocal"></label>
        <input asp-for="Base.BaseNameLocal" class="form-control" />
        <span asp-validation-for="Base.BaseNameLocal" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
