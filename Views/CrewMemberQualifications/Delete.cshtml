@model FRAProject.Models.CrewMemberQualification

@{
    ViewData["Title"] = "Delete Qualification";
    var crewMemberName = $"{Model.CrewMember?.Captain} ({Model.CrewMember?.NickName})";
    var qualificationName = Model.Qualification?.Name;
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="CrewMembers" asp-action="Index">Crew Members</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-route-crewMemberId="@Model.CrewMemberId">@crewMemberName</a></li>
                    <li class="breadcrumb-item active">Delete @qualificationName</li>
                </ol>
            </nav>

            <h1>Delete Qualification</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="alert alert-danger">
                <h4 class="alert-heading">Warning!</h4>
                <p>Are you sure you want to delete this qualification? This action cannot be undone.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@qualificationName</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Crew Member</dt>
                        <dd class="col-sm-8">@crewMemberName</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-warning")">
                                @Model.Status
                            </span>
                        </dd>

                        <dt class="col-sm-4">Valid From</dt>
                        <dd class="col-sm-8">@Model.ValidFrom?.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Valid Until</dt>
                        <dd class="col-sm-8">
                            @if (Model.ValidUntil.HasValue)
                            {
                                @Model.ValidUntil.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Issued By</dt>
                        <dd class="col-sm-8">@Model.IssuedBy</dd>

                        <dt class="col-sm-4">Remarks</dt>
                        <dd class="col-sm-8">@Model.Remarks</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="mt-3">
                            <a asp-action="Index" asp-route-crewMemberId="@Model.CrewMemberId" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
