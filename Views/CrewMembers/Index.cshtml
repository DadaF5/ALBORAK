@model IEnumerable<FRAProject.Models.CrewMember>

@{
    ViewData["Title"] = "Crew Members";
    var currentSort = ViewData["CurrentSort"] as string ?? "name_asc";
    var currentFilter = ViewData["CurrentFilter"] as string ?? string.Empty;
    var pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    var pageSize = (int)(ViewData["PageSize"] ?? 25);
    var totalItems = (int)(ViewData["TotalItems"] ?? 0);
    var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

    Func<string, string> toggleSort = (key) =>
    {
        return currentSort == key + "_asc" ? key + "_desc" : key + "_asc";
    };
}

<h2>Crew Members</h2>

<div class="row mb-3">
    <div class="col-md-8">
        <form asp-action="Index" method="get" class="form-inline">
            <div class="input-group">
                <input type="text" name="searchString" value="@currentFilter" class="form-control" placeholder="Search by name, nickname, role, mobile or qualification..." />
                <input type="hidden" name="sortOrder" value="@currentSort" />
                <input type="hidden" name="pageNumber" value="1" />
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-4 text-right">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">Create New Crew Member</a>
        }
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@toggleSort("name")" asp-route-searchString="@currentFilter" asp-route-pageNumber="1">
                    NickName
                    @(currentSort == "name_asc" ? " ▲" : currentSort == "name_desc" ? " ▼" : "")
                </a>
            </th>
            <th>Person</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@toggleSort("squadron")" asp-route-searchString="@currentFilter" asp-route-pageNumber="1">
                    Squadron
                    @(currentSort == "squadron_asc" ? " ▲" : currentSort == "squadron_desc" ? " ▼" : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@toggleSort("type")" asp-route-searchString="@currentFilter" asp-route-pageNumber="1">
                    Type
                    @(currentSort == "type_asc" ? " ▲" : currentSort == "type_desc" ? " ▼" : "")
                </a>
            </th>
            <th>Primary Qualification</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@toggleSort("status")" asp-route-searchString="@currentFilter" asp-route-pageNumber="1">
                    Status
                    @(currentSort == "status_asc" ? " ▲" : currentSort == "status_desc" ? " ▼" : "")
                </a>
            </th>
            <th style="width:300px; text-align:center;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No crew members found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.NickName</td>
                    <td>@(item.Person != null ? (item.Person.FirstName + " " + item.Person.LastName) : "-")</td>
                    <td>@(item.Squadron != null ? item.Squadron.Name : "-")</td>
                    <td>@item.CrewMemberType</td>
                    <td>@(item.PrimaryQualification?.Name ?? "-")</td>
                    <td>@item.Status</td>
                    <td style="width:300px; text-align:center;">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning ml-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ml-1">Delete</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (totalPages > 1)
{
    <nav aria-label="Paging">
        <ul class="pagination">
            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)" asp-route-sortOrder="@currentSort" asp-route-searchString="@currentFilter">Previous</a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@p" asp-route-sortOrder="@currentSort" asp-route-searchString="@currentFilter">@p</a>
                </li>
            }

            <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)" asp-route-sortOrder="@currentSort" asp-route-searchString="@currentFilter">Next</a>
            </li>
        </ul>
    </nav>
}

<div class="text-muted">
    Showing page @pageNumber of @totalPages — @totalItems item(s).
</div>
