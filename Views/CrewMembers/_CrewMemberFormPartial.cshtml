@model FRAProject.Models.CrewMember

@* Shared form fields for Create/Edit. This partial does NOT include the <form> tag. *@

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-row">
    <div class="form-group col-md-2">
        <label asp-for="SequenceNo" class="control-label"></label>
        <input asp-for="SequenceNo" class="form-control" />
        <span asp-validation-for="SequenceNo" class="text-danger"></span>
    </div>

    <div class="form-group col-md-3">
        <label asp-for="NickName" class="control-label"></label>
        <input asp-for="NickName" class="form-control" />
        <span asp-validation-for="NickName" class="text-danger"></span>
    </div>

    <div class="form-group col-md-3">
        <label asp-for="Captain" class="control-label"></label>
        <input asp-for="Captain" class="form-control" />
        <span asp-validation-for="Captain" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="PersonId" class="control-label">Person</label>
        <select asp-for="PersonId" asp-items="@(ViewData["Persons"] as SelectList)" class="form-control">
            <option value="">-- Select Person --</option>
        </select>
        <small class="form-text text-muted">Each person can be assigned to at most one crew member.</small>
        <span asp-validation-for="PersonId" class="text-danger"></span>
    </div>
</div>

<div class="form-row">
    <div class="form-group col-md-4">
        <label asp-for="SquadronId" class="control-label">Squadron</label>
        <select asp-for="SquadronId" asp-items="@(ViewData["Squadrons"] as SelectList)" class="form-control">
            <option value="">-- Select Squadron --</option>
        </select>
        <span asp-validation-for="SquadronId" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="PrimaryQualificationId" class="control-label">Primary Qualification</label>
        <select asp-for="PrimaryQualificationId" asp-items="@(ViewData["Qualifications"] as SelectList)" class="form-control">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="PrimaryQualificationId" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="CrewMemberType" class="control-label">Type</label>
        <select asp-for="CrewMemberType" class="form-control" asp-items="@(ViewData["CrewMemberTypes"] as IEnumerable<SelectListItem>)">
            <option value="">-- Select Type --</option>
        </select>
        <span asp-validation-for="CrewMemberType" class="text-danger"></span>
    </div>
</div>

<div class="form-row">
    <div class="form-group col-md-4">
        <label asp-for="Role" class="control-label"></label>
        <input asp-for="Role" class="form-control" />
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="Mobile" class="control-label"></label>
        <input asp-for="Mobile" class="form-control" />
        <span asp-validation-for="Mobile" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="AllowedToSign" class="control-label"></label>
        <div class="form-check">
            <input asp-for="AllowedToSign" class="form-check-input" />
            <label asp-for="AllowedToSign" class="form-check-label"></label>
        </div>
        <span asp-validation-for="AllowedToSign" class="text-danger"></span>
    </div>
</div>

<div class="form-row">
    <div class="form-group col-md-4">
        <label asp-for="Status" class="control-label">Status</label>
        <select asp-for="Status" class="form-control" asp-items="@(ViewData["CrewMemberStatuses"] as IEnumerable<SelectListItem>)">
            <option value="">-- Select Status --</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label class="control-label">Photo (URL or upload)</label>
        <input asp-for="Photo" class="form-control" placeholder="Enter image URL to use or upload below" />
        <span asp-validation-for="Photo" class="text-danger"></span>

        <div class="mt-2">
            <label class="control-label">Upload photo</label>
            <input type="file" name="PhotoFile" accept="image/*" class="form-control-file" id="photoFileInput" />
        </div>

        <div id="photoPreviewWrapper" class="mt-2">
            <img id="photoPreview" src="@Model?.Photo" alt="Preview" style="max-height:120px; display:@(string.IsNullOrWhiteSpace(Model?.Photo) ? "none" : "block")" />
        </div>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="Active" class="control-label"></label>
        <div class="form-check">
            <input asp-for="Active" class="form-check-input" />
            <label asp-for="Active" class="form-check-label"></label>
        </div>
        <span asp-validation-for="Active" class="text-danger"></span>
    </div>
</div>
