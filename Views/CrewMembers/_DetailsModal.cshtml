@model FRAProject.Models.CrewMember

@{
    // make element IDs unique per model instance to avoid conflicts when other pages/components use same ids
    var suffix = Model.Id;
    string? photoSrc = null;
    if (!string.IsNullOrWhiteSpace(Model.Photo))
    {
        try { photoSrc = Url.Content(Model.Photo!); } catch { photoSrc = Model.Photo; }
    }
}

<div class="modal fade" id="cvModal-@suffix" tabindex="-1" role="dialog" aria-labelledby="cvModalLabel-@suffix" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div style="flex:1">
                    <h5 id="cvModalLabel-@suffix" class="modal-title">@Model.NickName — CV</h5>
                    <div class="small text-muted">@Model.CrewMemberType &nbsp;•&nbsp; @Model.Status</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(photoSrc))
                {
                    <img src="@photoSrc" alt="Photo of @Model.NickName" style="width:96px;height:96px;object-fit:cover;border-radius:6px;border:1px solid #ddd;margin-left:12px;" />
                }
                else
                {
                    <div style="width:96px;height:96px;border-radius:6px;border:1px solid #ddd;margin-left:12px;display:flex;align-items:center;justify-content:center;color:#6c757d;">
                        No photo
                    </div>
                }

                <button type="button"
                        class="modal-close btn btn-sm btn-link"
                        aria-label="Close"
                        data-dismiss="modal"
                        data-bs-dismiss="modal"
                        style="margin-left:8px;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <ul class="nav nav-tabs" id="cvTab-@suffix" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="tab-personal-@suffix"
                           data-toggle="tab" data-bs-toggle="tab"
                           href="#pane-personal-@suffix" role="tab"
                           aria-controls="pane-personal-@suffix" aria-selected="true">
                            Personal
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-flying-@suffix"
                           data-toggle="tab" data-bs-toggle="tab"
                           href="#pane-flying-@suffix" role="tab"
                           aria-controls="pane-flying-@suffix" aria-selected="false">
                            Flying experiences
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-quals-@suffix"
                           data-toggle="tab" data-bs-toggle="tab"
                           href="#pane-quals-@suffix" role="tab"
                           aria-controls="pane-quals-@suffix" aria-selected="false">
                            Qualifications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="tab-add-@suffix"
                           data-toggle="tab" data-bs-toggle="tab"
                           href="#pane-add-@suffix" role="tab"
                           aria-controls="pane-add-@suffix" aria-selected="false">
                            Additional
                        </a>
                    </li>
                </ul>

                <div class="tab-content mt-3" id="cvTabContent-@suffix">
                    <!-- Personal Tab -->
                    <div class="tab-pane fade show active" id="pane-personal-@suffix" role="tabpanel" aria-labelledby="tab-personal-@suffix">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Person</h6>
                                <dl class="row">
                                    <dt class="col-sm-4">Full name</dt>
                                    <dd class="col-sm-8">@((Model.Person != null) ? (Model.Person.FirstName + " " + Model.Person.LastName) : "—")</dd>

                                    <dt class="col-sm-4">Matricule</dt>
                                    <dd class="col-sm-8">@Model.Person?.Matricule"</dd>

                                    <dt class="col-sm-4">Rank</dt>
                                    <dd class="col-sm-8">@Model.Person?.Rank</dd>

                                    <dt class="col-sm-4">Country</dt>
                                    <dd class="col-sm-8">@Model.Person?.Country</dd>
                                </dl>
                            </div>

                            <div class="col-md-6">
                                <h6>Crew details</h6>
                                <dl class="row">
                                    <dt class="col-sm-4">NickName</dt>
                                    <dd class="col-sm-8">@Model.NickName</dd>

                                    <dt class="col-sm-4">Type</dt>
                                    <dd class="col-sm-8">@Model.CrewMemberType</dd>

                                    <dt class="col-sm-4">Status</dt>
                                    <dd class="col-sm-8">@Model.Status</dd>

                                    <dt class="col-sm-4">Allowed to sign</dt>
                                    <dd class="col-sm-8">@((Model.AllowedToSign) ? "Yes" : "No")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <!-- Flying experiences Tab (placeholder) -->
                    <div class="tab-pane fade" id="pane-flying-@suffix" role="tabpanel" aria-labelledby="tab-flying-@suffix">
                        <h6>Flying experiences</h6>
                        @if (Model.GetType().GetProperty("FlyingExperiences") != null)
                        {
                            var fx = (IEnumerable<dynamic>?)Model.GetType().GetProperty("FlyingExperiences")!.GetValue(Model);
                            if (fx != null && fx.Any())
                            {
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr><th>Type</th><th>Aircraft</th><th>Hours</th><th>From</th><th>To</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var e in fx)
                                        {
                                            <tr>
                                                <td>@(e.Type )</td>
                                                <td>@(e.Aircraft)</td>
                                                <td>@(e.Hours?.ToString())</td>
                                                <td>@(e.FromDate != null ? ((DateTime?)e.FromDate)?.ToString("dd-MM-yyyy") : "")</td>
                                                <td>@(e.ToDate != null ? ((DateTime?)e.ToDate)?.ToString("dd-MM-yyyy") : "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="small text-muted">No flying experience records available.</p>
                            }
                        }
                        else
                        {
                            <p class="small text-muted">Flying experiences are not modelled yet.</p>
                        }
                    </div>

                    <!-- Qualifications Tab -->
                    <div class="tab-pane fade" id="pane-quals-@suffix" role="tabpanel" aria-labelledby="tab-quals-@suffix">
                        <h6>Qualifications (by date of issue)</h6>
                        @if (Model.CrewMemberQualifications != null && Model.CrewMemberQualifications.Any())
                        {
                            var quals = Model.CrewMemberQualifications.OrderByDescending(q => q.ValidFrom);
                            <table class="table table-sm table-striped">
                                <thead><tr><th>Qualification</th><th>Issued</th><th>Valid until</th><th>Issued by</th><th>Remarks</th></tr></thead>
                                <tbody>
                                    @foreach (var q in quals)
                                    {
                                        <tr>
                                            <td>@(q.Qualification?.Name ?? q.QualificationId.ToString())</td>
                                            <td>@(q.ValidFrom?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td>@(q.ValidUntil?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td>@(q.IssuedBy ?? "-")</td>
                                            <td>@(q.Remarks ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="small text-muted">No qualifications recorded for this crew member.</p>
                        }
                    </div>

                    <!-- Additional Tab -->
                    <div class="tab-pane fade" id="pane-add-@suffix" role="tabpanel" aria-labelledby="tab-add-@suffix">
                        <h6>Additional information</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Other notes</dt>
                            <dd class="col-sm-8">@Model.Person?.Speciality ?? "—"</dd>
                            <dt class="col-sm-4">Custom</dt>
                            <dd class="col-sm-8">@Model.GetType().GetProperty("CustomField1")?.GetValue(Model) ?? "—"</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary modal-close no-print" data-dismiss="modal" data-bs-dismiss="modal">Close</button>

                <a class="btn btn-outline-secondary no-print"
                   href="@Url.Action("Print", "CrewMembers", new { id = Model.Id })"
                   target="_blank"
                   rel="noopener noreferrer">Print / Save as PDF</a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary no-print">Edit</a>
                }
            </div>
        </div>
    </div>
</div>