@model FRAProject.ViewModels.DepartmentViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Departments";
}

<div class="content-wrapper-fluid">

    <!-- PAGE HEADER -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Departments</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">Departments</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>


    <!-- MAIN CONTENT -->
    <section class="content">
        <div class="container-fluid">

            <!-- FILTERS -->
            <form asp-action="Index" method="get" class="form-inline mb-3">

                <!-- Base Filter -->
                <div class="form-group mr-2">
                    <label for="FilterBaseId" class="mr-2">Base:</label>
                    <select asp-for="FilterBaseId" asp-items="Model.Bases" class="form-control">
                        <option value="">-- All Bases --</option>
                    </select>
                </div>

                <!-- Search -->
                <div class="form-group mr-2">
                    <input type="text" name="searchTerm" value="@Model.SearchTerm"
                           class="form-control" placeholder="Search by name..." />
                </div>

                <button type="submit" class="btn btn-primary mr-2">Filter</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </form>


            <!-- TABLE CARD -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="card-title">Department List</h3>

                    <div class="card-tools">
                        <a asp-action="Create" class="btn btn-success btn-sm">
                            + Add New Department
                        </a>
                    </div>
                </div>

                <div class="card-body table-responsive p-0">

                    <table class="table table-hover table-bordered text-nowrap">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:50px">#</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Base</th>
                                <th style="width:150px">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int index = (Model.PageNumber - 1) * Model.PageSize;
                            }

                            @if (Model.Departments != null && Model.Departments.Any())
                            {
                                foreach (var d in Model.Departments)
                                {
                                    index++;
                                    <tr>
                                        <td>@index</td>
                                        <td>@d.Name</td>
                                        <td>@d.Description</td>
                                        <td>@d.Base?.BaseName</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@d.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@d.Id"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this department?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        No departments found.
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>


                <!-- PAGINATION -->
                <div class="card-footer clearfix">
                    @if (Model.TotalPages > 1)
                    {
                        <ul class="pagination pagination-sm m-0 float-right">

                            <!-- Previous -->
                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterBaseId="@Model.FilterBaseId">
                                    «
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-filterBaseId="@Model.FilterBaseId">
                                        @i
                                    </a>
                                </li>
                            }

                            <!-- Next -->
                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterBaseId="@Model.FilterBaseId">
                                    »
                                </a>
                            </li>

                        </ul>
                    }
                </div>

            </div>
        </div>
    </section>

</div>
