@model FRAProject.ViewModels.MedicalCheckVm.MedicalDashboardVm
@using FRAProject.Enums

@{
    ViewData["Title"] = "Medical Fitness Dashboard";
}

<h2 class="mb-4">Medical Fitness Dashboard</h2>

<!-- ============================= -->
<!-- KPI CARDS                    -->
<!-- ============================= -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="card border-success">
            <div class="card-body text-center text-success">
                <h3>@Model.FitCount</h3>
                <div>Fit</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-body text-center text-warning">
                <h3>@Model.ExpiringCount</h3>
                <div>Expiring soon</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-danger">
            <div class="card-body text-center text-danger">
                <h3>@Model.ExpiredCount</h3>
                <div>Expired / Unfit</div>
            </div>
        </div>
    </div>

</div>

<!-- ============================= -->
<!-- CREW GRID                    -->
<!-- ============================= -->
<table class="table table-sm table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Crew</th>
            <th>Squadron</th>
            <th>Status</th>
            <th>Remaining (days)</th>
            <th>Last Check</th>
            <th>Authority</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var crew in Model.Crew
                .OrderBy(c => c.RemainingDays))
        {
            bool isExpired = crew.FitnessStatus == MedicalFitnessStatus.Expired;
            bool isExpiring = crew.FitnessStatus == MedicalFitnessStatus.Fit
            && crew.RemainingDays <= 10;

            string badgeClass;
            string badgeText;

            if (isExpired)
            {
                badgeClass = "badge bg-danger";
                badgeText = "UNFIT";
            }
            else if (isExpiring)
            {
                badgeClass = "badge bg-warning text-dark";
                badgeText = "FIT";
            }
            else
            {
                badgeClass = "badge bg-success";
                badgeText = "FIT";
            }

            <tr>
                <td>
                    <strong>@crew.Name</strong>
                </td>

                <td>
                    @crew.Squadron
                </td>

                <td>
                    <span class="@badgeClass">@badgeText</span>
                </td>

                <td>
                    @crew.RemainingDays
                </td>

                <td>
                    @if (crew.LastCheckDate.HasValue)
                    {
                        <span>@crew.LastCheckDate.Value.ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <span class="text-danger">No medical</span>
                    }
                </td>

                <td>
                    @if (crew.CheckType.HasValue)
                    {
                        <span class="badge bg-secondary">@crew.CheckType</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td>
                    @if (crew.HasObesity)
                    {
                        <span class="badge bg-info">Obesity</span>
                    }

                    @if (crew.HasOpticalCorrection)
                    {
                        <span class="badge bg-info">Optical</span>
                    }

                    @if (crew.HasOpenBilans)
                    {
                        <span class="badge bg-secondary">Bilans</span>
                    }

                    @if (!crew.HasObesity &&
                                    !crew.HasOpticalCorrection &&
                                    !crew.HasOpenBilans)
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

