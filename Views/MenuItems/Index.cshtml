@model IEnumerable<FRAProject.ViewModels.MenuItemAdminViewModel>

@{
    ViewData["Title"] = "Menu Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Menu Items</h2>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Parent</th>
            <th>SortOrder</th>
            <th>Controller</th>
            <th>Action</th>
            <th>Url</th>
            <th>Roles</th>
            <th style="width:160px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MenuItem.Id</td>
                <td>@item.MenuItem.Title</td>
                <td>@(item.ParentTitle ?? "(root)")</td>
                <td>@item.MenuItem.SortOrder</td>
                <td>@item.MenuItem.Controller</td>
                <td>@item.MenuItem.Action</td>
                <td>@item.MenuItem.Url</td>
                <td>@item.MenuItem.Roles</td>
                <td>
                    <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.MenuItem.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.MenuItem.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
