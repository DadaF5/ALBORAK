@model FRAProject.ViewModels.OdvIndexVm
@{
    ViewData["Title"] = "Squadron Flying Program";
    bool isAdmin = User.IsInRole("Admin");
}

@* <h2 class="mb-3 text-center"></h2> *@

<!-- ============================= -->
<!-- FILTER / CONTEXT HEADER     -->
<!-- ============================= -->
<form method="get" asp-action="Index" class="row mb-3" id="dateForm">
    <div class="col-md-2">
        <label class="form-label">Date</label>
        <input type="date"
               name="odvDate"
               class="form-control"
               value="@(Model.SelectedDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))"
               onchange="this.form.submit()" />
       
    </div>
</form>

<!-- ============================= -->
<!-- ODV DETAILS (CREATE)         -->
<!-- ============================= -->
<div class="card mb-4" style="margin-top:0px;">
    <div class="card-header fw-bold" style="font-size:16px;">Squadron Daily Flying Program</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CreateModel.OdvDate" id="createOdvDate" />
            <div class="row g-3">
            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-2">
                    <label class="form-label">Aircraft Group</label>
                    <select asp-for="CreateModel.AcMainGroupId" required
                            class="form-control"
                            asp-items="Model.AcMainGroups">
                        <option value="">-- Select Group --</option>
                       
                        </select>
                        <span asp-validation-for="CreateModel.AcMainGroupId" class="text-danger"></span>

                </div>
                <div class="col-md-2">
                    <label class="form-label">Squadron</label>
                        <select asp-for="CreateModel.SquadronId" required
                            class="form-control"
                            asp-items="Model.Squadrons">
                        <option value="">-- Select Squadron --</option>                      

                    </select>
                        <span asp-validation-for="CreateModel.SquadronId" class="text-danger"></span>
                </div>

                

            }
            else
            {
                    <input type="hidden" asp-for="CreateModel.SquadronId" />
                    <input type="hidden" asp-for="CreateModel.AcMainGroupId" />
                <div class="row mb-4">
                    <div class="col-md-4">
                        <strong>Squadron:</strong> @ViewBag.SquadronName
                    </div>
                    <div class="col-md-4">
                        <strong>Aircraft Group:</strong> @ViewBag.AcMainGroupName
                    </div>
                    
                </div>

            }
               
                <div class="col-md-2">
                    <label class="form-label">Call Sign</label>
                    <select asp-for="CreateModel.CallSignId" class="form-control"
                            asp-items="Model.CallSigns" required></select>
                    <span asp-validation-for="CreateModel.CallSignId" class="text-danger"></span>
                </div>

            </div>
            <div class="row g-3">                

                <div class="col-md-2">
                    <label class="form-label">Mission</label>
                    <select asp-for="CreateModel.MissionId" class="form-control"
                            asp-items="Model.Missions" required></select>
                    <span asp-validation-for="CreateModel.MissionId" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Area</label>
                    <input asp-for="CreateModel.Area" class="form-control" required />
                    <span asp-validation-for="CreateModel.Area" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label">TOFF</label>
                    <input asp-for="CreateModel.TOFF" type="time" class="form-control" required />
                    <span asp-validation-for="CreateModel.TOFF" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Obs</label>
                    <input asp-for="CreateModel.Obs" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Add</label>
                    <button type="submit" class="btn btn-success w-100">+ Create</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ============================= -->
<!-- PLANNED ODVs GRID            -->
<!-- ============================= -->
<table class="table table-bordered table-sm">
    <thead class="table-primary text-center">
        <tr>
            <th>Mission</th>
            <th>TOFF</th>
            <th>Call Sign</th>
            <th>Area</th>
            <th>Status</th>
            <th>Actions</th>

        </tr>
    </thead>
    <tbody>
        @if (!Model.Odvs.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No ODVs planned.</td>
            </tr>
        }
        else
        {
            foreach (var odv in Model.Odvs)
            {
                <tr>
                    <td>@odv.Mission?.Name</td>
                    <td>@odv.TOFF</td>
                    <td>@odv.CallSign?.Code</td>
                    <td>@odv.Area</td>
                    <td>@odv.OdvStatus</td>
                    <td class="text-center">
                        <a asp-action="Edit"
                           asp-route-id="@odv.Id"
                           asp-route-odvDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>
                    </td>
                </tr>                

                <tr>
                    <td colspan="6">
                        <table class="table table-sm table-bordered mb-2">
                            <thead class="table-light">
                                <tr>
                                    <th>Sortie</th>
                                    <th>Configuration</th>
                                    <th>Crew</th>
                                    <th>Status</th>
                                    <th>Aircraft Type</th>
                                    <th style="width:120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (odv.Sorties == null || !odv.Sorties.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted text-center">
                                            No sorties planned
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="table-light">
                                            <strong>Crew:</strong>
                                            <span class="text-muted">No crew assigned</span>
                                    </tr>
                                    <tr>
                                        <td colspan="6">
                                           </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var sortie in odv.Sorties)
                                    {
                                        <tr>
                                            <td>@sortie.Id</td>
                                            <td>@sortie.Configuration</td>
                                            <td>
                                                @sortie.SortieCrews.Count crew
                                            </td>
                                            <td>@sortie.Status</td>
                                            <td>@sortie.AcType?.Name</td>

                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" disabled>
                                                    Edit
                                                </button>
                                            </td>
                                        </tr>

                                        <tr class="table-light">
                                            <td colspan="6">
                                                <strong>Crew:</strong>

                                                @if (sortie.SortieCrews == null || !sortie.SortieCrews.Any())
                                                {
                                                    <span class="text-muted">No crew assigned</span>
                                                }
                                                else
                                                {
                                                    <table class="table table-sm table-bordered mt-2 mb-2">
                                                        <thead>
                                                            <tr>
                                                                <th>Seat</th>
                                                                <th>Name</th>
                                                                <th>Role</th>
                                                                <th>Primary</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var sc in sortie.SortieCrews)
                                                            {
                                                                <tr>
                                                                    <td>@sc.Seat</td>
                                                                    <td>@sc.CrewMember?.Captain</td>
                                                                    <td>@sc.AircraftRole</td>
                                                                    <td>
                                                                        @(sc.IsPrimary ? "✔" : "")
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            </td>
                                        </tr>

                                        <tr>
                                            <td colspan="6">
                                                <form asp-action="AddCrew" method="post" class="row g-2 align-items-end">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="SortieId" value="@sortie.Id" />
                                                    <input type="hidden" name="odvDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                                                    <!-- Crew member -->
                                                    <div class="col-md-3">
                                                        <label class="form-label">Crew</label>
                                                        <select name="CrewMemberId" class="form-control form-control-sm" required>
                                                            <option value="">-- Select Crew --</option>
                                                            @foreach (var cm in Model.CrewMembers)
                                                            {
                                                                <option value="@cm.Value">@cm.Text</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <!-- Seat -->
                                                    <div class="col-md-2">
                                                        <label class="form-label">Seat</label>
                                                        <select name="Seat" class="form-control form-control-sm" required>
                                                            <option value="">-- Seat --</option>
                                                            <option value="Front">Front</option>

                                                            @* Rear seat only if AcType allows *@
                                                            @if (sortie.AcType?.SeatCount == 2)
                                                            {
                                                                <option value="Rear">Rear</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <!-- Aircraft role -->
                                                    <div class="col-md-3">
                                                        <label class="form-label">Role</label>
                                                        <select name="AircraftRole" class="form-control form-control-sm" required>
                                                            @foreach (var role in Enum.GetValues(typeof(FRAProject.Enums.AircraftRole)))
                                                            {
                                                                <option value="@role">@role</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <!-- Primary -->
                                                    <div class="col-md-2">
                                                        <label class="form-label">Primary</label>
                                                        <div class="form-check">
                                                            <input type="checkbox" name="IsPrimary" class="form-check-input" />
                                                            <label class="form-check-label">Captain</label>
                                                        </div>
                                                    </div>

                                                    <!-- Submit -->
                                                    <div class="col-md-2">
                                                        <button type="submit" class="btn btn-sm btn-primary w-100">
                                                            + Crew
                                                        </button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>

                                    }
                                }
                            </tbody>
                        </table>

                        <!-- ADD SORTIE -->
                        <form asp-action="AddSortie" method="post" class="row g-2">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="OdvId" value="@odv.Id" />

                            <div class="col-md-1">
                                <input name="SortieCode"
                                       class="form-control form-control-sm"
                                       placeholder="A"
                                       required />
                            </div>

                            <!-- 🔑 Aircraft Type -->
                            <div class="col-md-2">
                                <select name="AcTypeId"
                                        class="form-control form-control-sm"
                                        required>
                                    <option value="">Type</option>
                                    @foreach (var t in Model.AcTypes)
                                    {
                                        <option value="@t.Value">@t.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <input name="Configuration"
                                       class="form-control form-control-sm"
                                       placeholder="Configuration"
                                       required />
                            </div>

                            <div class="col-md-2">
                                <input name="Sequence"
                                       type="number"
                                       min="1"
                                       class="form-control form-control-sm"
                                       placeholder="Seq" />
                            </div>

                            <div class="col-md-2">
                                <input name="PlannedFuel"
                                       type="number"
                                       step="0.1"
                                       class="form-control form-control-sm"
                                       placeholder="Fuel" />
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    + Sortie
                                </button>
                            </div>
                        </form>

                    </td>
                </tr>
            }
        }
    </tbody>
</table>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
   
}



