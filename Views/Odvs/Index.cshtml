@model FRAProject.ViewModels.OdvIndexVm
@{
    ViewData["Title"] = "Squadron Flying Program";
}

<div class="text-center mb-4">
    <h1>Squadron Flying Program</h1>
    <div class="d-flex justify-content-center align-items-center gap-5 mt-3">
        <div>
            <div class="small text-muted">Squadron</div>
            <div>@(Model.SelectedSquadronId.HasValue ? (Model.Squadrons.FirstOrDefault(s => s.Value == Model.SelectedSquadronId.ToString())?.Text ?? "") : "")</div>
        </div>
        <div>
            <div class="small text-muted">Date</div>
            <div>@(Model.SelectedDate?.ToString("dd-MM-yyyy") ?? "")</div>
        </div>
        <div>
            <div class="small text-muted">Aircraft main Group</div>
            <div>@(Model.SelectedAcMainGroupId.HasValue ? (Model.AcMainGroups.FirstOrDefault(g => g.Value == Model.SelectedAcMainGroupId.ToString())?.Text ?? "") : "")</div>
        </div>
    </div>
</div>

<div class="mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Date</label>
            <input type="date" name="odvDate" class="form-control" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Squadron</label>
            <select name="squadronId" class="form-select">
                <option value="">-- all --</option>
                @foreach (var s in Model.Squadrons)
                {
                    var isSel = Model.SelectedSquadronId.HasValue && Model.SelectedSquadronId.ToString() == s.Value;
                    if (isSel)
                    {
                        <option value="@s.Value" selected="selected">@s.Text</option>
                    }
                    else
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Aircraft Main Group</label>
            <select name="acMainGroupId" class="form-select">
                <option value="">-- all --</option>
                @foreach (var g in Model.AcMainGroups) 
                {
                    var isSelected = Model.SelectedAcMainGroupId.HasValue && Model.SelectedAcMainGroupId.ToString() == g.Value;
                    if (isSelected)
                    {
                        <option value="@g.Value" selected="selected">@g.Text</option>
                    }
                    else
                    {
                        <option value="@g.Value">@g.Text</option>
                    }

                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Reset</a>
            <a asp-action="Create" class="btn btn-success float-end">Create ODV</a>
        </div>
    </form>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="border p-3">
            @{ await Html.RenderPartialAsync("_OdvDetailsPartial", Model); }
        </div>
    </div>
    <div class="col-md-6">
        <div class="border p-3">
            @{ await Html.RenderPartialAsync("_SortieDetailsPartial", Model); }
        </div>
    </div>
</div>

@if (!Model.Odvs.Any())
{
    <div class="alert alert-info">No ODVs for the selected filters.</div>
}
else
{
    <table class="table table-bordered table-sm">
        <thead class="table-primary">
            <tr>
                <th>Delete</th>
                <th>Edit</th>
                <th>Mission</th>
                <th>TOFF</th>
                <th>Call-Sign</th>
                <th>Area</th>
                <th>PRV</th>
                <th>Status</th>
                <th style="width:400px">Sortie Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Odvs)
            {
                <tr>
                    <td>
                        <form asp-action="DeleteOdv" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Delete ODV?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">X</button>
                        </form>
                    </td>
                    <td><a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-warning btn-sm">✎</a></td>
                    <td>@(o.Mission?.Name ?? "MSN-" + o.Id)</td>
                    <td>@(o.TOFF?.ToString(@"hh\:mm") ?? "-")</td>
                    <td>@o.CallSign</td>
                    <td>@o.Area</td>                    
                    <td>@o.OdvStatus.ToString()</td>

                    <td>
                        @* Nested table for sortie details *@
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr class="table-secondary">
                                    <th>Id</th>
                                    <th>Pilot</th>
                                    <th>Copilot</th>
                                    <th>AcType</th>
                                    <th>Fuel</th>
                                    <th>Config</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (o.Sorties != null && o.Sorties.Any())
                                {
                                    foreach (var s in o.Sorties)
                                    {
                                        <tr>
                                            <td>@s.Id.ToString("D3")</td>
                                            <td>@(s.SortieCrews?.FirstOrDefault(sc => sc.IsPrimary == true)?.CrewMember? .Captain ?? "--")</td>
                                            <td>@(s.SortieCrews?.Where(sc => !sc.IsPrimary).FirstOrDefault()?.CrewMember?.Captain ?? "--")</td>
                                            <td>@(s.Aircraft?.AcType?.Name ?? "--")</td>
                                            <td>@(s.FuelQuantity?.ToString() ?? "-")</td>
                                            <td>@(s.Configuration ?? "-")</td>
                                            <td>
                                                <form asp-action="DeleteSortie" method="post" onsubmit="return confirm('Delete sortie?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="sortieId" value="@s.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm">X</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="7" class="text-muted">No sorties</td></tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}