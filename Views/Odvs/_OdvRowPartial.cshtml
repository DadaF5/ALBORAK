@model FRAProject.Models.Odv
<div class="odv-row" data-odv-id="@Model.Id">
    <div><strong>ODV @Model.Id</strong> @Model.OdvDate.ToString("yyyy-MM-dd")</div>
    <div>Area: @Model.Area</div>
    <div>
        <button class="btn btn-sm btn-primary btn-add-sortie" data-odv-id="@Model.Id">Add Sortie</button>
    </div>
    <div class="mt-2">
        @if (Model.Sorties != null && Model.Sorties.Any())
        {
            <table class="table table-sm">
                <thead><tr><th>Id</th><th>Ac</th><th>Start</th><th>Crew</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Sorties)
                    {
                        <tr data-sortie-id="@s.Id">
                            <td>@s.Id</td>
                            <td>@(s.Aircraft?.DisplayName ?? "-")</td>
                            <td>@(s.StartTime?.ToString("HH:mm") ?? "-")</td>
                            <td>
                                @if (s.SortieCrews?.Any() == true)
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var sc in s.SortieCrews)
                                        {
                                            <li>@(sc.CrewMember?.Captain ?? ("Id:" + sc.CrewMemberId))</li>
                                        }
                                    </ul>
                                }
                                else
                                {

                                    <span class="text-muted">No crew</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-secondary btn-add-crew" data-sortie-id="@s.Id">Add Crew</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
