@model FRAProject.ViewModels.AircraftSelectVm

@*
  Partial view for selecting an aircraft for a sortie.
  - Shows all aircraft with status badges.
  - Only aircraft with status == Available (green) can be selected.
  - This partial is intended to be returned as a modal partial (no layout).
*@

<div class="modal" tabindex="-1" role="dialog" aria-modal="true" style="display:block;">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Aircraft for Sortie @Model.SortieId</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2">
                    <small class="text-muted">Only green (Available) aircraft can be selected. Other aircraft are shown for awareness.</small>
                </div>

                <div class="row g-2">
                    @foreach (var a in Model.Aircrafts)
                    {
                        var status = a.Status;
                        string badgeClass;
                        string statusText = status.ToString();

                        switch (status)
                        {
                            case FRAProject.Models.AircraftStatus.Available:
                                badgeClass = "badge bg-success";
                                break;
                            case FRAProject.Models.AircraftStatus.Assigned:
                                badgeClass = "badge bg-warning text-dark";
                                break;
                            case FRAProject.Models.AircraftStatus.Airborne:
                                badgeClass = "badge bg-danger";
                                break;
                            case FRAProject.Models.AircraftStatus.Unserviceable:
                                badgeClass = "badge bg-dark";
                                break;
                            default:
                                badgeClass = "badge bg-secondary";
                                break;
                        }

                        var selectable = status == FRAProject.Models.AircraftStatus.Available;
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="card h-100 aircraft-card @(selectable ? "selectable" : "not-selectable")" data-aircraft-id="@a.Id" style="cursor:@(selectable ? "pointer" : "not-allowed");">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="card-title mb-0">@Html.Raw(System.Net.WebUtility.HtmlEncode(a.Registration ?? ("AC#" + a.Id)))</h6>
                                            <small class="text-muted">@Html.Raw(System.Net.WebUtility.HtmlEncode(a.AcType ?? ""))</small>
                                        </div>
                                        <div>
                                            <span class="@badgeClass">@statusText</span>
                                        </div>
                                    </div>

                                    <div class="mt-auto">
                                        @if (selectable)
                                        {
                                            <button type="button" class="btn btn-sm btn-success select-aircraft-btn w-100" data-aircraft-id="@a.Id">Select</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary w-100" disabled>Not available</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
