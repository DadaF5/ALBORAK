@model FRAProject.ViewModels.OdvCreateVm

@* This partial returns the modal content the controller expects for AJAX/modal flows.
   It reuses the same form partial so Create/Edit share identical markup. *@

<div class="modal" tabindex="-1" role="dialog" style="display:block;">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create ODV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Partial("_CreateEditForm", Model)
            </div>
        </div>
    </div>
</div>
