@model List<FRAProject.ViewModels.PersonViewModel>

<table class="table table-bordered table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Photo</th>
            <th>Full Name</th>
            <th>Matricule</th>
            <th>Rank</th>
            <th>Sub-Department</th>
            <th>Department</th>
            <th>Base</th>
            <th>Gender</th>
            <th>Patrimonial Status</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>
                        @if (p.Photo != null && p.Photo.Length > 0)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(p.Photo)"
                                 class="img-thumbnail" style="max-width:60px;" />
                        }
                        else
                        {
                            <span class="text-muted">No Photo</span>
                        }
                    </td>
                    <td>@p.FirstName @p.LastName</td>
                    <td>@p.Matricule</td>
                    <td>@p.RankName</td>
                    <td>@p.SubDepartmentName</td>
                    <td>@p.DepartmentName</td>
                    <td>@p.BaseName</td>
                    <td>@p.Gender</td>
                    <td>@p.PatrimonialStatus</td>
                    <td>
                        @if (p.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", new { id = p.Id })">Edit</a>
                        <a class="btn btn-sm btn-info" href="@Url.Action("Details", new { id = p.Id })">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">No records found</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if ((int)Math.Ceiling((double)(ViewBag.TotalCount ?? 0) / (ViewBag.PageSize ?? 10)) > 1)
{
    int totalPages = (int)Math.Ceiling((double)(ViewBag.TotalCount ?? 0) / (ViewBag.PageSize ?? 10));
    int currentPage = ViewBag.Page ?? 1;

    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a href="#" class="page-link" data-page="@(currentPage - 1)">Previous</a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a href="#" class="page-link" data-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a href="#" class="page-link" data-page="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
