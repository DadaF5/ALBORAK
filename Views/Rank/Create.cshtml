@model FRAProject.ViewModels.Rank.RankViewModel

<h2>Create Rank</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Full Rank</label>
        <input asp-for="FullRank" class="form-control" />
        <span asp-validation-for="FullRank" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Sequence</label>
        <input asp-for="Sequence" class="form-control" type="number" />
        <span asp-validation-for="Sequence" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Rank Type</label>
        <select asp-for="RankTypeId" asp-items="Model.RankTypes" class="form-control">
            <option value="">-- Select Rank Type --</option>
        </select>
        <span asp-validation-for="RankTypeId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-3">Save</button>
</form>
