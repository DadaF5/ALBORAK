@* Views/Roles/Create.cshtml *@
@model RoleFormDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nouveau Rôle";
}

<div class="content-header"><h1>🔑 Nouveau Rôle</h1></div>

<div class="card card-primary card-outline">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label>Nom du Rôle <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="ex. Inspecteur" />
            </div>
            <button type="submit" class="btn btn-primary">Créer</button>
            <a asp-action="Index" class="btn btn-secondary">Annuler</a>
        </form>
    </div>
</div>