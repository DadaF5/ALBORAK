@* Views/Roles/Delete.cshtml *@
@model Microsoft.AspNetCore.Identity.IdentityRole
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Supprimer le Rôle";
    bool isProtected = ViewBag.IsProtected;
    int userCount = ViewBag.UserCount;
}

<div class="content-header"><h1>🗑 Supprimer le Rôle</h1></div>

<div class="card card-danger card-outline">
    <div class="card-body">
        <p>Confirmer la suppression du rôle <strong>@Model.Name</strong> ?</p>

        @if (isProtected)
        {
            <div class="alert alert-warning">Ce rôle est protégé et ne peut pas être supprimé.</div>
            <a asp-action="Index" class="btn btn-secondary">Retour</a>
        }
        else if (userCount > 0)
        {
            <div class="alert alert-warning">
                Impossible de supprimer — ce rôle est assigné à <strong>@userCount</strong> utilisateur(s).
                Retirez-le d'abord de leurs comptes.
            </div>
            <a asp-action="Index" class="btn btn-secondary">Retour</a>
        }
        else
        {
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Confirmer la Suppression</button>
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </form>
        }
    </div>
</div>