@* Views/Roles/Index.cshtml *@
@model List<RoleListVm>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Rôles";
}

<div class="content-header d-flex justify-content-between align-items-center">
    <h1>🔑 Rôles Utilisateurs</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nouveau Rôle</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Rôle</th><th>Utilisateurs</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@(r.IsProtected ? "border-left-warning" : "")" style="border-left-width:4px;">
                        <td>
                            @r.Name
                            @if (r.IsProtected)
                            {
                                <span class="badge badge-warning ml-2">Protégé</span>
                            }
                        </td>
                        <td>@r.UserCount</td>
                        <td>
                            @if (!r.IsProtected)
                            {
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-info">Modifier</a>
                                <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-danger">Supprimer</a>
                            }
                            else
                            {
                                <span class="text-muted">Protégé — non modifiable</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>