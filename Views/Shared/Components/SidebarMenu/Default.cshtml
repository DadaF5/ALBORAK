@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool IsSettingsActive() =>
        string.Equals(currentArea, "Settings", StringComparison.OrdinalIgnoreCase);
}

<nav class="sidebar">

    <!-- Logo -->
    <div class="sidebar-logo">
        <div class="logo-icon">✈</div>
        <div class="logo-text">
            <span class="name">AL-BORAK</span>
            <span class="sub">GMAO / FRA</span>
        </div>
    </div>

    <!-- NAVIGATION -->
    <div class="sidebar-section">
        <div class="sidebar-section-label">Navigation principale</div>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">📊</span>
            <span>Tableau de bord</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">✈</span>
            <span>Flotte</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">🔧</span>
            <span>Maintenance</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">📋</span>
            <span>Opérations</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">🏥</span>
            <span>Médical</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">🛡</span>
            <span>Navigabilité</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">⚡</span>
            <span>SGS</span>
        </a>

        <a href="#" class="nav-item" style="text-decoration:none;">
            <span class="nav-icon">🧪</span>
            <span>PMEL</span>
        </a>
    </div>

    <!-- SYSTÈME -->
    <div class="sidebar-section">
        <div class="sidebar-section-label">Système</div>

        <a asp-area="Settings"
           asp-controller="Home"
           asp-action="Index"
           class="nav-item @(IsSettingsActive() ? "active" : "")"
           style="text-decoration:none;">
            <span class="nav-icon">⚙</span>
            <span>Paramètres système</span>
        </a>
    </div>

    <!-- Footer user card -->
    <div class="sidebar-footer">
        <div class="user-card">
            <div class="user-avatar">
                @{
                    var initials = User?.Identity?.Name?.Length > 0
                        ? User.Identity.Name.Substring(0, 1).ToUpper()
                        : "U";
                }
                @initials
            </div>
            <div class="user-info">
                <div class="name">@(User?.Identity?.Name ?? "Utilisateur")</div>
                <div class="role">@(User?.Identity?.IsAuthenticated == true ? "Connecté" : "Non connecté")</div>
            </div>
        </div>
    </div>

</nav>
