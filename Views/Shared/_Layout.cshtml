                           asp-controller="WorkOrders"
                           asp-action="Index"
                           title="Ordres de Travail">
                            <span class="nav-icon">🔧</span>
                            <span class="nav-text">Ordres de Travail</span>
                        </a>

                        @* <a class="nav-item @IsActive("PEA", "Home")"
                           asp-area="PEA"
                           asp-controller="Home"
                           asp-action="Index"
                           title="Programme PEA">
                            <span class="nav-icon">📋</span>
                            <span class="nav-text">Programme PEA</span>
                        </a> *@

                        @* <a class="nav-item @IsActive("CRM", "Defauts")"
                           asp-area="CRM"
                           asp-controller="Defauts"
                           asp-action="Index"
                           title="CRM / Défauts">
                            <span class="nav-icon">🧰</span>
                            <span class="nav-text">CRM / Défauts</span>
                            <span class="nav-badge badge-red">12</span>
