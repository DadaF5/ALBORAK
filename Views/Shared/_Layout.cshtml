       style="bottom: 20px; right: 20px; z-index: 1050;">
        🐛 Signaler un problème
    </a>
    <script>
        (function () {
            // =========================
            // Element references
            // =========================
            const body = document.body;
            const sidebarToggle = document.getElementById('sidebarToggle');
            const userMenu = document.getElementById('topbarUserMenu');
            const userTrigger = document.getElementById('topbarUserTrigger');

            // =========================
            // Local storage keys
            // =========================
            const sidebarStorageKey = 'gmao.sidebar.collapsed';
            const groupStorageKey = 'gmao.sidebar.groups';

            // =========================
            // Sidebar collapse / expand
            // =========================
            function applySidebarState(collapsed) {
                body.classList.toggle('sidebar-collapsed', collapsed);

                if (sidebarToggle) {
                    sidebarToggle.setAttribute('aria-expanded', (!collapsed).toString());
                }
            }

            // =========================
            // Menu groups
            // =========================
            function getGroups() {
                return Array.from(document.querySelectorAll('[data-group]'));
            }

            function applyGroup(group, open) {
                const menu = group.querySelector('[data-group-menu]');
                const toggle = group.querySelector('[data-group-toggle]');

                group.classList.toggle('open', open);

                if (menu && !body.classList.contains('sidebar-collapsed')) {
                    menu.style.display = open ? 'block' : 'none';
                }

                if (toggle) {
                    toggle.setAttribute('aria-expanded', open.toString());
                }
            }

            function saveGroupState() {
                const state = {};
                getGroups().forEach((group, index) => {
                    state[index] = group.classList.contains('open');
                });
                localStorage.setItem(groupStorageKey, JSON.stringify(state));
            }

            function restoreGroupState() {
                const saved = localStorage.getItem(groupStorageKey);
                if (!saved) return;

                try {
                    const parsed = JSON.parse(saved);
                    getGroups().forEach((group, index) => {
                        if (Object.prototype.hasOwnProperty.call(parsed, index)) {
                            applyGroup(group, !!parsed[index]);
                        }
                    });
                } catch (error) {
                    console.warn('Impossible de restaurer l’état du menu latéral.', error);
                }
            }

            // =========================
            // Initialize sidebar state
            // =========================
            if (sidebarToggle) {
                const savedSidebarState = localStorage.getItem(sidebarStorageKey);
                applySidebarState(savedSidebarState === 'true');

                sidebarToggle.addEventListener('click', function () {
                    const collapsed = !body.classList.contains('sidebar-collapsed');
                    applySidebarState(collapsed);
                    localStorage.setItem(sidebarStorageKey, collapsed.toString());

                    if (!collapsed) {
                        getGroups().forEach(function (group) {
                            const isOpen = group.classList.contains('open');
                            const menu = group.querySelector('[data-group-menu]');
                            if (menu) {
                                menu.style.display = isOpen ? 'block' : 'none';
                            }
                        });
                    }
                });
            }

            // =========================
            // Group toggle behavior
            // =========================
            getGroups().forEach(function (group) {
                const toggle = group.querySelector('[data-group-toggle]');
                if (!toggle) return;

                toggle.addEventListener('click', function () {
                    if (body.classList.contains('sidebar-collapsed') && window.innerWidth > 991.98) {
                        return;
                    }

                    const isOpen = group.classList.contains('open');
                    applyGroup(group, !isOpen);
                    saveGroupState();
                });
            });

            // =========================
            // User dropdown
            // =========================
            if (userMenu && userTrigger) {
                userTrigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = userMenu.classList.toggle('open');
                    userTrigger.setAttribute('aria-expanded', isOpen.toString());
                });

                document.addEventListener('click', function (e) {
                    if (!userMenu.contains(e.target)) {
                        userMenu.classList.remove('open');
                        userTrigger.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            // =========================
            // Restore saved group state
            // =========================
            restoreGroupState();
        })();
    </script>

    <!-- Core scripts — jQuery MUST load before Bootstrap/AdminLTE and before
         any page's @@section Scripts (e.g. _ValidationScriptsPartial), since
         jquery.validate.min.js assumes jQuery is already globally defined. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* adminlte.min.js intentionally NOT included — this layout uses a fully
       custom shell (app-shell / sidebar / menu-group with its own JS toggle
       logic above), not AdminLTE's official skeleton. Loading adminlte.min.js
       caused it to run layout-height init routines against a DOM structure
       it doesn't recognize, which broke the page's vertical scroll. Only
       jQuery + Bootstrap are actually needed here (validation + Collapse). *@
    @*     "D:\ALBORAK\wwwroot\lib\dist\js\adminlte.min.js"
 *@    @RenderSection("Scripts", required: false)
</body>
