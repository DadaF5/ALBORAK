@using System.Security.Claims
@{
    // =========================
    // Current route information
    // =========================
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // =========================
    // Helper: active menu item
    // =========================
    string IsActive(string area, string controller, string action = "Index")
    {
        return string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

    // ==========================================
    // Default behavior: all groups open on load
    // ==========================================
    var overviewOpen = true;
    var flotteOpen = true;
    var navigabiliteOpen = true;
    var operationsOpen = true;
    var administrationOpen = true;

    // =========================
    // Display name for top bar
    // =========================
    var displayName =
        User.FindFirst("full_name")?.Value ??
        User.FindFirst("name")?.Value ??
        User.FindFirst(ClaimTypes.GivenName)?.Value ??
        User.Identity?.Name ??
        "Utilisateur";
}
<!doctype html>
<html lang="fr">
<head>
    <!-- HEAD START -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AL-BORAK</title>

    <link href="~/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/css/custom.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/gmao_fra.css" asp-append-version="true" />
    <style>
        /* =========================================
                                       ROOT VARIABLES
                            ========================================= */
        :root {
            --sidebar-width: 290px;
            --sidebar-collapsed-width: 58px;
            --submenu-bg: rgba(255,255,255,0.04);
            --menu-hover: rgba(255,255,255,0.08);
            --menu-active: rgba(255,255,255,0.14);
            --panel-bg: #121826;
            --panel-border: rgba(255,255,255,0.08);
            --text-muted: rgba(255,255,255,0.65);
            --flyout-bg: #182131;
            --flyout-shadow: 0 12px 32px rgba(0,0,0,0.35);
            --topbar-height: 64px;
        }

        /* =========================================
                                       PAGE LAYOUT
                            ========================================= */

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            overflow-x: hidden;
        }

        .app-shell {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        .main {
            width: calc(100% - var(--sidebar-width));
            min-width: 0;
            display: flex;
            flex-direction: column;
            transition: width .22s ease;
            overflow-x: hidden;
        }

        .content {
            flex: 1;
            padding: 24px;
            overflow-x: hidden;
        }

        body.sidebar-collapsed .main {
            width: calc(100% - var(--sidebar-collapsed-width));
        }

        /* =========================================
                                       SIDEBAR
                            ========================================= */

        .sidebar {
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            flex-shrink: 0;
            overflow: visible;
            transition: width .22s ease, min-width .22s ease, max-width .22s ease, transform .22s ease;
            position: relative;
            border-right: 1px solid var(--panel-border);
            z-index: 1200;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            min-height: 92px;
            border-bottom: 1px solid var(--panel-border);
        }

        .sidebar-logo-image {
            width: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .sidebar-logo-image img {
                max-width: 52px;
                max-height: 52px;
                width: auto;
                height: auto;
                object-fit: contain;
            }

        .logo-text {
            min-width: 0;
        }

        .sidebar-section {
            padding: 10px 8px;
        }

        .menu-group {
            margin-bottom: 6px;
            position: relative;
        }

        .menu-group-toggle {
            width: 100%;
            min-height: 40px;
            border: 0;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 10px;
            color: inherit;
            cursor: pointer;
            text-align: left;
        }

            .menu-group-toggle:hover {
                background: var(--menu-hover);
            }

        .menu-group-title {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-width: 0;
        }

        .menu-group-label {
            font-weight: 600;
            letter-spacing: .02em;
            white-space: nowrap;
            font-size: .92rem;
        }

        .menu-group-arrow {
            transition: transform .2s ease;
            font-size: .9rem;
        }

        .menu-group.open .menu-group-arrow {
            transform: rotate(90deg);
        }

        .submenu {
            margin-top: 4px;
            padding: 4px;
            border-radius: 12px;
            background: var(--submenu-bg);
        }

            .submenu .nav-item {
                margin-bottom: 2px;
            }

                .submenu .nav-item:last-child {
                    margin-bottom: 0;
                }

        .nav-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-height: 38px;
            padding: 8px 10px;
            border-radius: 10px;
            text-decoration: none;
            color: inherit;
            transition: background-color .18s ease, color .18s ease;
            position: relative;
        }

            .nav-item:hover {
                text-decoration: none;
                color: inherit;
                background: var(--menu-hover);
            }

            .nav-item.active {
                background: var(--menu-active);
                font-weight: 600;
            }

        .nav-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            min-width: 18px;
            font-size: 15px;
        }

        .nav-text {
            flex: 1;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .nav-badge {
            margin-left: auto;
        }

        /* =========================================
                                       TOPBAR
                            ========================================= */

        .topbar {
            min-height: var(--topbar-height);
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 16px;
            border-bottom: 1px solid var(--panel-border);           
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-shrink: 0;
        }

        .topbar-title {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-width: 0;
        }

        .topbar-title-text {
            font-size: 1.1rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .topbar-breadcrumb {
            margin-top: 2px;
            font-size: .82rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .sidebar-toggle,
        .icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border: 1px solid var(--panel-border);
            border-radius: 10px;
            background: var(--panel-bg);
            color: inherit;
            cursor: pointer;
            flex-shrink: 0;
        }

            .icon-btn.disabled {
                opacity: 0.4;
                cursor: not-allowed;
                pointer-events: none;
            }

        .search-box {
            flex: 1;
            max-width: 420px;
            min-width: 180px;
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 40px;
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            padding: 0 12px;
            background: var(--panel-bg);
        }

            .search-box input {
                flex: 1;
                border: 0;
                outline: 0;
                background: transparent;
                color: inherit;
                min-width: 0;
            }

        .topbar-actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .topbar-user {
            position: relative;
        }

        .topbar-user-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 0 12px;
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            background: var(--panel-bg);
            color: inherit;
            cursor: pointer;
            max-width: 220px;
        }

        .topbar-user-name {
            white-space: nowrap;
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .topbar-user-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 220px;
            background: var(--flyout-bg);
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            box-shadow: var(--flyout-shadow);
            padding: 8px;
            display: none;
            z-index: 1300;
        }

        .topbar-user.open .topbar-user-menu {
            display: block;
        }

        .topbar-user-link,
        .topbar-user-menu form button {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border: 0;
            background: transparent;
            color: inherit;
            text-decoration: none;
            border-radius: 10px;
            text-align: left;
            cursor: pointer;
        }

            .topbar-user-link:hover,
            .topbar-user-menu form button:hover {
                background: var(--menu-hover);
                text-decoration: none;
                color: inherit;
            }

        /* =========================================
                           COLLAPSED SIDEBAR
                        ========================================= */

        body.sidebar-collapsed .sidebar {
            width: var(--sidebar-collapsed-width);
            min-width: var(--sidebar-collapsed-width);
            max-width: var(--sidebar-collapsed-width);
            overflow: visible;
        }

        body.sidebar-collapsed .logo-text,
        body.sidebar-collapsed .menu-group-label,
        body.sidebar-collapsed .menu-group-arrow,
        body.sidebar-collapsed .nav-text,
        body.sidebar-collapsed .nav-badge {
            display: none !important;
        }

        body.sidebar-collapsed .submenu {
            display: none !important;
            background: transparent !important;
            border: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        body.sidebar-collapsed .sidebar-logo {
            width: 100%;
            justify-content: center;
            align-items: center;
            padding: 10px 0;
            min-height: 92px;
        }

        body.sidebar-collapsed .sidebar-logo-image {
            width: 100%;
            display: flex;
            justify-content: center;
        }

            body.sidebar-collapsed .sidebar-logo-image img {
                max-width: 42px;
                max-height: 42px;
            }

        body.sidebar-collapsed .sidebar-section {
            padding: 8px 0;
        }

        body.sidebar-collapsed .menu-group {
            margin-bottom: 6px;
            display: flex;
            justify-content: center;
            position: relative;
        }

        body.sidebar-collapsed .menu-group-toggle,
        body.sidebar-collapsed .nav-item {
            width: 44px;
            height: 44px;
            min-height: 44px;
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            border-radius: 12px;
        }

            body.sidebar-collapsed .menu-group-toggle .menu-group-title {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0;
            }

        body.sidebar-collapsed .nav-icon {
            width: 20px;
            min-width: 20px;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        body.sidebar-collapsed .menu-group:hover .menu-group-toggle {
            background: var(--menu-hover);
        }

        /* IMPORTANT: flyout panel */
        body.sidebar-collapsed .menu-group:hover > .submenu {
            display: block !important;
            position: absolute;
            top: 0;
            left: calc(100% + 8px);
            min-width: 240px;
            background: var(--flyout-bg);
            border: 1px solid var(--panel-border);
            border-radius: 14px;
            box-shadow: var(--flyout-shadow);
            padding: 8px;
            z-index: 3000;
        }

            /* IMPORTANT: make links readable/clickable in flyout */
            body.sidebar-collapsed .menu-group:hover > .submenu .nav-item {
                width: 100%;
                min-height: 38px;
                justify-content: flex-start;
                align-items: center;
                gap: .75rem;
                padding: 8px 10px;
                margin: 0 0 2px 0;
            }

            body.sidebar-collapsed .menu-group:hover > .submenu .nav-text {
                display: block !important;
                flex: 1;
                min-width: 0;
            }

            body.sidebar-collapsed .menu-group:hover > .submenu .nav-badge {
                display: inline-flex !important;
            }

            body.sidebar-collapsed .menu-group:hover > .submenu .nav-icon {
                width: 18px;
                min-width: 18px;
            }

        /* keep hover usable on flyout itself */
        body.sidebar-collapsed .menu-group > .submenu:hover {
            display: block !important;
        }

        /* =========================================
                           RESPONSIVE
                        ========================================= */

        @@media (max-width: 991.98px) {

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                z-index: 1040;
                width: var(--sidebar-width);
                transform: translateX(0);
            }

            .main {
                width: 100%;
            }

            body.sidebar-collapsed .sidebar {
                width: var(--sidebar-width);
                min-width: var(--sidebar-width);
                max-width: var(--sidebar-width);
                transform: translateX(-100%);
            }

            body.sidebar-collapsed .logo-text,
            body.sidebar-collapsed .menu-group-label,
            body.sidebar-collapsed .menu-group-arrow,
            body.sidebar-collapsed .nav-text,
            body.sidebar-collapsed .nav-badge {
                display: revert !important;
            }

            body.sidebar-collapsed .submenu {
                display: none !important;
            }

            body.sidebar-collapsed .menu-group:hover > .submenu {
                display: none !important;
            }

            body.sidebar-collapsed .menu-group-toggle,
            body.sidebar-collapsed .nav-item {
                width: 100%;
                justify-content: flex-start;
                gap: .75rem;
                padding: 8px 10px;
            }

            .topbar {
                flex-wrap: wrap;
            }

            .topbar-actions {
                width: 100%;
                justify-content: flex-start;
                flex-wrap: wrap;
            }
        }
        /* Fix: Bootstrap's default .table-hover sets hover text to a
                   near-black color (#212529), meant for light backgrounds. Since
                   every table in this app stays dark on hover, that made hover
                   text invisible (black on dark background) across ALL tables
                   site-wide. Applies globally — no per-page overrides needed. */
        .table-hover tbody tr:hover,
        .table-hover tbody tr:hover td,
        .table-hover tbody tr:hover th {
            color: #e9ecef !important;
            background-color: rgba(255, 255, 255, 0.06) !important;
        }
    </style>
    <!-- HEAD END -->
</head>
<body>
