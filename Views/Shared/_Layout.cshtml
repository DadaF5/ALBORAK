@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Space Grotesk + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/css/bootstrap-icons.css" />
    <!-- GMAO Dark Theme -->
    <link rel="stylesheet" href="~/css/gmao_fra.css" asp-append-version="true" />
    <!-- Site overrides -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar -->
    @await Component.InvokeAsync("SidebarMenu")

    <!-- Main area -->
    <div class="main">
        <!-- Top bar -->
        <div class="topbar">
            <span class="topbar-title">@(ViewData["Title"] ?? "AL-BORAK")</span>

            <div class="topbar-breadcrumb ms-3">
                @await RenderSectionAsync("Breadcrumb", required: false)
            </div>

            <!-- Search -->
            <div class="search-box d-none d-md-flex">
                <i class="fas fa-search" style="color:var(--text3);font-size:12px;"></i>
                <input type="text" placeholder="Search…" aria-label="Search" />
            </div>

            <!-- Admin quick-links (visible only to Admins) -->
            @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <div class="topbar-actions">
                    <div class="dropdown">
                        <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Admin">
                            <i class="fas fa-shield-alt"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="background:var(--surface);border-color:var(--border);">
                            <li>
                                <a class="dropdown-item" asp-controller="Users" asp-area="" asp-action="Index"
                                   style="color:var(--text2);font-size:13px;">
                                    <i class="fas fa-users-cog me-2" style="color:var(--accent);"></i>Manage Users
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-area="" asp-action="Create"
                                   style="color:var(--text2);font-size:13px;">
                                    <i class="fas fa-user-plus me-2" style="color:var(--accent);"></i>Create User
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="MenuItems" asp-area="" asp-action="Index"
                                   style="color:var(--text2);font-size:13px;">
                                    <i class="fas fa-th-list me-2" style="color:var(--accent);"></i>Manage Menu
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="MedicalDashboard" asp-area="Medical" asp-action="Index"
                                   style="color:var(--text2);font-size:13px;">
                                    <i class="fas fa-heartbeat me-2" style="color:var(--accent);"></i>Medical Dashboard
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            <!-- Notification bell -->
            <div class="topbar-actions">
                <div class="icon-btn" title="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="notif-dot"></span>
                </div>
            </div>

            <!-- User / Auth -->
            <div class="topbar-actions">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>

        <!-- Page content -->
        <div class="content">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer style="padding:10px 24px;border-top:1px solid var(--border);font-size:11px;color:var(--text3);flex-shrink:0;">
            &copy; @DateTime.Now.Year AL-BORAK &mdash; All rights reserved.
        </footer>
    </div>

    <!-- Scripts: jQuery -> Bootstrap -> site -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/crewmember-details-modal.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
