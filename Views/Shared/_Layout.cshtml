                        <span class="menu-group-title">
                            <span class="nav-icon">🔧</span>
                            <span class="menu-group-label">Opérations</span>
                        </span>
                        <span class="menu-group-arrow">›</span>
                    </button>

                    <div class="submenu" data-group-menu style="display:block">
                        <a class="nav-item @IsActive("AircraftMaintenance", "WorkOrders")"
