

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/lib/adminlte.min.css" />    
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }
    </style>
    <!-- ADD THIS LINE: Render Styles section from views -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="~/" class="nav-link">Home</a>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="~/" class="brand-link text-center">
                <span class="brand-text font-weight-light"><img src ="~/Images/Air_Force_small.png"/></span>
            </a>

            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                        <li class="nav-item">
                            <a asp-controller="AircraftDashboard" asp-action="AircraftDashboard" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="AcCategory" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Aircraft Category</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="AcStatusType" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Aircraft Status Type</p>
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link" asp-controller="AcMainGroup" asp-action="Index">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Main Groups</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="AcType" asp-action="Index">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Aircraft Types</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Aircraft" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Aircraft</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Wings" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Wing</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Squadron" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Squadron</p>
                            </a>
                        </li>
                       @*  <li class="nav-item">
                            <a href="~/CrewMembers" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Personnel</p>
                            </a>
                        </li>

                        
                            *@


                      @*   --------------------- *@


                       @*  <li class="nav-item">
                            <a asp-controller="SquadronTypes" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Squadron Type</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Squadrons" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Squadron (Escadron)</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Wing" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Wing (Escadre)</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Missions" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Missions</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Qualifications" asp-action="Index" class="nav-link">
                                <i class="fa fa-fighter-jet"></i>
                                <p>Qualifications</p>
                            </a>
                        </li>
                         *@
                        @*   --------------------- *@

                        <li class="nav-item">
                            <a asp-controller="RankType" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>Rank Type</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Rank" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>Ranks</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Base" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Bases</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Department" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Departments</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="SubDepartment" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>Services</p>
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a asp-controller="Person" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Personnel</p>
                            </a>
                        </li>
                        
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
              @*       <h4>@ViewData["Title"]</h4> *@
                </div>
            </section>

            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer text-center">
            <strong>© @DateTime.Now.Year HRProject</strong> All rights reserved.
        </footer>

    </div>

    <!-- Scripts -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/dist/js/adminlte.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
