                    <div class="submenu" data-group-menu style="display:block">
                        @* <a class="nav-item @IsActive("AircraftMaintenance", "DamDashboard")"
                           asp-area="AircraftMaintenance"
                           asp-controller="DamDashboard"
                           asp-action="Index"
                           title="Dashboard DAM">
                            <span class="nav-icon">📈</span>
