                </div>
                <!-- GROUP: FLOTTE END -->
                <!-- GROUP: NAVIGABILITE START -->
                <div class="menu-group @(navigabiliteOpen ? "open" : "")" data-group>
                    <button type="button"
                            class="menu-group-toggle"
                            data-group-toggle
