<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AL-BORAK</title>

  @*   <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
 *@
    <link rel="stylesheet" href="~/css/gmao_fra.css" asp-append-version="true" />
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div >
                <img src="~/Images/Air_Force_small.png" width="70px" />
            </div>
            <div class="logo-text">
                <div class="name">FORCES ROYALES AIR</div>
                <div class="sub">GMAO FRA</div>  
            </div>
            <button class="icon-btn sidebar-toggle" type="button" id="sidebarToggle" title="Réduire / étendre">
                ☰
            </button>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section">
                <div class="sidebar-section-label">Vue d'ensemble</div>

                <a class="nav-item" href="#" title="Tableau de bord">
                    <span class="nav-icon">📊</span>
                    <span class="nav-text">Tableau de bord</span>
                </a>

                <a class="nav-item" href="#" title="Alertes">
                    <span class="nav-icon">🔔</span>
                    <span class="nav-text">Alertes</span>
                    <span class="nav-badge badge-red">7</span>
                    
                </a>

                <div class="sidebar-section-label">Flotte</div>
                <div class="nav-item" onclick="navigate('fleet')">
                    <span class="nav-icon">✈</span> Flotte & Immatriculation
                </div>
                <div class="nav-item" onclick="navigate('navigabilite')">
                    <span class="nav-icon">🛡</span> Navigabilité
                    <span class="nav-badge badge-amber">3</span>
                </div>
                <div class="nav-item" onclick="navigate('pea')">
                    <span class="nav-icon">📋</span> Programme PEA
                </div>
                <div class="nav-item" onclick="navigate('crm')">
                    <span class="nav-icon">🔧</span> CRM / Défauts
                    <span class="nav-badge badge-red">12</span>
                </div>

                <div class="sidebar-section-label">Maintenance</div>
                <div class="nav-item" onclick="navigate('maintenance')">
                    <span class="nav-icon">🔩</span> Entretien (MoMAR 145)
                </div>
                <div class="nav-item" onclick="navigate('lme')">
                    <span class="nav-icon">📄</span> LME / LTTE / CDL
                </div>
                <div class="nav-item" onclick="navigate('cn')">
                    <span class="nav-icon">📌</span> Consignes de Nav.
                </div>

                <div class="sidebar-section-label">RH & Formation</div>
                <div class="nav-item" onclick="navigate('licences')">
                    <span class="nav-icon">🪪</span> Licences LMAM
                </div>
                <div class="nav-item" onclick="navigate('formation')">
                    <span class="nav-icon">🎓</span> Formation Type
                </div>

                <div class="sidebar-section-label">Logistique</div>
                <div class="nav-item" onclick="navigate('pmel')">
                    <span class="nav-icon">⚗</span> PMEL / Étalonnage
                </div>
                <div class="nav-item" onclick="navigate('analyse')">
                    <span class="nav-icon">🧪</span> Analyse Produits
                </div>

                <div class="sidebar-section-label">Qualité & Sécurité</div>
                <div class="nav-item" onclick="navigate('sgs')">
                    <span class="nav-icon">⚠</span> SGS Sécurité
                    <span class="nav-badge badge-amber">2</span>
                </div>
                <div class="nav-item" onclick="navigate('reporting')">
                    <span class="nav-icon">📊</span> Reporting & KPI
                </div>

               @*  <div class="sidebar-section-label">Administration</div>
                <div class="nav-item" onclick="navigate('parametres')">
                    <span class="nav-icon">⚙</span> Paramètres système
                </div> *@
            </div>
            <div class="sidebar-section-label">Administration</div>

            <!-- Keep links dead except Settings -->
            <a class="nav-item active" title="Paramètres système"
               asp-area="Settings" asp-controller="Home" asp-action="Index">
                <span class="nav-icon">⚙</span>
                <span class="nav-text">Paramètres système</span>
            </a>

            <a class="nav-item" href="#" title="Tableau de bord">
                <span class="nav-icon">📊</span>
                <span class="nav-text">Tableau de bord</span>
            </a>

            <a class="nav-item" href="#" title="Alertes">
                <span class="nav-icon">🔔</span>
                <span class="nav-text">Alertes</span>
                <span class="nav-badge badge-red">7</span>
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="user-card">
                <div class="user-avatar">CM</div>
                <div class="user-info">
                    <div class="name">@User.Identity?.Name</div>
                    <div class="role">Utilisateur</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="main">
        <!-- TOPBAR -->
        <header class="topbar">
            <div>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-breadcrumb">FRA <span>›</span> Administration</div>
            </div>

            <div class="search-box" title="Recherche">
                <span>🔎</span>
                <input placeholder="Rechercher aéronef, défaut, …" />
            </div>

            <div class="topbar-actions">
                @await Html.PartialAsync("_LoginPartial")

                <button class="icon-btn" type="button" title="Notifications">
                    🔔 <span class="notif-dot"></span>
                </button>
                <button class="icon-btn" type="button" title="Aide">?</button>
                <button class="icon-btn" type="button" title="Paramètres">⚙</button>
            </div>
        </header>

        <!-- CONTENT -->
        <main class="content">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/gmao-fra.js" asp-append-version="true"></script>   
    @RenderSection("Scripts", required: false)
</body>
</html>