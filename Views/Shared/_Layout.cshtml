@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <!-- AdminLTE CSS -->
    <link rel="stylesheet" href="~/lib/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Sidebar: render the full <aside> from the ViewComponent (do NOT wrap it in another <aside>) -->
        @await Component.InvokeAsync("SidebarMenu")
        @* alternative tag helper: <vc:sidebar-menu></vc:sidebar-menu> *@

        <!-- Content Wrapper (AdminLTE's convention) -->
        <div class="content-wrapper">
            <!-- Navbar -->
            <nav class="navbar navbar-expand navbar-white navbar-light">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                            <i class="fas fa-bars"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <a href="~/" class="nav-link">Home</a>
                    </li>
                    @* Add Admin-only link(s) in the navbar (visible only to users in the "Admin" role) *@
                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <li class="nav-item d-none d-sm-inline-block">
                            <a asp-controller="Users" asp-action="Index" class="nav-link">
                                <i class="fas fa-users-cog mr-1"></i> Manage Users
                            </a>
                        </li>

                        <li class="nav-item d-none d-sm-inline-block">
                            <a asp-controller="Account" asp-action="Create" class="nav-link">
                                <i class="fas fa-user-plus mr-1"></i> Create User
                            </a>
                        </li>

                        <li class="nav-item d-none d-sm-inline-block">
                            <a asp-controller="MenuItems" asp-action="Index" class="nav-link">
                                <i class="fas fa-th-list mr-1"></i> Manage Menu
                            </a>
                        </li>
                    }
                </ul>

                <div class="ml-auto">
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </nav>

            <!-- Page header -->
            <section class="content-header">
                <div class="container-fluid">
                    @* optional title / breadcrumbs *@
                </div>
            </section>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer text-center">
            <strong>© @DateTime.Now.Year FRA-BORAK</strong> All rights reserved.
        </footer>
    </div>

    <!-- Scripts: jQuery -> Bootstrap -> AdminLTE -> site -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/dist/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>