@* @using FRAProject.Areas.AircraftMaintenance.Models
@using FRAProject.Areas.AircraftMaintenance.Services *@
@* Views/Snags/Edit.cshtml *@
@model SnagUpdateDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Suivi du Snag";
}

<div class="content-header"><h1>✏️ Suivi du Snag</h1></div>

<div class="card card-info card-outline">
    <div class="card-body">
        @* Edit.cshtml — form tag corrected *@
        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label>Gravité</label>
                    <select asp-for="Severity" asp-items="Html.GetEnumSelectList<SnagSeverity>()" class="form-control"></select>
                </div>
                <div class="col-md-6 form-group">
                    <label>Impact Navigabilité</label>
                    <select asp-for="Impact" asp-items="Html.GetEnumSelectList<AirworthinessImpact>()" class="form-control"></select>
                </div>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <button type="submit" class="btn btn-info">Enregistrer</button>
            <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-secondary">Annuler</a>
        </form>
    </div>
</div>