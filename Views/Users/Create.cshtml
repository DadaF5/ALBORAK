@model FRAProject.ViewModels.RegisterUserViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_Layout";
}

<h2>Create User</h2>

<div class="card p-3">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group col-md-3">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group col-md-3">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <hr />

        <h4>Defaults (optional)</h4>
        <p class="text-muted small">
            Informational / SquadronOps convenience only — none of these grant module access.
            Real access is set up after creating the user, via <strong>Affectations</strong> on the Users list.
        </p>
        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="BaseId"></label>
                <select asp-for="BaseId" asp-items="Model.BaseList" class="form-control" id="BaseSelect">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="BaseId" class="text-danger"></span>
            </div>

            <div class="form-group col-md-4">
                <label asp-for="SquadronId"></label>
                <select asp-for="SquadronId" asp-items="Model.SquadronList" class="form-control" id="SquadronSelect">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="SquadronId" class="text-danger"></span>
            </div>

            <div class="form-group col-md-4">
                <label asp-for="AcMainGroupId"></label>
                <select asp-for="AcMainGroupId" asp-items="Model.AcMainGroupList" class="form-control" id="AcMainGroupSelect">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="AcMainGroupId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <hr />

        <h4>Administrator</h4>
        <p class="text-muted small">
            Full access, bypasses all module scoping. For anything else — Maintenance, SquadronOps, etc. —
            grant real access after creating the user via <strong>Affectations</strong> on the Users list.
        </p>
        <div class="form-group">
            <div class="form-check">
                <input asp-for="IsAdmin" class="form-check-input" />
                <label asp-for="IsAdmin" class="form-check-label"></label>
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Create user</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
