@model FRAProject.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "User details";
}

<h2>User details</h2>

<!--
    Same legacy-fields note as Users/Edit.cshtml — Roles (except "Admin")
    and Base here are informational only and do not reflect real module
    access, which is granted via UserAssignment. See Edit.cshtml for the
    full explanation; kept short here since this is a read-only page.
-->
<div class="alert alert-warning d-flex align-items-start" role="alert" style="gap: 10px;">
    <i class="fas fa-triangle-exclamation mt-1"></i>
    <div>
        <strong>Rôles et Base ci-dessous ne reflètent pas l'accès réel aux modules.</strong>
        L'accès réel (Maintenance, SquadronOps, etc.) est géré via les attributions utilisateur.
        <a asp-controller="UserAssignments" asp-action="Index" asp-route-userId="@Model.Id" class="alert-link">
            Voir les accès réels de cet utilisateur →
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">Display name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">
                Roles
                <br /><small class="text-muted">Identity role — "Admin" only</small>
            </dt>
            <dd class="col-sm-9">@((Model.Roles != null && Model.Roles.Length > 0) ? string.Join(", ", Model.Roles) : "—")</dd>

            <dt class="col-sm-3">
                Base
                <br /><small class="text-muted">Legacy — display only</small>
            </dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.BaseName) ? Model.BaseName : "—")</dd>

            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@((Model.CreatedAtUtc.HasValue) ? Model.CreatedAtUtc.Value.ToLocalTime().ToString("g") : "—")</dd>

            <dt class="col-sm-3">Last login</dt>
            <dd class="col-sm-9">
                @if (Model.LastLoginUtc.HasValue)
                {
                    @Model.LastLoginUtc.Value.ToLocalTime().ToString("g")
                }
                else
                {
                    <span class="text-muted">never</span>
                }
            </dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-controller="UserAssignments" asp-action="Index" asp-route-userId="@Model.Id" class="btn btn-warning">
                <i class="fas fa-user-shield"></i> Accès réels
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        </div>
    </div>
</div>
