@model FRAProject.ViewModels.RegisterUserViewModel

@{
    ViewData["Title"] = "Edit User";
    var userId = ViewBag.UserId as string ?? "";
}

<h2>Edit user</h2>

<form asp-action="Edit" asp-route-id="@userId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group col-md-4">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group col-md-4">
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group col-md-6">
            <label asp-for="BaseId">Base (optional)</label>
            <select asp-for="BaseId" class="form-control" asp-items="Model.BaseList">
                <option value="">-- none --</option>
            </select>
            <span asp-validation-for="BaseId" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label>Roles</label>
        <div>
            @foreach (var r in Model.AvailableRoles)
            {
                var id = "role_" + r.Value;
                var isChecked = Model.SelectedRoles?.Contains(r.Value) == true;
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="@id" name="SelectedRoles" value="@r.Value" @(isChecked ? "checked" : "") />
                    <label class="form-check-label" for="@id">@r.Text</label>
                </div>
            }
        </div>
    </div>

    <div class="form-row align-items-center">
        <div class="form-group col-md-3">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <a asp-controller="Users" asp-action="Details" asp-route-id="@userId" class="btn btn-link">View details</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}