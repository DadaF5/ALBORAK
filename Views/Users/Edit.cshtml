@model FRAProject.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    var userId = ViewBag.UserId as string ?? Model.Id ?? "";
    var currentBaseId = ViewBag.CurrentBaseId as int?;
    var currentAcMainGroupId = ViewBag.CurrentAcMainGroupId as int?;
}

<style>
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.75);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1050;
        padding: 20px;
        animation: fadeIn 0.2s ease-out;
    }

    .popup-container {
        background-color: #2d3748;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        width: 100%;
        max-width: 800px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 0;
        animation: slideIn 0.3s ease-out;
    }

    .popup-header {
        background-color: #1a202c;
        padding: 24px 30px;
        border-bottom: 1px solid #4a5568;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .popup-title {
        color: #fff;
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .popup-body {
        padding: 30px;
    }

    .popup-footer {
        background-color: #1a202c;
        padding: 20px 30px;
        border-top: 1px solid #4a5568;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-label {
        color: #cbd5e0;
        font-weight: 500;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .form-label i {
            width: 16px;
            text-align: center;
        }

    .form-control, .form-select {
        background-color: #4a5568;
        border: 1px solid #718096;
        color: #fff;
        border-radius: 8px;
        padding: 10px 14px;
        transition: all 0.2s;
    }

        .form-control:focus, .form-select:focus {
            background-color: #2d3748;
            border-color: #4299e1;
            color: #fff;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15);
        }

        .form-control::placeholder {
            color: #a0aec0;
        }

        .form-select option {
            background-color: #2d3748;
            color: #fff;
            padding: 10px;
        }

    .form-check-input {
        background-color: #718096;
        border-color: #a0aec0;
    }

        .form-check-input:checked {
            background-color: #4299e1;
            border-color: #4299e1;
        }

    .form-check-label {
        color: #cbd5e0;
        margin-left: 8px;
    }

    .section-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 0px;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid #4a5568;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title .legacy-tag {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #a0aec0;
            background-color: rgba(160, 174, 192, 0.12);
            border: 1px solid rgba(160, 174, 192, 0.3);
            border-radius: 12px;
            padding: 2px 10px;
            margin-left: auto;
        }

    .btn-primary {
        background-color: #4299e1;
        border-color: #4299e1;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background-color: #3182ce;
            border-color: #3182ce;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #718096;
        border-color: #718096;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-secondary:hover {
            background-color: #4a5568;
            border-color: #4a5568;
            transform: translateY(-1px);
        }

    .btn-link {
        color: #63b3ed;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-link:hover {
            color: #90cdf4;
            text-decoration: underline;
        }

    .text-danger {
        color: #fc8181 !important;
        font-size: 0.875rem;
        margin-top: 6px;
    }

    .validation-summary-errors {
        background-color: #742a2a;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

    /* Real-access banner — points at UserAssignments, the only screen
       that actually grants module access. */
    .assignments-banner {
        background-color: rgba(66, 153, 225, 0.1);
        border: 1px solid rgba(66, 153, 225, 0.4);
        border-radius: 10px;
        padding: 14px 20px;
        margin-bottom: 24px;
        display: flex;
        gap: 14px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

        .assignments-banner p {
            color: #cbd5e0;
            margin: 0;
            font-size: 0.9rem;
        }

        .assignments-banner .btn-assignments {
            background-color: #4299e1;
            border-color: #4299e1;
            color: #fff;
            font-weight: 600;
            padding: 8px 18px;
            border-radius: 6px;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.2s;
            white-space: nowrap;
        }

            .assignments-banner .btn-assignments:hover {
                background-color: #3182ce;
                color: #fff;
            }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(-20px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .popup-container {
            margin: 10px;
            max-width: calc(100% - 20px);
            max-height: calc(100vh - 20px);
        }

        .popup-body {
            padding: 20px;
        }

        .popup-header,
        .popup-footer {
            padding: 20px;
        }

        .form-row {
            flex-direction: column;
        }

            .form-row > div {
                width: 100%;
                margin-bottom: 15px;
            }

        .form-check-input {
            margin-right: 10px !important;
        }
    }
</style>

<div class="popup-overlay">
    <div class="popup-container">
        <div class="popup-header">
            <h4 class="popup-title">
                <i class="fas fa-user-edit"></i>
                Edit User: @Model.FirstName @Model.LastName
            </h4>
        </div>

        <div class="popup-body">
            <form asp-action="Edit" asp-route-id="@userId" method="post" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" id="initialBaseId" value="@currentBaseId" />
                <input type="hidden" id="initialAcMainGroupId" value="@currentAcMainGroupId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!--
                    Real access for Maintenance/SquadronOps/etc. is granted
                    via UserAssignment, not on this form. Department and
                    Wing (dead everywhere — no code ever read them) and the
                    old 7-checkbox role list (only "Admin" ever did
                    anything) have been removed. What's left below is
                    either informational (Base) or a Create-time SquadronOps
                    default only (Squadron/AcMainGroup) — see each field's
                    label.
                -->
                <div class="assignments-banner">
                    <p>L'accès réel aux modules (Maintenance, SquadronOps…) se gère via les attributions utilisateur.</p>
                    <a href="@Url.Action("Index", "UserAssignments", new { userId })" class="btn-assignments">
                        <i class="fas fa-user-shield"></i> Gérer les accès réels
                    </a>
                </div>

                <!-- Personal Information Section -->
                <h5 class="section-title" style="padding-top:0px;">
                    <i class="fas fa-user"></i>
                    Personal Information
                </h5>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="FirstName" class="form-label">
                            <i class="fas fa-user"></i>First Name
                        </label>
                        <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="LastName" class="form-label">
                            <i class="fas fa-user"></i>Last Name
                        </label>
                        <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="Email" class="form-label">
                            <i class="fas fa-envelope"></i>Email
                        </label>
                        <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">
                            <i class="fas fa-phone"></i>Phone Number
                        </label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <!-- Defaults Section -->
                <h5 class="section-title">
                    <i class="fas fa-sitemap"></i>
                    Defaults
                    <span class="legacy-tag">Not access control</span>
                </h5>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="BaseId" class="form-label">
                            <i class="fas fa-building"></i>@Html.DisplayNameFor(m => m.BaseId)
                        </label>
                        <select asp-for="BaseId" class="form-select" id="baseSelect">
                            <option value="">-- None --</option>
                            @foreach (var item in Model.BaseList ?? new())
                            {
                                <option value="@item.Value" selected="@(item.Value == Model.BaseId?.ToString())">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="BaseId" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="SquadronId" class="form-label">
                            <i class="fas fa-fighter-jet"></i>@Html.DisplayNameFor(m => m.SquadronId)
                        </label>
                        <select asp-for="SquadronId" class="form-select" id="squadronSelect">
                            <option value="">-- None --</option>
                            @foreach (var item in Model.SquadronList ?? new())
                            {
                                var isSelected = item.Value == Model.SquadronId?.ToString();
                                <option value="@item.Value" selected="@isSelected">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="SquadronId" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="AcMainGroupId" class="form-label">
                            <i class="fas fa-plane"></i>@Html.DisplayNameFor(m => m.AcMainGroupId)
                        </label>
                        <select asp-for="AcMainGroupId" class="form-select" id="acMainGroupSelect"
                                disabled="@(Model.BaseId == null && Model.AcMainGroupId == null)">
                            <option value="">-- None --</option>
                            @foreach (var item in Model.AcMainGroupList ?? new())
                            {
                                var isSelected = item.Value == Model.AcMainGroupId?.ToString();
                                <option value="@item.Value" selected="@isSelected">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="AcMainGroupId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Administrator Section -->
                <h5 class="section-title">
                    <i class="fas fa-user-shield"></i>
                    Administrator
                </h5>

                <div class="form-group">
                    <div class="form-check" style="padding-left: 2em;">
                        <input asp-for="IsAdmin" class="form-check-input position-absolute" style="margin-left: -2em;" />
                        <label asp-for="IsAdmin" class="form-check-label"></label>
                    </div>
                    <small class="text-muted d-block mt-1" style="color:#a0aec0 !important;">
                        Full access, bypasses all module scoping. For Maintenance/SquadronOps/etc. access, use
                        <a href="@Url.Action("Index", "UserAssignments", new { userId })">Affectations</a> instead.
                    </small>
                </div>

                <!-- Status Section -->
                <div class="row">
                    <div class="form-group mt-6">
                        <div class="form-check form-switch" style="padding-left: 2em;">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch"
                                   id="isActiveSwitch" style="margin-left: -2em;" />
                            <label asp-for="IsActive" class="form-check-label" for="isActiveSwitch">
                                <i class="fas fa-user-check"></i> User is Active
                            </label>
                        </div>
                    </div>

                    <div class="form-group mt-6" style="text-align:right;">
                        <small class="text-muted" style="color: #a0aec0 !important;">
                            <i class="fas fa-info-circle"></i> Inactive users cannot log into the system.
                        </small>
                    </div>
                </div>
            </form>
        </div>

        <div class="popup-footer">
            <div>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Users" asp-action="Details" asp-route-id="@userId" class="btn btn-link">
                    <i class="fas fa-eye"></i> View Details
                </a>
                <button type="submit" form="editForm" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Only remaining cascade: Base -> AcMainGroup (AcMainGroup.BaseId
            // is a real FK). Squadron is now a flat list with no dependency.
            const baseSelect = document.getElementById('baseSelect');
            const acMainGroupSelect = document.getElementById('acMainGroupSelect');
            const initialAcMainGroupId = document.getElementById('initialAcMainGroupId')?.value || null;

            baseSelect.addEventListener('change', function () {
                const baseId = this.value;
                acMainGroupSelect.disabled = !baseId;

                if (!baseId) {
                    acMainGroupSelect.innerHTML = '<option value="">-- None --</option>';
                    return;
                }

                fetch(`/Users/GetAcMainGroupsByBase?baseId=${baseId}`)
                    .then(r => r.json())
                    .then(data => {
                        acMainGroupSelect.innerHTML = '<option value="">-- None --</option>';
                        data.forEach(item => acMainGroupSelect.add(new Option(item.text, item.value)));
                        if (initialAcMainGroupId && data.some(a => a.value === initialAcMainGroupId)) {
                            acMainGroupSelect.value = initialAcMainGroupId;
                        }
                    })
                    .catch(err => console.error('Error loading AC main groups:', err));
            });

            // Popup handling
            const overlay = document.querySelector('.popup-overlay');
            overlay.addEventListener('click', function (e) {
                if (e.target === this) window.history.back();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') window.history.back();
            });
        });
    </script>
}
