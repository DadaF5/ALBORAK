@using System.Linq
@using Microsoft.AspNetCore.Mvc.Rendering
@using FRAProject.Models
@{
    // Model expected: IEnumerable<ApplicationUser>
    Layout = "_Layout";
    var query = Context.Request.Query["q"].ToString();
    var baseFilter = Context.Request.Query["baseId"].ToString();
    var wingFilter = Context.Request.Query["wingId"].ToString();
    var squadFilter = Context.Request.Query["squadronId"].ToString();
    var roleFilter = Context.Request.Query["role"].ToString();
    var isActiveFilter = Context.Request.Query["isActive"].ToString();
    var sortOrder = Context.Request.Query["sortOrder"].ToString();

    // Helper local functions to get display names from dictionaries passed in ViewBag
    Func<int?, string> getNameFromDict = id =>
    {
        if (!id.HasValue) return "";
        var d = ViewBag.DisplayMaps as System.Collections.Generic.IDictionary<string, System.Collections.Generic.Dictionary<int, string>>;
        if (d == null) return id.ToString() ?? "";
        // attempt base/wing/department/squadron keys
        foreach (var kv in d)
        {
            if (kv.Value.TryGetValue(id.Value, out var name))
            {
                return name;
            }
        }
        return id.ToString() ?? "";
    };
}

<section class="card mb-3 p-3">
    <form asp-action="Index" method="get" class="form-inline">
        <div class="form-group mr-2">
            <input type="text" name="q" value="@Model.Search" class="form-control" placeholder="Search email, name..." />
        </div>

        <div class="form-group mr-2">
            <select name="baseId" class="form-control">
                <option value="">All Bases</option>
                @foreach (var b in Model.BaseList)
                {
                    var isSelected = (b.Value ?? "") == (Model.BaseFilter?.ToString() ?? "");
                    if (isSelected)
                    {
                        <option value="@b.Value" selected>@b.Text</option>
                    }
                    else
                    {
                        <option value="@b.Value">@b.Text</option>
                    }
                }
            </select>
        </div>

        <div class="form-group mr-2">
            <select name="role" class="form-control">
                <option value="">All Roles</option>
                @foreach (var r in Model.AvailableRoles)
                {
                    var isSelected = (r.Value ?? "") == (Model.RoleFilter ?? "");
                    if (isSelected)
                    {
                        <option value="@r.Value" selected>@r.Text</option>
                    }
                    else
                    {
                        <option value="@r.Value">@r.Text</option>
                    }
                }
            </select>
        </div>

        <div class="form-group mr-2">
            <select name="isActive" class="form-control">
                <option value="">Any status</option>
                @if (Model.IsActiveFilter == true || isActiveFilter == "true")
                {
                    <option value="true" selected>Active</option>
                }
                else
                {
                    <option value="true">Active</option>
                }

                @if (Model.IsActiveFilter == false || isActiveFilter == "false")
                {
                    <option value="false" selected>Inactive</option>
                }
                else
                {
                    <option value="false">Inactive</option>
                }
            </select>
        </div>

        <div class="form-group mr-2">
            <select name="sortOrder" class="form-control">
                <option value="">Sort</option>
                @if (Model.SortOrder == "email_asc" || sortOrder == "email_asc")
                {
                    <option value="email_asc" selected>Email ↑</option>
                }
                else
                {
                    <option value="email_asc">Email ↑</option>
                }

                @if (Model.SortOrder == "email_desc" || sortOrder == "email_desc")
                {
                    <option value="email_desc" selected>Email ↓</option>
                }
                else
                {
                    <option value="email_desc">Email ↓</option>
                }

                @if (Model.SortOrder == "created_asc" || sortOrder == "created_asc")
                {
                    <option value="created_asc" selected>Created ↑</option>
                }
                else
                {
                    <option value="created_asc">Created ↑</option>
                }

                @if (Model.SortOrder == "created_desc" || sortOrder == "created_desc")
                {
                    <option value="created_desc" selected>Created ↓</option>
                }
                else
                {
                    <option value="created_desc">Created ↓</option>
                }

                @if (Model.SortOrder == "base_asc" || sortOrder == "base_asc")
                {
                    <option value="base_asc" selected>Base ↑</option>
                }
                else
                {
                    <option value="base_asc">Base ↑</option>
                }
            </select>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-secondary ml-2">Reset</a>
        </div>
    </form>
</section>

<section class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="email_asc" asp-route-q="@Model.Search" asp-route-baseId="@Model.BaseFilter" asp-route-role="@Model.RoleFilter" asp-route-isActive="@(Model.IsActiveFilter?.ToString() ?? "")">Email</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="created_desc" asp-route-q="@Model.Search">Created</a>
                </th>
                <th>Name</th>
                <th>Base</th>
                <th>Wing</th>
                <th>Department</th>
                <th>Squadron</th>
                <th>AC Group</th>
                <th>Active</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Users == null || Model.Users.Count == 0)
            {
                <tr>
                    <td colspan="11" class="text-center">No users found</td>
                </tr>
            }
            else
            {
                foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>@(u.CreatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "")</td>
                        <td>@(string.IsNullOrWhiteSpace(u.FirstName) && string.IsNullOrWhiteSpace(u.LastName) ? u.UserName : $"{u.FirstName} {u.LastName}")</td>
                        <td>@(string.IsNullOrWhiteSpace(u.BaseName) ? (u.BaseId?.ToString() ?? "") : u.BaseName)</td>
                        <td>@(string.IsNullOrWhiteSpace(u.WingName) ? (u.WingId?.ToString() ?? "") : u.WingName)</td>
                        <td>@(string.IsNullOrWhiteSpace(u.DepartmentName) ? (u.DepartmentId?.ToString() ?? "") : u.DepartmentName)</td>
                        <td>@(string.IsNullOrWhiteSpace(u.SquadronName) ? (u.SquadronId?.ToString() ?? "") : u.SquadronName)</td>
                        <td>@(string.IsNullOrWhiteSpace(u.AcMainGroupName) ? (u.AcMainGroupId?.ToString() ?? "") : u.AcMainGroupName)</td>
                        <td>@(u.IsActive ? "Yes" : "No")</td>
                        <td>@(u.Roles != null ? string.Join(", ", u.Roles) : "")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

@section Scripts {
    <script>
        // submit filter form when selects change
        (function () {
            document.querySelectorAll('select[name="baseId"], select[name="role"], select[name="isActive"], select[name="sortOrder"]').forEach(function (el) {
                el.addEventListener('change', function () {
                    var f = document.querySelector('form[method="get"]');
                    if (f) f.submit();
                });
            });
        })();
    </script>
}