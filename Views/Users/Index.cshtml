@model FRAProject.ViewModels.UsersIndexViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Users";
}

<section class="card mb-3 p-3">
    <form asp-action="Index" method="get" class="form-inline">
        <div class="form-group mr-2">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search email, name..." />
        </div>

        <div class="form-group mr-2">
            <select name="baseFilter" class="form-control">
                <option value="">All Bases</option>
                @foreach (var b in Model.BaseList)
                {
                    var selected = b.Value == (Model.BaseFilter?.ToString() ?? "");
                    <option value="@b.Value" selected="@selected">@b.Text</option>
                }
            </select>
        </div>

        <div class="form-group mr-2">
            <select name="roleFilter" class="form-control">
                <option value="">All Roles</option>
                @foreach (var r in Model.AvailableRoles)
                {
                    var selected = r.Value == (Model.RoleFilter ?? "");
                    <option value="@r.Value" selected="@selected">@r.Text</option>
                }
            </select>
        </div>

        <div class="form-group mr-2">
            <select name="isActiveFilter" class="form-control">
                <option value="">Any status</option>
                <option value="true" selected="@(Model.IsActiveFilter == true)">Active</option>
                <option value="false" selected="@(Model.IsActiveFilter == false)">Inactive</option>
            </select>
        </div>

        <div class="form-group mr-2">
            <select name="sortOrder" class="form-control">
                <option value="">Default (User Name)</option>
                <option value="user_desc" selected="@(Model.SortOrder == "user_desc")">User Name ↓</option>
                <option value="email_asc" selected="@(Model.SortOrder == "email_asc")">Email ↑</option>
                <option value="email_desc" selected="@(Model.SortOrder == "email_desc")">Email ↓</option>
                <option value="created_asc" selected="@(Model.SortOrder == "created_asc")">Created ↑</option>
                <option value="created_desc" selected="@(Model.SortOrder == "created_desc")">Created ↓</option>
                <option value="lastlogin_asc" selected="@(Model.SortOrder == "lastlogin_asc")">Last Login ↑</option>
                <option value="lastlogin_desc" selected="@(Model.SortOrder == "lastlogin_desc")">Last Login ↓</option>
            </select>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-secondary ml-2">Reset</a>
        </div>
    </form>
</section>

<section class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-roleFilter="@Model.RoleFilter"
                       asp-route-baseFilter="@Model.BaseFilter"
                       asp-route-isActiveFilter="@Model.IsActiveFilter"
                       asp-route-pageNumber="1"
                       asp-route-sortOrder="@(Model.SortOrder == "email_asc" ? "email_desc" : "email_asc")">
                        Email
                        @if (Model.SortOrder == "email_asc")
                        {
                            <span>↑</span>
                        }
                        else if (Model.SortOrder == "email_desc")
                        {
                            <span>↓</span>
                        }
                    </a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-roleFilter="@Model.RoleFilter"
                       asp-route-baseFilter="@Model.BaseFilter"
                       asp-route-isActiveFilter="@Model.IsActiveFilter"
                       asp-route-pageNumber="1"
                       asp-route-sortOrder="@(Model.SortOrder == "created_asc" ? "created_desc" : "created_asc")">
                        Created
                        @if (Model.SortOrder == "created_asc")
                        {
                            <span>↑</span>
                        }
                        else if (Model.SortOrder == "created_desc")
                        {
                            <span>↓</span>
                        }
                    </a>
                </th>
                <th>Name</th>
                <th>Base</th>
                <th>Wing</th>
                <th>Department</th>
                <th>Squadron</th>
                <th>AC Group</th>
                <th>Active</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users == null || !Model.Users.Any())
            {
                <tr>
                    <td colspan="11" class="text-center">No users found</td>
                </tr>
            }
            else
            {
                foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>@u.CreatedAtUtc?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(string.IsNullOrWhiteSpace(u.FirstName) && string.IsNullOrWhiteSpace(u.LastName) ? u.UserName : $"{u.FirstName} {u.LastName}")</td>
                        <td>@(u.BaseName ?? u.BaseId?.ToString() ?? "")</td>
                        <td>@(u.WingName ?? u.WingId?.ToString() ?? "")</td>
                        <td>@(u.DepartmentName ?? u.DepartmentId?.ToString() ?? "")</td>
                        <td>@(u.SquadronName ?? u.SquadronId?.ToString() ?? "")</td>
                        <td>@(u.AcMainGroupName ?? u.AcMainGroupId?.ToString() ?? "")</td>
                        <td>
                            <span class="badge @(u.IsActive ? "badge-success" : "badge-secondary")">
                                @(u.IsActive ? "Yes" : "No")
                            </span>
                        </td>
                        <td>
                            @if (u.Roles != null && u.Roles.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var role in u.Roles)
                                    {
                                        <span class="badge badge-info">@role</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

@if (Model.Users != null && Model.Users.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.Users.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-roleFilter="@Model.RoleFilter"
                       asp-route-baseFilter="@Model.BaseFilter"
                       asp-route-isActiveFilter="@Model.IsActiveFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-pageNumber="@(Model.Users.PageIndex - 1)">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }

            @for (int i = 1; i <= Model.Users.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Users.PageIndex ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-roleFilter="@Model.RoleFilter"
                       asp-route-baseFilter="@Model.BaseFilter"
                       asp-route-isActiveFilter="@Model.IsActiveFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-pageNumber="@i">@i</a>
                </li>
            }

            @if (Model.Users.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-roleFilter="@Model.RoleFilter"
                       asp-route-baseFilter="@Model.BaseFilter"
                       asp-route-isActiveFilter="@Model.IsActiveFilter"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-pageNumber="@(Model.Users.PageIndex + 1)">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        // Auto-submit form when dropdowns change
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form[method="get"]');
            const selects = form.querySelectorAll('select[name]');

            selects.forEach(select => {
                select.addEventListener('change', function() {
                    // Reset to page 1 when filters change
                    const pageInput = form.querySelector('input[name="pageNumber"]');
                    if (pageInput) pageInput.value = '1';
                    form.submit();
                });
            });

            // Add page number hidden field
            const pageNumberInput = document.createElement('input');
            pageNumberInput.type = 'hidden';
            pageNumberInput.name = 'pageNumber';
            pageNumberInput.value = '@Model.PageNumber';
            form.appendChild(pageNumberInput);
        });
    </script>
}