@model FRAProject.ViewModels.UsersIndexViewModel

@{
    ViewData["Title"] = "Users";
    var sort = Model.SortOrder ?? "";
    string ToggleSort(string colAsc, string colDesc) => sort == colAsc ? colDesc : colAsc;
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <h2>Users</h2>

    <div>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Create">
            <i class="fas fa-user-plus mr-1"></i> Create User
        </a>
    </div>
</div>

<form method="get" class="mb-3">
    <div class="form-row">
        <div class="col-md-4">
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search (username, email, name)..." />
        </div>

        <div class="col-md-2">
            <select asp-for="RoleFilter" class="form-control" asp-items="Model.AvailableRoles">
                <option value="">-- All roles --</option>
            </select>
        </div>

        <div class="col-md-2">
            <select asp-for="BaseFilter" class="form-control" asp-items="Model.BaseList">
                <option value="">-- All bases --</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="isActiveFilter" class="form-control">
                <option value="">-- Any status --</option>
                <option value="true" selected="@(Model.IsActiveFilter == true ? "selected" : null)">Active</option>
                <option value="false" selected="@(Model.IsActiveFilter == false ? "selected" : null)">Inactive</option>
            </select>
        </div>

        <div class="col-md-2 text-right">
            <button type="submit" class="btn btn-secondary">Filter</button>
            <a class="btn btn-link" href="@Url.Action("Index", "Users")">Reset</a>
        </div>
    </div>

    @* Preserve sort and page size when submitting filters *@
    <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

<table class="table table-striped table-bordered table-sm">
    <thead class="thead-light">
        <tr>
            <th style="width:40px;">#</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@(ToggleSort("user_asc", "user_desc"))"
                   asp-route-search="@Model.Search"
                   asp-route-roleFilter="@Model.RoleFilter"
                   asp-route-baseFilter="@Model.BaseFilter"
                   asp-route-isActiveFilter="@Model.IsActiveFilter"
                   asp-route-pageSize="@Model.PageSize">
                    Username
                </a>
            </th>
            <th>Display name</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@(ToggleSort("email_asc", "email_desc"))"
                   asp-route-search="@Model.Search"
                   asp-route-roleFilter="@Model.RoleFilter"
                   asp-route-baseFilter="@Model.BaseFilter"
                   asp-route-isActiveFilter="@Model.IsActiveFilter"
                   asp-route-pageSize="@Model.PageSize">
                    Email
                </a>
            </th>
            <th>Roles</th>
            <th>Base</th>
            <th style="width:100px;">
                <a asp-action="Index"
                   asp-route-sortOrder="@(ToggleSort("created_asc", "created_desc"))"
                   asp-route-search="@Model.Search"
                   asp-route-roleFilter="@Model.RoleFilter"
                   asp-route-baseFilter="@Model.BaseFilter"
                   asp-route-isActiveFilter="@Model.IsActiveFilter"
                   asp-route-pageSize="@Model.PageSize">
                    Created
                </a>
            </th>
            <th style="width:160px;">
                <a asp-action="Index"
                   asp-route-sortOrder="@(ToggleSort("lastlogin_asc", "lastlogin_desc"))"
                   asp-route-search="@Model.Search"
                   asp-route-roleFilter="@Model.RoleFilter"
                   asp-route-baseFilter="@Model.BaseFilter"
                   asp-route-isActiveFilter="@Model.IsActiveFilter"
                   asp-route-pageSize="@Model.PageSize">
                    Last login
                </a>
            </th>
            <th class="text-nowrap" style="width:220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Users?.Any() ?? true)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No users found.</td>
            </tr>
        }
        else
        {
            var idx = (Model.Users.PageIndex - 1) * Model.Users.PageSize + 1;
            foreach (var u in Model.Users)
            {
                <tr>
                    <td>@idx</td>
                    <td>@u.UserName</td>
                    <td>@u.DisplayName</td>
                    <td>@u.Email</td>
                    <td>@(string.IsNullOrWhiteSpace(u.Roles) ? "—" : u.Roles)</td>
                    <td>@(string.IsNullOrWhiteSpace(u.BaseName) ? "—" : u.BaseName)</td>
                    <td>@(u.IsActive ? "Yes" : "No")</td>
                    <td>
                        @if (u.LastLoginUtc.HasValue)
                        {
                            @u.LastLoginUtc.Value.ToLocalTime().ToString("g")
                        }
                        else
                        {
                            <span class="text-muted">never</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@u.Id">Details</a>
                        <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                    </td>
                </tr>
                idx++;
            }
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <div>
        <form method="get" class="form-inline">
            <label class="mr-2">Page size</label>
            <select name="pageSize" class="form-control mr-2" onchange="this.form.submit()">
                @* <option value="true" selected="@(Model.IsActiveFilter == true ? "selected" : null)">Active</option> *@
                <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>

                <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
            </select>
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
            <input type="hidden" name="roleFilter" value="@Model.RoleFilter" />
            <input type="hidden" name="baseFilter" value="@Model.BaseFilter" />
            <input type="hidden" name="isActiveFilter" value="@(Model.IsActiveFilter?.ToString().ToLower())" />
        </form>
    </div>

    <nav>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Users.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.Users.PageIndex - 1, pageSize = Model.PageSize, search = Model.Search, sortOrder = Model.SortOrder, roleFilter = Model.RoleFilter, baseFilter = Model.BaseFilter, isActiveFilter = Model.IsActiveFilter })">Prev</a>
            </li>

            @for (int i = 1; i <= Model.Users.TotalPages; i++)
            {
                if (i == Model.Users.PageIndex)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = Model.PageSize, search = Model.Search, sortOrder = Model.SortOrder, roleFilter = Model.RoleFilter, baseFilter = Model.BaseFilter, isActiveFilter = Model.IsActiveFilter })">@i</a>
                    </li>
                }
            }

            <li class="page-item @(Model.Users.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.Users.PageIndex + 1, pageSize = Model.PageSize, search = Model.Search, sortOrder = Model.SortOrder, roleFilter = Model.RoleFilter, baseFilter = Model.BaseFilter, isActiveFilter = Model.IsActiveFilter })">Next</a>
            </li>
        </ul>
    </nav>
</div>