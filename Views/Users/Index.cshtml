@model IEnumerable<FRAProject.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>

    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="Create">
            <i class="fas fa-user-plus mr-1"></i> Create User
        </a>
    }
</div>

<table class="table table-striped table-bordered table-sm">
    <thead class="thead-light">
        <tr>
            <th style="width:40px;">#</th>
            <th>Username</th>
            <th>Display name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Base</th>
            <th style="width:100px;">Active</th>
            <th style="width:160px;">Last login</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model?.Any() ?? true)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No users found.</td>
            </tr>
        }
        else
        {
            var row = 1;
            foreach (var u in Model)
            {
                <tr>
                    <td>@row</td>
                    <td>@u.UserName</td>
                    <td>@u.DisplayName</td>
                    <td>@u.Email</td>
                    <td>@(string.IsNullOrWhiteSpace(u.Roles) ? "—" : u.Roles)</td>
                    <td>@(string.IsNullOrWhiteSpace(u.BaseName) ? "—" : u.BaseName)</td>
                    <td>@(u.IsActive ? "Yes" : "No")</td>
                    <td>
                        @if (u.LastLoginUtc.HasValue)
                        {
                            @u.LastLoginUtc.Value.ToLocalTime().ToString("g")
                        }
                        else
                        {
                            <span class="text-muted">never</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-controller="Users" asp-action="Details" asp-route-id="@u.Id">Details</a>

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <a class="btn btn-sm btn-secondary" asp-controller="Users" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                            <a class="btn btn-sm btn-danger" asp-controller="Users" asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                        }
                    </td>
                </tr>
                row++;
            }
        }
    </tbody>
</table>