

@model FRAProject.ViewModels.WingViewModel

@{
    ViewData["Title"] = "Create Wing";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Create New Wing</h4>
        </div>

        <div class="card-body">

            @* VALIDATION SUMMARY (SHOW DUPLICATE ERRORS) *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Create" method="post">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="WingLong" class="form-label"></label>
                        <input asp-for="WingLong" class="form-control" />
                        <span asp-validation-for="WingLong" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">

                    <div class="col-md-6">
                        <label for="DepartmentId" class="form-label">Department</label>
                        <select asp-for="DepartmentId"
                                asp-items="@(ViewData["Departments"] as SelectList)"
                                class="form-select">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="AcMainGroupId" class="form-label">Base (AcMainGroup)</label>
                        <select asp-for="AcMainGroupId"
                                asp-items="@(ViewData["AcMainGroups"] as SelectList)"
                                class="form-select">
                            <option value="">-- Select Base --</option>
                        </select>
                        <span asp-validation-for="AcMainGroupId" class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Active" class="form-check-input" />
                    <label asp-for="Active" class="form-check-label"></label>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Create
                    </button>

                    <a asp-action="Index" class="btn btn-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}


